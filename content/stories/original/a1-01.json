{
  "id": "story.a1.01",
  "title": "Carlos conoce a Meg",
  "level": "A1",
  "characters": ["Carlos", "Meg"],
  "lines": [
    { "kind": "narration", "es": "Carlos vive en Hanói.", "en": "Carlos lives in Hanoi." },
    { "kind": "narration", "es": "Hoy hay un encuentro de español en un restaurante mexicano.", "en": "Today there is a Spanish meetup in a Mexican restaurant." },
    { "kind": "narration", "es": "Carlos entra.", "en": "Carlos comes in." },
    { "kind": "narration", "es": "Una chica sonríe.", "en": "A girl smiles." },
    { "kind": "dialogue", "speaker": "Meg", "es": "Hola.", "en": "Hello." },
    { "kind": "dialogue", "speaker": "Carlos", "es": "Hola.", "en": "Hello." },
    { "kind": "dialogue", "speaker": "Meg", "es": "Me llamo Meg. ¿Cómo te llamas?", "en": "My name is Meg. What's your name?" },
    { "kind": "dialogue", "speaker": "Carlos", "es": "Me llamo Carlos.", "en": "My name is Carlos." },
    { "kind": "dialogue", "speaker": "Meg", "es": "Mucho gusto.", "en": "Nice to meet you." },
    { "kind": "dialogue", "speaker": "Carlos", "es": "Mucho gusto.", "en": "Nice to meet you." },
    { "kind": "dialogue", "speaker": "Meg", "es": "¿De dónde eres?", "en": "Where are you from?" },
    { "kind": "dialogue", "speaker": "Carlos", "es": "Soy de Hungría. ¿Y tú?", "en": "I'm from Hungary. And you?" },
    { "kind": "dialogue", "speaker": "Meg", "es": "Soy de Sudáfrica.", "en": "I'm from South Africa." },
    { "kind": "dialogue", "speaker": "Carlos", "es": "¡Qué bien!", "en": "How nice!" },
    { "kind": "narration", "es": "Carlos y Meg hablan un poco.", "en": "Carlos and Meg talk a little." },
    { "kind": "narration", "es": "Los dos estudian español.", "en": "They both study Spanish." },
    { "kind": "narration", "es": "Es la primera vez que se conocen.", "en": "It is the first time they meet." },
    { "kind": "narration", "es": "Al final de la tarde, Carlos dice:", "en": "At the end of the afternoon, Carlos says:" },
    { "kind": "dialogue", "speaker": "Carlos", "es": "Adiós.", "en": "Goodbye." },
    { "kind": "dialogue", "speaker": "Meg", "es": "Hasta luego.", "en": "See you later." },
    { "kind": "narration", "es": "Carlos sonríe.", "en": "Carlos smiles." },
    { "kind": "narration", "es": "Es un buen comienzo.", "en": "It is a good beginning." }
  ]
}
