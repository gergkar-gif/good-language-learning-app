  "paragraphs": [
    {
      "type": "narration",
      "text": "1301. január 14-én meghalt III. András király, és ezzel végérvényesen kihalt az Árpád-ház dicső férfiága."
    },
    {
      "type": "narration",
      "text": "Nem maradt közvetlen törvényes trónörökös a dinasztiából, ami miatt azonnal súlyos örökösödési válság robbant ki."
    },
    {
      "type": "narration",
      "text": "A királyi dinasztia kihalása után a leggazdagabb főurak könyörtelen hatalmi harcot kezdtek a korona megszerzéséért."
    },
    {
      "type": "narration",
      "text": "Az ország éveken át küzdött a belső békéért, míg végül új, európai uralkodóházak léptek a trónra."
    },
    {
      "type": "narration",
      "text": "Bár az Árpád-ház fiúága kihalt, szellemi örökségük ezer éven át a magyar nemzeti önazonosság legfőbb tartópillére maradt."
    }
  ],
