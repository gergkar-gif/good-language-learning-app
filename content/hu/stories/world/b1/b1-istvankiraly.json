  ],
  "vocabularyTopics": [
    "Géza fejedelem és a kereszténység felé fordulás",
    "István koronázása",
    "Keresztény királyság építése",
    "Szent István öröksége",
    "A Szent Korona"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "A tizedik század végén a magyar törzsek feje Géza fejedelem volt. Ő felismerte, hogy a pogány világ ideje lejárt."
    },
    {
      "type": "narration",
      "text": "A megmaradás érdekében az ország kereszténységre való vezetése mellett döntött. Elhatározta, hogy a nép áttér az új hitre."
    },
    {
      "type": "narration",
      "text": "Nyugati hittérítő papokat hívott be, hogy terjesszék a keresztény vallást. Az egyház gyorsan építeni kezdte az első templomokat."
    },
    {
      "type": "narration",
      "text": "Géza megkeresztelkedett, és fiát, Istvánt is megkereszteltette. Erős dinasztikus szövetségeket kötött a szomszédos keresztény államokkal."
    },
    {
      "type": "narration",
      "text": "Géza fejedelem békét teremtett a határokon, és előkészítette fiának az utat a királyi trón felé."
    },
    {
      "type": "narration",
      "text": "Esztergom, az 1000. év karácsonya. Az egész keresztény Európa lélegzetvisszafojtva figyelt."
    },
    {
      "type": "narration",
      "text": "A fiatal István apjától, Gézától örökölte a fejedelmi hatalmat, de most királyként akart uralkodni."
    },
    {
      "type": "narration",
      "text": "II. Szilveszter pápa áldását adta, és díszes királyi koronát küldött Rómából az új államnak."
    },
    {
      "type": "narration",
      "text": "A főpapok szent olajjal kenték fel az uralkodót. Az ünnepélyes koronázás pillanatában István elfoglalta a magyar trónt."
    },
    {
      "type": "narration",
      "text": "István tudta, hogy a hatalom óriási felelősség. Erős és független keresztény országot akart hagyni minden későbbi utód számára."
    },
    {
      "type": "narration",
      "text": "A korona megszerzése után István király azonnal hozzálátott az ország megszervezéséhez. Hatalmas munka várt rá."
    },
    {
      "type": "narration",
      "text": "A pogány törzsfők lázadásait fegyverrel verte le, biztosítva a belső békét. Szigorú, de igazságos törvénykönyveket adott ki."
    },
    {
      "type": "narration",
      "text": "Tíz egyházmegyét alapított, élükre püspököket állított, és megkezdte a gazdag kolostorok építését. Elrendelte, hogy minden tíz falu építsen egy templomot."
    },
    {
      "type": "narration",
      "text": "Bevezette a tized fizetését az egyház és az állam fenntartására. A keresztény hit a mindennapi élet alapjává vált."
    },
    {
      "type": "narration",
      "text": "István király kemény kézzel, de tiszta szívvel vezette népét a civilizáció és az európai jövő felé."
    },
    {
      "type": "narration",
      "text": "1038-ban elhunyt az első király, de hatalmas öröksége örökre fennmaradt az utókor számára."
    },
    {
      "type": "narration",
      "text": "István király bölcs intelmeket írt fiának, Imre hercegnek a keresztény hitről és az igazságos kormányzásról."
    },
    {
      "type": "narration",
      "text": "1083-ban István királyt a katolikus egyház szentté avatta, és ő lett Magyarország fő védőszentje."
    },
    {
      "type": "narration",
      "text": "Számos szép legenda és monda született csodás tetteiről, tiszteletére pedig az ország minden évben megemlékezik."
    },
    {
      "type": "narration",
      "text": "Augusztus 20-a, Szent István napja ma Magyarország legfontosabb hivatalos nemzeti ünnepe."
    },
    {
      "type": "narration",
      "text": "A magyar történelem legszentebb kincse a Szent Korona és az ezeréves koronázási jelvények együttese."
    },
    {
      "type": "narration",
      "text": "A királyi szimbólumok közé tartozik még a díszes jogar, az arany országalma és a selyemből szőtt koronázási palást."
    },
    {
      "type": "narration",
      "text": "Ez a felbecsülhetetlen értékű ereklye a független keresztény államiság és a nemzeti folytonosság legfőbb jelképe."
    },
    {
      "type": "narration",
      "text": "Bár az első királyi dinasztia kihalt, a Szent Korona eszméje évszázadokon át összetartotta a nemzetet."
    },
    {
      "type": "narration",
      "text": "A koronát ma fegyveres katonák őrzik a Parlament Kupolacsarnokában, ahol mindenki megcsodálhatja."
    }
  ],
