{
  "id": "story.b1.istvankiraly",
  "title": "Saint Stephen & the Founding of the State (1000)",
  "level": "B1",
  "lesson": 5,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "A synthesis of Szent István's story — Géza's turn to Christianity, Koppány's defeat, István's coronation around the year 1000, the Christian kingdom he built, his legacy and canonization, and the Holy Crown that still symbolizes Hungarian statehood today.",
  "characters": [],
  "location": "Magyarország",
  "grammar": [
    "melléknévi igenév: történelmi jelzők",
    "a megkoronázott király",
    "melléknévi igenév: alapított intézmények",
    "melléknévi igenév: szentté avatott örökség",
    "összefoglalás: melléknévi igenév és 'által'"
  ],
  "vocabularyTopics": [
    "Géza fejedelem és a kereszténység felé fordulás",
    "István koronázása",
    "Keresztény királyság építése",
    "Szent István öröksége",
    "A Szent Korona"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "A tizedik század végén a magyar törzsek feje Géza fejedelem volt. Úgy látta, hogy a keresztény szomszédok között a pogány hit nem maradhat fenn tartósan."
    },
    {
      "type": "narration",
      "text": "Az ország megmaradása érdekében a kereszténység felé fordult. Azt akarta, hogy népe áttérjen az új hitre."
    },
    {
      "type": "narration",
      "text": "Nyugati hittérítő papokat hívott az országba, hogy terjesszék a keresztény vallást. Ekkor kezdték építeni az első templomokat és kolostorokat is."
    },
    {
      "type": "narration",
      "text": "Géza megkeresztelkedett, és fiát, Vajkot is megkereszteltette, aki a keresztségben az István nevet kapta. Az írott források szerint azonban a régi hitet sem hagyta el teljesen."
    },
    {
      "type": "narration",
      "text": "Fia, István a bajor herceg lányát, Gizellát vette feleségül, így a magyar fejedelmi család a nyugati uralkodókhoz kötődött. Géza 997-ben halt meg; utódjának fiát, Istvánt jelölte ki."
    },
    {
      "type": "narration",
      "text": "A hagyomány szerint Esztergomban koronázták királlyá Istvánt, 1000 karácsonyán vagy 1001 elején. A pontos dátumot a történészek vitatják."
    },
    {
      "type": "narration",
      "text": "Géza halála után István örökölte a fejedelmi hatalmat, de Koppány, Géza rokona, magának akarta a hatalmat. István fegyverrel legyőzte őt 997 körül."
    },
    {
      "type": "narration",
      "text": "A legenda szerint II. Szilveszter pápa áldását adta, és koronát küldött Rómából. A történészek szerint a mai Szent Korona későbbi eredetű."
    },
    {
      "type": "narration",
      "text": "A nyugati szokás szerint a főpapok szent olajjal kenhették fel az uralkodót. A koronázással István Magyarország első királya lett."
    },
    {
      "type": "narration",
      "text": "Az új királyság ettől kezdve a keresztény Európa része volt, és a hagyomány szerint nem tartozott a Német-római Birodalom fennhatósága alá."
    },
    {
      "type": "narration",
      "text": "Királyként István 1038-ig uralkodott, és az országot a nyugati keresztény államok mintájára szervezte meg."
    },
    {
      "type": "narration",
      "text": "A törzsfők lázadásait fegyverrel verte le; a krónikák szerint Koppányt, Gyulát és Ajtonyt is legyőzte. Szigorú törvényeket adott ki."
    },
    {
      "type": "narration",
      "text": "Tíz egyházmegyét szervezett, élükre püspököket állított; az esztergomi érsekség lett az egyház központja. Kolostorokat is alapított, és törvényben rendelte el, hogy minden tíz falu építsen egy templomot."
    },
    {
      "type": "narration",
      "text": "Bevezette a tized fizetését az egyház fenntartására. A keresztény hit azonban csak lassan terjedt el: a régi hithez sokan sokáig ragaszkodtak."
    },
    {
      "type": "narration",
      "text": "Uralkodása alatt Magyarország a keresztény európai államok közé került."
    },
    {
      "type": "narration",
      "text": "1038. augusztus 15-én elhunyt az első király, de öröksége fennmaradt az utókor számára."
    },
    {
      "type": "narration",
      "text": "A hagyomány szerint István király intelmeket írt fiának, Imre hercegnek a keresztény hitről és a kormányzásról; a történészek vitatják, hogy ki és mikor fogalmazta meg az Intelmeket. Imre herceg 1031-ben meghalt, a hagyomány szerint vadászat közben, ezért István halála után trónharcok következtek."
    },
    {
      "type": "narration",
      "text": "1083-ban Istvánt, fiát, Imrét és Gellért püspököt szentté avatták, és István Magyarország egyik védőszentje lett."
    },
    {
      "type": "narration",
      "text": "Számos szép legenda és monda született csodás tetteiről, tiszteletére pedig az ország minden évben megemlékezik."
    },
    {
      "type": "narration",
      "text": "Augusztus 20-a, Szent István napja ma az államalapítás ünnepe és Magyarország hivatalos állami ünnepe."
    },
    {
      "type": "narration",
      "text": "A Szent Korona a magyar koronázási jelvények legfontosabb darabja. A történészek szerint a mai korona részei a 11–12. században készültek."
    },
    {
      "type": "narration",
      "text": "A koronázási jelvényekhez tartozik még a jogar, az országalma és a koronázási palást is."
    },
    {
      "type": "narration",
      "text": "Sokan szent ereklyeként tisztelik, és a magyar államiság folytonosságának jelképének tekintik."
    },
    {
      "type": "narration",
      "text": "Az Árpád-ház 1301-ben kihalt, de a Szent Korona a későbbi századokban is az államhatalom jelképe maradt."
    },
    {
      "type": "narration",
      "text": "A második világháború végén a koronát nyugatra vitték, és az amerikaiak kezébe került; 1978-ban az Egyesült Államok visszaadta Magyarországnak. 2000 óta a Parlament Kupolacsarnokában őrzik, díszőrség áll mellette."
    }
  ],
