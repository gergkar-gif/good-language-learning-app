  "paragraphs": [
    {
      "type": "narration",
      "text": "A középkori Magyarországon a keresztény vallás és a királyi hatalom szorosan összefonódott egymással."
    },
    {
      "type": "narration",
      "text": "Szent István és utódai tíz egyházmegyét hoztak létre, amelyek élén a művelt esztergomi érsek és a püspökök álltak."
    },
    {
      "type": "narration",
      "text": "A királyi udvar és a nemesek bőkezűen támogatták az új kolostorok építését országszerte."
    },
    {
      "type": "narration",
      "text": "A jámbor szerzetesek könyveket másoltak, gyógyították a szegényeket és terjesztették a latin nyelvű egyházi kultúrát."
    },
    {
      "type": "narration",
      "text": "A nép tizedet fizetett a papoknak a termésből, a templom pedig a közösségi élet legfőbb központja lett."
    }
  ],
