    "commemorative-synthesis"
  ],
  "vocabularyTopics": [
    "A gazdasági megújulás",
    "Az aranyforint",
    "Visegrád 1335",
    "Diplomácia",
    "Lovagkor",
    "1351-es törvények",
    "Végvárrendszer",
    "Oszmán fenyegetés",
    "Nándorfehérvár 1456",
    "Déli harangszó"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "1301-ben kihalt az Árpád-ház férfiága, és a Magyar Királyság a káosz szélére sodródott. Ki hozhat rendet egy széthulló birodalomban?"
    },
    {
      "type": "narration",
      "text": "A gazdag tartományurak, akiket kiskirály névvel illettek, saját hadsereggel uralkodtak. Nem engedelmeskedtek a központi hatalomnak."
    },
    {
      "type": "narration",
      "text": "A fiatal Anjou Károly Róbert király azonban kitartó harcokban legyőzte őket, és megszilárdít minden királyi jogkört."
    },
    {
      "type": "narration",
      "text": "A bányászat fejlesztésével Körmöcbányán megindult a drága nemesfém kitermelése. Megkezdődött a híres magyar aranyforint pénzverés folyamata."
    },
    {
      "type": "narration",
      "text": "A királyi jövedelem ugrásszerűen nőtt, és a kincstár gyorsan megtelt arannyal. Magyarország Európa egyik leggazdagabb gazdasági hatalma lett."
    },
    {
      "type": "narration",
      "text": "1335 őszén rendkívüli diplomáciai esemény zajlott Visegrádon. Hogyan foghat össze három közép-európai királyság a közös jólétért?"
    },
    {
      "type": "narration",
      "text": "Károly Róbert meghívására létrejött a híres királytalálkozó, amelyen a cseh és lengyel uralkodó vett részt."
    },
    {
      "type": "narration",
      "text": "A szomszédos országok vezetői történelmi jelentőségű katonai és gazdasági szövetség mellett kötelezték el magukat."
    },
    {
      "type": "narration",
      "text": "Közös megegyezéssel elkerül minden bécsi vámot egy új kereskedelmi út megnyitása révén."
    },
    {
      "type": "narration",
      "text": "A felek között szilárd vámmegállapodás született, amelyben a magyar király közvetítő szerepet vállalt. Ez a sikeres egyezség ma a V4 alapja."
    },
    {
      "type": "narration",
      "text": "Károly Róbert fia, Nagy Lajos igazi eszményi lovagkirály volt Európa trónjain. De vajon hogyan kormányozta hatalmas birodalmát?"
    },
    {
      "type": "narration",
      "text": "Hosszú és dicsőséges uralkodás alatt a Magyar Királyság perszonálunióra lépett Lengyelországgal, határai három tengerig értek."
    },
    {
      "type": "narration",
      "text": "1351-ben az uralkodó új törvénykönyv kiadásával lepte meg az országot. Ez a rendelet megerősít minden korábbi alapvető nemesi szabadságjogot."
    },
    {
      "type": "narration",
      "text": "A nemesség védelmére bevezette az ősiség elvét, amely szigorúan szabályozta a földbirtok családi öröklés kérdését."
    },
    {
      "type": "narration",
      "text": "A jobbágyok számára kötelezővé tette a kilenced adó fizetését. Ezzel Nagy Lajos évszázadokra meghatározta a magyar társadalmi rendet."
    },
    {
      "type": "narration",
      "text": "A tizennegyedik század végén új, sötét viharfelhők tornyosultak a déli határon. Az oszmán hadsereg megindult Európa felé."
    },
    {
      "type": "narration",
      "text": "Luxemburgi Zsigmond magyar király, a későbbi német-római császár gyorsan felismerte a halálos veszélyt."
    },
    {
      "type": "narration",
      "text": "Tudta, hogy a birodalmat komoly hadjárat fenyeget, ezért nagyszabású katonai védelmi reformba kezdett."
    },
    {
      "type": "narration",
      "text": "A déli határvidéken kiépült az első összefüggő végvárrendszer, amelyben minden fontos végvár szilárd falakkal büszkélkedhetett."
    },
    {
      "type": "narration",
      "text": "Zsigmond megalapította a Sárkány lovagrend szervezetet is a határok védelmére. A déli védelem sikeresen állta a törökök rohamait."
    },
    {
      "type": "narration",
      "text": "1456 nyarán a rettegett II. Mehmed szultán hatalmas sereggel érkezett Nándorfehérvár alá. Vajon ki állíthatja meg a hódítókat?"
    },
    {
      "type": "narration",
      "text": "A kulcsfontosságú várat a legendás törökverő hadvezér, Hunyadi János kormányzó és hős katonái védték."
    },
    {
      "type": "narration",
      "text": "A véres ostrom során a magyar vitézek hihetetlen bátorsággal és önfeláldozással visszaverték a szultán rohamait."
    },
    {
      "type": "narration",
      "text": "A fényes győzelem hetven évre megállította az oszmán előrenyomulást. A pápa elrendelte a déli harangszó szokását a hősiesség tiszteletére."
    },
    {
      "type": "narration",
      "text": "Bár Hunyadi a csata után pestis járványban elhunyt, halhatatlan neve és dicső tette örökre megmaradt a nemzeti emlékezet lapjain."
    }
  ],
