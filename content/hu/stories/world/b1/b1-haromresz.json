{
  "id": "story.b1.haromresz",
  "title": "Three Parts of Hungary",
  "level": "B1",
  "order": 10,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The dramatic 150-year era of the tripartite partition of Hungary (1541–1699): Royal Hungary under Habsburg rule with Pozsony as capital, the Ottoman Hódoltság centered in Buda, the autonomous Principality of Transylvania championing religious freedom, heroic border fortress defense, cattle trade, and the eventual liberation of Buda in 1686.",
  "characters": [],
  "location": "Pozsony, Buda, Gyulafehérvár, Eger, Bécs",
  "grammar": [
    "administrative-framing",
    "ottoman-terminology",
    "concessive-clauses",
    "historical-routines",
    "temporal-durations"
  ],
  "vocabularyTopics": [
    "Királyi Magyarország",
    "Pozsony főváros",
    "Habsburg-kormányzat",
    "Buda elfoglalása 1541",
    "Török Hódoltság",
    "Vilajetek és pasák",
    "Erdélyi Fejedelemség",
    "1568 Tordai ediktum",
    "Vallásszabadság",
    "Végvári élet",
    "Mezővárosok",
    "Szürkemarha kereskedelem",
    "150 éves török kor",
    "Buda visszafoglalása 1686",
    "Nemzeti megmaradás"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "1541-ben Buda oszmán kézre került, és az ország területe három részre szakadt. Mi maradt meg a nyugati végeken?"
    },
    {
      "type": "narration",
      "text": "A nyugati és északi vármegyék alkották a területet, amely Királyi Magyarország néven a Habsburg Birodalom része lett."
    },
    {
      "type": "narration",
      "text": "A Habsburg-kormányzat új központja Pozsony városa lett, ahol a királyi kancellária és az országgyűlés működött."
    },
    {
      "type": "narration",
      "text": "A nemesi rendeket a nádor képviselte, akit a rendszeres rendi gyűlés ülésein választottak meg a törvények betartására."
    },
    {
      "type": "narration",
      "text": "A déli határokon új végvárvonal épült ki, ahol a határvédelem mindennapos és kemény harcot jelentett a katonáknak."
    },
    {
      "type": "narration",
      "text": "Az ország középső területe másfél évszázadra az Oszmán Birodalom közvetlen tartományává vált. Milyen volt az élet itt?"
    },
    {
      "type": "narration",
      "text": "A Török Hódoltság közigazgatási alapegysége a vilajet lett, amelynek élén a teljhatalmú budai pasa állt."
    },
    {
      "type": "narration",
      "text": "Az adók pontos beszedését a szigorú defterdár felügyelte, miközben a lakosságot kettős adóztatás sújtotta."
    },
    {
      "type": "narration",
      "text": "A városok képe átalakult: megjelent a karcsú minaret, a félholdas kupolájú dzsámi és a gőzölgő törökfürdő épülete."
    },
    {
      "type": "narration",
      "text": "A magyar lakosság megtartotta hitét és nyelvét, miközben a keleti szokások is beszivárogtak a mindennapi életbe."
    },
    {
      "type": "narration",
      "text": "Miközben a középső részeken a szultán parancsolt, a keleti hegyek között különleges magyar állam született."
    },
    {
      "type": "narration",
      "text": "Létrejött az önálló Erdélyi Fejedelemség, amelynek ragyogó fejedelmi székhelye a festői Gyulafehérvár városa lett."
    },
    {
      "type": "narration",
      "text": "A választott magyar fejedelem ügyes diplomáciával és rendszeres adófizetés fejében megőrizte a belső függetlenséget."
    },
    {
      "type": "narration",
      "text": "Itt virágzott a reformáció és az anyanyelvi kultúra, és a világon elsőként törvénybe iktatták a vallásszabadság jogát."
    },
    {
      "type": "narration",
      "text": "Erdély fontos közvetítő szerep feladatot látott el Kelet és Nyugat között, őrizve a magyar államiság lángját."
    },
    {
      "type": "narration",
      "text": "A hódoltság és a keresztény világ határán állandó fegyverropogás és harci kiáltások verték fel a csendet."
    },
    {
      "type": "narration",
      "text": "A bátor végvári vitéz mindennapi feladata a portya és a veszélyes bajvívás volt az ellenséggel szemben."
    },
    {
      "type": "narration",
      "text": "A végvárak mögött a mezőváros lakossága virágzó marhakereskedelem révén szállította az állatokat Nyugat-Európa felé."
    },
    {
      "type": "narration",
      "text": "A falvakban sok helyen elnéptelenedés fenyegetett, de a bátor paraszti ellenállás gyakran megfékezte a portyázókat."
    },
    {
      "type": "narration",
      "text": "A háborús viszonyok ellenére a két világ között lassanként kialakult egy sajátos kulturális és gazdasági együttélés."
    },
    {
      "type": "narration",
      "text": "Másfél évszázadon át a magyar nemzet tragikus politikai megosztottság állapotában volt kénytelen élni."
    },
    {
      "type": "narration",
      "text": "A szörnyű háborús rombolás ellenére a nemzeti egység gondolata és a kulturális folytonosság soha nem szakadt meg."
    },
    {
      "type": "narration",
      "text": "A magyar nyelv, az irodalom és a protestáns iskolák a nemzeti túlélés legfőbb bástyáivá váltak a viharban."
    },
    {
      "type": "narration",
      "text": "A lakosság szíve mélyén mindig élt a remény: eljön a budai vár és a területek dicső visszafoglalás pillanata."
    },
    {
      "type": "narration",
      "text": "Amikor a törökök végleg kivonultak, megkezdődhetett a felperzselt ország hatalmas újjáépítés munkája az új korszakban."
    }
  ],
