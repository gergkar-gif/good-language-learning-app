{
  "id": "story.b1.haromresz",
  "title": "Three Parts of Hungary",
  "level": "B1",
  "order": 10,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The dramatic 150-year era of the tripartite partition of Hungary (1541–1699): Royal Hungary under Habsburg rule with Pozsony as capital, the Ottoman Hódoltság centered in Buda, the autonomous Principality of Transylvania championing religious freedom, heroic border fortress defense, cattle trade, and the eventual liberation of Buda in 1686.",
  "characters": [],
  "location": "Pozsony, Buda, Gyulafehérvár, Eger, Bécs",
  "grammar": [
    "administrative-framing",
    "ottoman-terminology",
    "concessive-clauses",
    "historical-routines",
    "temporal-durations"
  ],
  "vocabularyTopics": [
    "Királyi Magyarország",
    "Pozsony főváros",
    "Habsburg-kormányzat",
    "Buda elfoglalása 1541",
    "Török Hódoltság",
    "Vilajetek és pasák",
    "Erdélyi Fejedelemség",
    "1568 Tordai ediktum",
    "Vallásszabadság",
    "Végvári élet",
    "Mezővárosok",
    "Szürkemarha kereskedelem",
    "150 éves török kor",
    "Buda visszafoglalása 1686",
    "Nemzeti megmaradás"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "A mohácsi csata után, 1526-ban két királyt is választottak Magyarországon: Szapolyai Jánost és a Habsburg-házi I. Ferdinándot."
    },
    {
      "type": "narration",
      "text": "Az ország északi és nyugati területeiből alakult ki a Királyi Magyarország, amelynek királyai a Habsburg-ház tagjai voltak."
    },
    {
      "type": "narration",
      "text": "Pozsony már 1536-tól az országgyűlések színhelye volt; Buda 1541-es eleste után ez lett a Királyi Magyarország fővárosa, 1563-tól 1830-ig pedig a koronázások városa."
    },
    {
      "type": "narration",
      "text": "Pozsonyban működött a magyar kamara, a Szent Márton-dómban pedig a magyar királyokat koronázták meg. Az országgyűlések élén a király helyettese, a nádor állt."
    },
    {
      "type": "narration",
      "text": "A magyar rendek a pozsonyi országgyűléseken megszavazták az adót, amelyből a végvárakat tartották fenn, és vitatkoztak a király hatalmáról."
    },
    {
      "type": "narration",
      "text": "1541 augusztusában Szulejmán szultán hatalmas sereggel érkezett Buda alá, és augusztus 29-én, pontosan tizenöt évvel a mohácsi csata után a török csapatok bevonultak a várba."
    },
    {
      "type": "narration",
      "text": "A korabeli beszámolók szerint a török katonák csellel, harc nélkül jutottak be, és elfoglalták az erődöt."
    },
    {
      "type": "narration",
      "text": "Ezzel kezdődött a Török Hódoltság, amely az ország középső részén mintegy 150 évig tartott. Buda vilajetközponttá vált, a budai pasa irányította a tartományt, a pénzügyeket pedig a defterdár vezette."
    },
    {
      "type": "narration",
      "text": "Több keresztény templomot dzsámivá alakítottak át. A lakosság gyakran a töröknek és a magyar földesuraknak is adózott; ezt nevezik kettős adóztatásnak."
    },
    {
      "type": "narration",
      "text": "A török korból máig láthatók emlékek Magyarországon, például a törökfürdők, a minaretek és Gül Baba türbéje Budán."
    },
    {
      "type": "narration",
      "text": "A Magyar Királyság keleti részéből Szapolyai János fia, János Zsigmond idején, 1570-ben alakult meg az Erdélyi Fejedelemség."
    },
    {
      "type": "narration",
      "text": "Bár Erdély a török szultán hűbérese volt és évente adót fizetett Isztambulnak, belső ügyeiben önálló maradt."
    },
    {
      "type": "narration",
      "text": "Gyulafehérvár lett a fejedelmi székhely. A reformáció gyorsan elterjedt Erdélyben, és magyar nyelvű iskolák és nyomdák is működtek."
    },
    {
      "type": "narration",
      "text": "1568-ban a tordai országgyűlés kimondta, hogy mindenki szabadon követheti a vallását. A katolikus, az evangélikus, a református és az unitárius vallás később egyaránt bevett vallás lett. Ezt a törvényt gyakran a vallási türelem egyik első európai törvényeként említik."
    },
    {
      "type": "narration",
      "text": "A 16–17. században Erdély a magyar nyelvű könyvnyomtatás egyik fontos központja volt, a fejedelmek pedig két birodalom között egyensúlyoztak."
    },
    {
      "type": "narration",
      "text": "A Királyi Magyarország és a Hódoltság határán több száz kilométer hosszan kiépült a végvárvonal."
    },
    {
      "type": "narration",
      "text": "Eger, Győr, Kanizsa és Szigetvár környékén a végvári vitézek mindennapos harcokban és portyákban védték a határvidéket."
    },
    {
      "type": "narration",
      "text": "A két sereg bajnokai között szokás volt bajvívásban megmérkőzni a várak falai előtt."
    },
    {
      "type": "narration",
      "text": "Közben az alföldi mezővárosok — például Kecskemét, Nagykőrös és Debrecen — megerősödtek. A hódoltsági mezővárosok közül sok közvetlenül a szultánnak adózott, ezért viszonylag nagy önállóságot kapott."
    },
    {
      "type": "narration",
      "text": "A tőzsérek évente több tízezer magyar szürkemarhát hajtottak lábon a bécsi, nürnbergi és velencei piacokra. A kereskedelemből származó jövedelem segített a lakosságnak túlélni a nehéz évtizedeket, és több városban fenntartani a református iskolákat."
    },
    {
      "type": "narration",
      "text": "A 16. század közepétől a 17. század végéig Magyarország három részre szakadt: a Királyi Magyarországra, a Hódoltságra és az Erdélyi Fejedelemségre. Ez a megosztottság mintegy másfél évszázadig tartott."
    },
    {
      "type": "narration",
      "text": "A hosszú háborúk miatt a déli és középső országrészben sok falu elnéptelenedett, és a szántóföldek egy része pusztává vált."
    },
    {
      "type": "narration",
      "text": "A három országrészben ugyanazt a nyelvet beszélték, és a jogi hagyomány is közös maradt."
    },
    {
      "type": "narration",
      "text": "1686-ban a Habsburg-vezetésű szövetséges seregek hosszú ostrom után visszafoglalták Budát a törököktől."
    },
    {
      "type": "narration",
      "text": "Az 1699-es karlócai békében a törökök lemondtak Magyarország nagy részéről a Temesköz kivételével. Ezután kezdődött meg az elnéptelenedett ország újjáépítése."
    }
  ],
