  ],
  "vocabularyTopics": [
    "Miért indultak nyugatra a magyar törzsek",
    "Átkelés a Kárpátokon",
    "Árpád és a hét törzs",
    "A medence birtokba vétele",
    "A honfoglalás a nemzeti emlékezetben"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "A 9. század végén a délorosz sztyeppe végtelen vidéke forrongott. A magyarok akkori hazája, Etelköz veszélybe került."
    },
    {
      "type": "narration",
      "text": "A keleti sztyeppéken megindult a besenyő és a kazár törzsek terjeszkedése. A katonai nyomás hónapról hónapra növekedett."
    },
    {
      "type": "narration",
      "text": "A magyar törzsfők felismerték a fenyegetést. A nehéz helyzet arra kényszerítette a népet, hogy új, biztonságos lakóhelyet keressen."
    },
    {
      "type": "narration",
      "text": "A vezérek bölcs szövetséget kötöttek egymással. Nem akartak szétszéledni, hanem egységes akarattal döntöttek a nyugati vándorlás mellett."
    },
    {
      "type": "narration",
      "text": "Ez a stratégiai döntés mentette meg a nemzetet. A törzsek elindultak nyugat felé, a hatalmas hegyek irányába."
    },
    {
      "type": "narration",
      "text": "895 tavaszán a magyar törzsek elhagyták korábbi szállásterületüket, Etelközt, és elindultak a hegyek felé."
    },
    {
      "type": "narration",
      "text": "A cél a Kárpátok meredek vonulata volt. A törzsek a hágók felé vették az irányt családjaikkal és állataikkal."
    },
    {
      "type": "narration",
      "text": "A fő sereg a festői Vereckei-hágó szikláin keresztül kelt át. Az átkelés fegyelmezetten és gyorsan zajlott."
    },
    {
      "type": "narration",
      "text": "Minden magyar harcos hűséges fegyvere a híres íj és a tegezben lapuló hegyes nyíl volt."
    },
    {
      "type": "narration",
      "text": "Amikor átkeltek a magas hegyeken, a bátor nép előtt kitárult az új haza, a Kárpát-medence tágas síksága."
    },
    {
      "type": "narration",
      "text": "A honfoglaló magyar nép hét független törzsből állt, amelyek mind saját nemzetségi hagyományokkal rendelkeztek."
    },
    {
      "type": "narration",
      "text": "Hogy megvédjék magukat a veszélyektől, a törzsek úgy döntöttek, egyetlen erős szövetségben egyesülnek."
    },
    {
      "type": "narration",
      "text": "A hét vezér még a vándorlás idején ünnepélyes vérszerződést kötött, és közös esküt tett a vérrel teli serleg felett."
    },
    {
      "type": "narration",
      "text": "Megválasztották Árpádot az egész nép legfőbb fejedelmének, akinek szava minden törzs számára kötelező volt."
    },
    {
      "type": "narration",
      "text": "Árpád fejedelem és a hét vezér bölcsessége biztosította a nemzeti egységet az új hazában."
    },
    {
      "type": "narration",
      "text": "A Kárpátokon való sikeres átkelés után a magyar törzsek fokozatosan elfoglalták az egész Kárpát-medencét."
    },
    {
      "type": "narration",
      "text": "A nép gyorsan terjeszkedik a termékeny vidéken: először a tágas Alföld zöld legelőit vették birtokba."
    },
    {
      "type": "narration",
      "text": "A magyarok hagyományos életformája a pásztorkodás és az állattenyésztés volt, amihez a síkság tökéletes feltételeket nyújtott."
    },
    {
      "type": "narration",
      "text": "A törzsek alig találkoztak fegyveres ellenállással a helyi lakosság részéről a Dunántúlon és északon."
    },
    {
      "type": "narration",
      "text": "A helyi szláv és avar népességgel békésen keveredik a magyarság, adót szednek, és közösen kezdték el művelni a földeket."
    },
    {
      "type": "narration",
      "text": "A honfoglalás ezeréves évfordulóján, 1896-ban Magyarország fényes Millenniumi ünnepségeket tartott a nemzet tiszteletére."
    },
    {
      "type": "narration",
      "text": "Ekkor épült fel a Hősök tere és a hatalmas Millenniumi emlékmű Budapest szívében, amely Árpádot és a hét vezért ábrázolja."
    },
    {
      "type": "narration",
      "text": "A magyar mondák máig őrzik a szent turulmadár és a csodaszarvas legendás alakját."
    },
    {
      "type": "narration",
      "text": "Ez a gazdag történelmi örökség és a sok évszázados hagyomány képezi a mai magyar nemzeti identitás legfontosabb alapját."
    },
    {
      "type": "narration",
      "text": "Egy állampolgársági interjún Árpád emléke büszkeségre ad okot minden leendő magyar polgárnak."
    }
  ],
