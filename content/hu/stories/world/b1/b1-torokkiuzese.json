    "Felszabadító hadjárat",
    "Zentai csata",
    "Karlócai béke 1699",
    "Pusztulás és elnéptelenedés",
    "Porció és forspont",
    "Hadseregtartás",
    "Újszerzeményi Bizottság",
    "Fegyverváltság",
    "1687 pozsonyi országgyűlés",
    "Kuruc mozgalom",
    "II. Rákóczi Ferenc",
    "Szabadságharc 1703"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "1683-ban a török hadsereg kudarcot vallott Bécs falainál. Ezzel megkezdődött a végső leszámolás az Oszmán Birodalommal."
    },
    {
      "type": "narration",
      "text": "XI. Ince pápa kezdeményezésére megalakult az európai Szent Liga szövetség Magyarország felszabadítására."
    },
    {
      "type": "narration",
      "text": "1686 nyarán Lotaringiai Károly herceg vezetésével megindult a várva várt Buda visszafoglalása véres küzdelme."
    },
    {
      "type": "narration",
      "text": "A heteken át tartó ostrom alatt a fülsiketítő ágyútűz romba döntötte a budai vár vastag falait."
    },
    {
      "type": "narration",
      "text": "Petneházy Dávid magyar hajdúi törtek be elsőként a résen, miközben az utolsó budai védő, Abdurrahman pasa hősi halált halt. Megvalósult a dicső felszabadulás."
    },
    {
      "type": "narration",
      "text": "Buda sikeres visszafoglalása után a szövetséges csapatok nem álltak meg. Hatalmas felszabadító hadjárat söpört végig a vidéken."
    },
    {
      "type": "narration",
      "text": "1687-ben a nagyharsányi csata, amelyet második mohácsi csatának is neveznek, megtörte az oszmán fősereget."
    },
    {
      "type": "narration",
      "text": "Tíz évvel később a zentai csata fényes diadalában a lángelméjű Savoyai Jenő herceg végleg tönkrezúzta a szultán seregét."
    },
    {
      "type": "narration",
      "text": "1699-ben megkötötték a történelmi karlócai béke egyezményt, amellyel hivatalosan bekövetkezett a török hódoltság vége."
    },
    {
      "type": "narration",
      "text": "Az új déli határvonal kijelölésével a Temesköz kivételével az egész ország a bécsi udvar fennhatóság alá került."
    },
    {
      "type": "narration",
      "text": "A török kiűzése hatalmas öröm volt, de a szabadságnak rettenetes ára volt. Milyen állapotban hevert az ország?"
    },
    {
      "type": "narration",
      "text": "Másfél évszázadnyi háborúskodás után elképesztő pusztulás, leégett falvak és kísérteties romváros fogadta a hazatérőket."
    },
    {
      "type": "narration",
      "text": "Súlyos elnéptelenedés sújtotta az Alföldet, miközben az éhínség és a halálos járvány tizedelte a lakosságot."
    },
    {
      "type": "narration",
      "text": "A lakosságra nehezedett az idegen csapatok hadseregtartás kötelezettsége: a kötelező élelemadó, a porció és a szállítás, a forspont."
    },
    {
      "type": "narration",
      "text": "Ez a kíméletlen anyagi teher gyakran még a korábbi török adóknál is elviselhetetlenebbnek bizonyult a szegény parasztoknak."
    },
    {
      "type": "narration",
      "text": "A törökök távoztak, de a magyarok nem kapták vissza a békét. Új veszély fenyegetett: az abszolutista Habsburg-uralom."
    },
    {
      "type": "narration",
      "text": "Bécs úgy kezelte Magyarországot, mint fegyverrel meghódított új területet, és az országot katonai megszállás alá helyezte."
    },
    {
      "type": "narration",
      "text": "A felállított Újszerzeményi Bizottság csak magas fegyverváltság kifizetése ellenében adta vissza a régi családi birtokokat."
    },
    {
      "type": "narration",
      "text": "A nemesi jogok sérelme és a hatalmas adók miatt országszerte robbanásszerű elégedetlenség söpört végig a vármegyékben."
    },
    {
      "type": "narration",
      "text": "A király törölte az Aranybulla híres ellenállási jog cikkelyét, és a magyar országgyűlés elfogadta az örökös királyság elvét."
    },
    {
      "type": "narration",
      "text": "Az elkeseredett nép nem tűrte sokáig az elnyomást. A hegyekben gyülekezni kezdtek a bujdosó katonák."
    },
    {
      "type": "narration",
      "text": "Először Thököly Imre vezetésével indult meg a kuruc felkelés a császári csapatok ellen a Felvidéken."
    },
    {
      "type": "narration",
      "text": "Hamarosan a gazdag főnemes, II. Rákóczi Ferenc állt az ellenállás élére: Cum Deo pro Patria et Libertate!"
    },
    {
      "type": "narration",
      "text": "Kitört a dicsőséges Rákóczi-szabadságharc, amely széles nemzeti összefogás erejével egyesítette a jobbágyokat és a nemeseket."
    },
    {
      "type": "narration",
      "text": "Ez a nemzeti függetlenség küzdelem döntő történelmi fordulat lett: bebizonyította, hogy a magyar szabadságvágyat nem lehet eltiporni."
    }
  ],
