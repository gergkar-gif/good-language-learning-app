{
  "id": "story.b1.erdelyaranykora",
  "title": "Transylvania's Golden Age",
  "level": "B1",
  "order": 11,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The glorious golden age of the Principality of Transylvania: its establishment after Buda's fall in 1541, the revolutionary 1568 Diet of Torda proclaiming universal religious freedom, Prince Gábor Bethlen's mercantilist economic boom and academic patronage, participation in the Thirty Years' War, and its enduring role as the cultural sanctuary of the Hungarian language.",
  "characters": [],
  "location": "Gyulafehérvár, Torda, Kolozsvár, Kassa, Bécs",
  "grammar": [
    "essive-formal-kent",
    "statutory-decrees",
    "economic-boom",
    "diplomatic-intentions",
    "metaphorical-stronghold"
  ],
  "vocabularyTopics": [
    "Erdélyi Fejedelemség",
    "Belső önállóság",
    "Gyulafehérvári székhely",
    "Tordai ediktum 1568",
    "Vallásszabadság",
    "Bevett vallások",
    "Bethlen Gábor",
    "Erdély aranykora",
    "Gazdasági reformok",
    "Akadémia",
    "Harmincéves háború",
    "Nikolsburgi béke 1621",
    "Európai diplomácia",
    "Magyar műveltség",
    "Vizsolyi biblia",
    "Nemzeti megmaradás"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "Hogyan maradhatott fenn egy önálló magyar állam két világbirodalom, a Habsburgok és az Oszmánok szorításában?"
    },
    {
      "type": "narration",
      "text": "A keleti országrészben megszületett az Erdélyi Fejedelemség, amely ügyes politikával védte a magyar függetlenséget."
    },
    {
      "type": "narration",
      "text": "Bár a szultán volt a névleges hűbérúr, a tartomány teljes belső önállóság élvezett a mindennapi életben."
    },
    {
      "type": "narration",
      "text": "A fejedelmi székhely, Gyulafehérvár falai között ülésezett a rendi országgyűlés, amely megerősítette a három nemzet kiváltság jogait."
    },
    {
      "type": "narration",
      "text": "Az önálló külpolitika lehetővé tette, hogy a pusztító háborúk idején Erdélyben meginduljon a békés építkezés korszaka."
    },
    {
      "type": "narration",
      "text": "1568-ban egy erdélyi kisváros, Torda olyan döntést hozott, amely kétszáz évvel megelőzte egész Európát. Mi történt ott?"
    },
    {
      "type": "narration",
      "text": "A tordai országgyűlésen megszületett a híres tordai ediktum, amely a világon elsőként hirdette ki a hit szabadságát."
    },
    {
      "type": "narration",
      "text": "A törvény kimondta: a hit Isten ajándéka, ezért senkit sem szabad üldözni vagy bántani vallási meggyőződése miatt."
    },
    {
      "type": "narration",
      "text": "Négy bevett vallás kapott egyenlő védelmet: a katolikus, a lutheránus evangélikus, a református és az unitárius egyház."
    },
    {
      "type": "narration",
      "text": "Ez a felekezeti béke és a tiszteletre méltó vallásszabadság tette Erdélyt a tolerancia és a béke szigetévé."
    },
    {
      "type": "narration",
      "text": "1613-ban kiváló államférfi lépett a trónra: Bethlen Gábor fejedelem, aki alatt beköszöntött Erdély aranykora."
    },
    {
      "type": "narration",
      "text": "A fejedelem a korszerű merkantilizmus elveit követte: az állami bevételeket a kereskedelem és ipar fejlesztésére fordította."
    },
    {
      "type": "narration",
      "text": "Felfuttatta a bányászat ágát, és szigorúan ellenőrizte a stratégiai fontosságú nemesfém-kivitel forgalmát."
    },
    {
      "type": "narration",
      "text": "A gazdasági fellendülés révén hatalmas összegeket költött kultúrára: Gyulafehérváron fejedelmi kollégium nyitotta meg kapuit."
    },
    {
      "type": "narration",
      "text": "Bőkezű mecénás hírében állt, külföldi professzorokat hívott meg, és tehetséges magyar diákokat küldött európai egyetemekre."
    },
    {
      "type": "narration",
      "text": "Amikor Európában kitört a pusztító harmincéves háború, az erdélyi fejedelem nem maradhatott tétlen néző."
    },
    {
      "type": "narration",
      "text": "Bethlen Gábor mint megbízható szövetséges csatlakozott a protestáns liga táborához a császári elnyomás ellen."
    },
    {
      "type": "narration",
      "text": "Gyors hadjárat vezetésével felszabadította Felső-Magyarországot, és csapatai még Bécs falait is megközelítették."
    },
    {
      "type": "narration",
      "text": "Sikerei nyomán kedvező békeszerződés született, amely garantálta a magyar rendi és vallási jogok érvényesülését."
    },
    {
      "type": "narration",
      "text": "A fejedelmi diplomácia és a mesteri egyensúlyozás révén Erdély nemzetközi elismertség szintjére emelkedett Európában."
    },
    {
      "type": "narration",
      "text": "Milyen kincseket hagyott ránk az erdélyi aranykor, amelyek ma is formálják a magyar identitást?"
    },
    {
      "type": "narration",
      "text": "A gazdag református műveltség részeként megszületett Károli Gáspár bibliafordítás munkája, amely egységesítette a nyelvet."
    },
    {
      "type": "narration",
      "text": "Szapora nyomdászat virágzott a városokban, és megindult a magas színvonalú anyanyelvi oktatás országszerte."
    },
    {
      "type": "narration",
      "text": "A templomokban zengő közös zsoltáréneklés erősítette a lelkeket és mélyítette a közösségi nemzeti tudat érzését."
    },
    {
      "type": "narration",
      "text": "Ez a csodálatos történelmi hagyaték bizonyítja, hogy a magyar kultúra a legnehezebb időkben is erős bástya maradt."
    }
  ],
