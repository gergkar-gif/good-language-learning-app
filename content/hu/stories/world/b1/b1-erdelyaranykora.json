{
  "id": "story.b1.erdelyaranykora",
  "title": "Transylvania's Golden Age",
  "level": "B1",
  "order": 11,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The glorious golden age of the Principality of Transylvania: its establishment after Buda's fall in 1541, the revolutionary 1568 Diet of Torda proclaiming universal religious freedom, Prince Gábor Bethlen's mercantilist economic boom and academic patronage, participation in the Thirty Years' War, and its enduring role as the cultural sanctuary of the Hungarian language.",
  "characters": [],
  "location": "Gyulafehérvár, Torda, Kolozsvár, Kassa, Bécs",
  "grammar": [
    "essive-formal-kent",
    "statutory-decrees",
    "economic-boom",
    "diplomatic-intentions",
    "metaphorical-stronghold"
  ],
  "vocabularyTopics": [
    "Erdélyi Fejedelemség",
    "Belső önállóság",
    "Gyulafehérvári székhely",
    "Tordai ediktum 1568",
    "Vallásszabadság",
    "Bevett vallások",
    "Bethlen Gábor",
    "Erdély aranykora",
    "Gazdasági reformok",
    "Akadémia",
    "Harmincéves háború",
    "Nikolsburgi béke 1621",
    "Európai diplomácia",
    "Magyar műveltség",
    "Vizsolyi biblia",
    "Nemzeti megmaradás"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "Miután Buda 1541-ben török kézre került, Fráter György és Izabella királyné a keleti országrészbe vonult vissza a csecsemő János Zsigmonddal."
    },
    {
      "type": "narration",
      "text": "A keleti országrészből fokozatosan alakult ki az Erdélyi Fejedelemség (hivatalosan 1570-ben), amely a szultán hűbéreseként, de belső ügyeiben önállóan létezett."
    },
    {
      "type": "narration",
      "text": "A fejedelmi székhely Gyulafehérvár lett. Az erdélyi országgyűlésen a magyar nemesek, a székelyek és a szászok képviselői tanácskoztak."
    },
    {
      "type": "narration",
      "text": "Az Erdélyi Fejedelemség első fejedelme János Zsigmond volt, utána Báthory István lett a fejedelem."
    },
    {
      "type": "narration",
      "text": "A fejedelmek a Habsburg Monarchia és az Oszmán Birodalom között egyensúlyoztak."
    },
    {
      "type": "narration",
      "text": "A 16. században Európa több országában vallásháborúk dúltak a katolikusok és a protestánsok között."
    },
    {
      "type": "narration",
      "text": "Erdélyben ezzel szemben 1568 januárjában Tordán országgyűlés ült össze."
    },
    {
      "type": "narration",
      "text": "János Zsigmond támogatásával, Dávid Ferenc udvari prédikátor, az erdélyi unitárius egyház alapítója hatására az országgyűlés kimondta: a hit Isten ajándéka, és senkit sem szabad a hite miatt fogságba vetni."
    },
    {
      "type": "narration",
      "text": "A katolikus, az evangélikus, a református és az unitárius vallás később egyaránt bevett vallás lett. Sok történész ezt a vallási türelem egyik első európai törvényének tartja."
    },
    {
      "type": "narration",
      "text": "A türelem nem volt korlátlan: Dávid Ferencet 1579-ben fogságba vetették, és a dévai várban halt meg. A 17. században Erdélyben mégsem tört ki olyan nagy felekezeti háború, mint Nyugat-Európában."
    },
    {
      "type": "narration",
      "text": "Bethlen Gábor 1613-tól 1629-ig volt Erdély fejedelme. Uralkodását gyakran Erdély aranykorának nevezik."
    },
    {
      "type": "narration",
      "text": "Uralkodása alatt Erdély gazdasága virágzásnak indult: a fejedelem merkantilista gazdaságpolitikát folytatott."
    },
    {
      "type": "narration",
      "text": "A nemesfémek, a marha és a só kivitelét állami monopóliummá tette, és külföldi mestereket és bányászokat telepített be."
    },
    {
      "type": "narration",
      "text": "Gyulafehérváron fejedelmi palotát építtetett, és 1622-ben protestáns kollégiumot alapított, ahol külföldi professzorok is tanítottak."
    },
    {
      "type": "narration",
      "text": "Bethlen kincstára megtelt, így zsoldoshadsereget tarthatott fenn, és diákokat is támogatott külföldi egyetemeken."
    },
    {
      "type": "narration",
      "text": "1618-ban kitört a harmincéves háború. Bethlen Gábor 1619-ben a cseh rendek oldalán beavatkozott a háborúba."
    },
    {
      "type": "narration",
      "text": "A fejedelem a cseh és más protestáns szövetségesek oldalán hadjáratot indított a Habsburgok ellen, és csapatai Bécs alá is eljutottak."
    },
    {
      "type": "narration",
      "text": "1620-ban a besztercebányai országgyűlésen a rendek magyar királlyá választották Bethlent, de ő nem koronáztatta meg magát. Ennek okait a történészek különbözőképpen magyarázzák."
    },
    {
      "type": "narration",
      "text": "Az 1621-es nikolsburgi békében a császár megerősítette a magyar rendek jogait, Bethlen pedig hét felső-magyarországi vármegyét kapott élete végéig."
    },
    {
      "type": "narration",
      "text": "Bethlen a protestáns hatalmakkal, például Hollandiával és Angliával is tárgyalt, így Erdély a nemzetközi diplomáciában is szerepet kapott."
    },
    {
      "type": "narration",
      "text": "A 16–17. században Erdélyben és a Tiszántúlon sok magyar nyelvű iskola és nyomda működött."
    },
    {
      "type": "narration",
      "text": "Károli Gáspár első teljes magyar nyelvű Bibliája 1590-ben Vizsolyban jelent meg, Szenczi Molnár Albert pedig a genfi zsoltárokat fordította magyarra (1607, Herborn)."
    },
    {
      "type": "narration",
      "text": "A fejedelmek kollégiumokat és nyomdákat támogattak; Gyulafehérváron Bethlen kollégiuma működött, Debrecenben pedig a Református Kollégium."
    },
    {
      "type": "narration",
      "text": "Debrecent a 17. században a „kálvinista Rómának” is nevezték."
    },
    {
      "type": "narration",
      "text": "Ezek a könyvek és iskolák ma is a magyar kulturális örökség részei."
    }
  ],
