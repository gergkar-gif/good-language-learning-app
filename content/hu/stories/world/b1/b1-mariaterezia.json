{
  "id": "story.b1.mariaterezia",
  "title": "The 18th Century: Rebuilding",
  "level": "B1",
  "order": 14,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The comprehensive saga of 18th-century Hungary: repopulation, Maria Theresa's enlightened absolutism, Joseph II's decrees, and the dawn of national awakening.",
  "characters": [
    "Mária Terézia",
    "II. József",
    "Bessenyei György"
  ],
  "location": "Magyarország, Pozsony, Bécs",
  "paragraphs": [
    {
      "type": "narration",
      "text": "A török hódoltság és a hosszú háborúk után a Duna mentén és az Alföldön sok vidéken néptelen pusztaság maradt."
    },
    {
      "type": "narration",
      "text": "A bécsi udvar és a nagybirtokosok szerint az ország újjáéledésének az alapja a gyors újranépesítés volt."
    },
    {
      "type": "narration",
      "text": "Különleges letelepedési engedély és adómentesség ígéretével hívtak be földműveseket, főként német területekről."
    },
    {
      "type": "narration",
      "text": "A 18. században sok német ajkú sváb telepes érkezett a Dunántúlra és a Bácskába; szlovákok, románok és szerbek is letelepedtek."
    },
    {
      "type": "narration",
      "text": "Ezzel Magyarország népessége még sokszínűbb, többnemzetiségű lett."
    },
    {
      "type": "narration",
      "text": "1740-ben egy huszonhárom éves fiatal nő örökölte a Habsburg-birodalom trónját, és negyven évig, 1780-ig uralkodott."
    },
    {
      "type": "narration",
      "text": "Az 1723-ban elfogadott Pragmatica Sanctio törvény kimondta, hogy a Habsburg-ház lányai is örökölhetik a trónt, Magyarországon is."
    },
    {
      "type": "narration",
      "text": "Ám még 1740 végén a porosz király megtámadta Sziléziát, és kitört az osztrák örökösödési háború, amely 1748-ig tartott."
    },
    {
      "type": "narration",
      "text": "1741-ben a fiatal uralkodónő, Mária Terézia személyesen jelent meg a pozsonyi országgyűlésen a magyar nemesek előtt."
    },
    {
      "type": "narration",
      "text": "A hagyomány szerint a magyar urak kardot rántottak, és azt kiáltották: Életünket és vérünket! (latinul: Vitam et sanguinem!) A történészek vitatják, hogy a jelenet pontosan így zajlott-e, de az országgyűlés katonai segítséget szavazott meg a királynőnek. A nemesek a koronázáskor hűségesküt tettek neki."
    },
    {
      "type": "narration",
      "text": "Mária Terézia kormányzását a történészek gyakran a felvilágosult abszolutizmus korához sorolják. Milyen reformokat hozott?"
    },
    {
      "type": "narration",
      "text": "Az 1767-es Urbárium királyi rendelet volt, és egységesen szabályozta a jobbágyok földesúri szolgáltatásait."
    },
    {
      "type": "narration",
      "text": "Meghatározta a jobbágyok jogait, és korlátozta a földesúrnak végzett ingyen munka, a robot mértékét."
    },
    {
      "type": "narration",
      "text": "1777-ben kiadta a Ratio Educationist, amely az alapfokú iskoláktól az egyetemig egységesen szabályozta a magyarországi oktatást."
    },
    {
      "type": "narration",
      "text": "Az általános iskolakötelezettség elvét Magyarországon csak 1868-ban mondták ki."
    },
    {
      "type": "narration",
      "text": "Fia, II. József 1780-ban lépett a trónra. De miért hívták kalapos királynak?"
    },
    {
      "type": "narration",
      "text": "Nem koronáztatta meg magát, egyes források szerint azért, mert nem akart esküt tenni a magyar rendi alkotmányra. 1784-ben Bécsbe vitette a Szent Koronát. Rendeletekkel kormányzott, és nem hívta össze az országgyűlést."
    },
    {
      "type": "narration",
      "text": "1781-ben kiadta a türelmi rendeletet, amely a protestánsoknak szabadabb vallásgyakorlást engedett: templomot építhettek és hivatalt viselhettek, bár a katolikus vallás maradt az államvallás."
    },
    {
      "type": "narration",
      "text": "Ám 1784-ben nyelvrendeletet adott ki, amely a latin helyett a németet tette hivatalos nyelvvé az államigazgatásban."
    },
    {
      "type": "narration",
      "text": "A császár az egységes közigazgatást akarta, a magyar nemesség azonban elnémetesítésnek tekintette a rendeletet, és tiltakozott. 1790 elején, halála előtt kevéssel a császár a türelmi rendelet és néhány más rendelet kivételével visszavonta rendeleteit."
    },
    {
      "type": "narration",
      "text": "A magyar nyelv ügye már II. József előtt, a hetvenes években megjelent az irodalomban, a német nyelvrendelet után pedig tovább erősödött. A rendelet felháborította a magyar nemesség nagy részét."
    },
    {
      "type": "narration",
      "text": "A vármegyék tiltakoztak a rendelet ellen, és a nemesség sok tagja ragaszkodott a hagyományokhoz."
    },
    {
      "type": "narration",
      "text": "Bessenyei György, a bécsi magyar testőrség írója 1772-ben jelentette meg magyar nyelvű drámáját, és később is a magyar nyelv művelését sürgette; az irodalomtörténet gyakran az ő nevéhez köti a magyar felvilágosodás kezdetét."
    },
    {
      "type": "narration",
      "text": "A felvilágosodás hatására élénkülni kezdett az irodalmi élet: 1780-ban Pozsonyban megjelent az első magyar nyelvű újság, a Magyar Hírmondó, 1790-ben pedig megalakult az első magyar nyelvű színtársulat."
    },
    {
      "type": "narration",
      "text": "A történészek ezt a folyamatot nemzeti ébredésnek nevezik; előkészítette a 19. század első felének reformkorát."
    }
  ],
