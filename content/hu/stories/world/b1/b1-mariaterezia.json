{
  "id": "story.b1.mariaterezia",
  "title": "The 18th Century: Rebuilding",
  "level": "B1",
  "order": 14,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The comprehensive saga of 18th-century Hungary: repopulation, Maria Theresa's enlightened absolutism, Joseph II's decrees, and the dawn of national awakening.",
  "characters": [
    "Mária Terézia",
    "II. József",
    "Bessenyei György"
  ],
  "location": "Magyarország, Pozsony, Bécs",
  "paragraphs": [
    {
      "type": "narration",
      "text": "A török hódoltság után a Duna mentén és az Alföldön elképesztő pusztaság és üres földek fogadták az utazót."
    },
    {
      "type": "narration",
      "text": "A bécsi udvar és a nagybirtokosok azonnal felismerték: a virágzó újjáéledés alapja a gyors újranépesítés."
    },
    {
      "type": "narration",
      "text": "Különleges letelepedési engedély és adómentesség ígéretével hívtak be szorgalmas katolikus földműveseket Európából."
    },
    {
      "type": "narration",
      "text": "Ekkor érkezett a legtöbb német ajkú sváb telepes a Dunántúlra és a Bácskába, miközben szlovákok és románok is letelepedtek."
    },
    {
      "type": "narration",
      "text": "Ezzel Magyarország sokszínű, többnemzetiségű ország lett, ahol minden nemzetiség hozzátette saját kultúráját a közös hazához."
    },
    {
      "type": "narration",
      "text": "1740-ben egy huszonhárom éves fiatal nő örökölte a Habsburg trónt. Ki gondolta volna, hogy negyven évig fog uralkodni?"
    },
    {
      "type": "narration",
      "text": "Az 1723-ban elfogadott Pragmatica Sanctio törvény garantálta a női trónöröklés jogát a birodalomban."
    },
    {
      "type": "narration",
      "text": "Ám európai riválisai azonnal megtámadták, és kitört a véres osztrák örökösödési háború a birodalom felosztására."
    },
    {
      "type": "narration",
      "text": "A fiatal uralkodónő, Mária Terézia személyesen jelent meg a pozsonyi országgyűlés termében a magyar nemesek előtt."
    },
    {
      "type": "narration",
      "text": "A magyar urak meghatódva rántottak kardot, és elhangzott a legendás nemesi felajánlás: Életünket és vérünket! Ezzel megerősítették a szent hűségeskü kötelékét."
    },
    {
      "type": "narration",
      "text": "Mária Terézia a felvilágosult abszolutizmus bölcs szellemében kormányozta virágzó országait. Milyen reformokat hozott?"
    },
    {
      "type": "narration",
      "text": "Az 1767-es Urbárium állami rendelet a jobbágyvédelem legfőbb bástyájává vált a földesúri önkénnyel szemben."
    },
    {
      "type": "narration",
      "text": "Pontosan megszabta a jobbágyok jogait, és szigorúan korlátozta a heti ingyen végzendő robot mértékét."
    },
    {
      "type": "narration",
      "text": "1777-ben kiadta az iskolarendszert megalapozó híres Ratio Educationis rendeletet a tudás terjesztésére."
    },
    {
      "type": "narration",
      "text": "A törvény kötelezővé tette az iskolakötelezettség elvét, megteremtve az ingyenes alapfokú oktatás alapjait országszerte."
    },
    {
      "type": "narration",
      "text": "Fia, II. József császár még radikálisabb eszmékkel lépett a trónra. De miért hívta a nép kalapos királynak?"
    },
    {
      "type": "narration",
      "text": "Mivel nem akart esküt tenni a magyar alkotmányra, megtagadta a koronázást, és Bécsbe vitette a Szent Korona kincsét. A rendeleti kormányzás útjára lépett."
    },
    {
      "type": "narration",
      "text": "1781-ben kiadta a korszakalkotó türelmi rendelet szövegét, amely teljes vallásszabadságot biztosított a protestánsoknak."
    },
    {
      "type": "narration",
      "text": "Ám 1784-ben kiadta a vitatott nyelvrendelet intézkedést, amely a német hivatalos nyelv bevezetését írta elő minden hivatalban."
    },
    {
      "type": "narration",
      "text": "A magyar nemesség felháborodott az elnémetesítés miatt, és a császár végül a halálos ágyán szinte minden rendeletét visszavonta."
    },
    {
      "type": "narration",
      "text": "A német nyelvrendelet óriási megrázkódtatást okozott a nemzetben. De paradox módon ez indította el a megújulást."
    },
    {
      "type": "narration",
      "text": "A sértett nemesség körében azonnal heves nemesi ellenállás és büszke hagyománytisztelet lángolt fel a megyékben."
    },
    {
      "type": "narration",
      "text": "Bessenyei György bécsi testőríró vezetésével megszületett az anyanyelvi mozgalom a magyar nyelv megmentésére."
    },
    {
      "type": "narration",
      "text": "A felvilágosodás eszméi nyomán megindult a pezsgő irodalmi élet, megjelentek az első magyar újságok és színházak."
    },
    {
      "type": "narration",
      "text": "Ez a csodálatos nemzeti ébredés megerősítette a nemzeti öntudat érzését, és egyenesen elvezetett a dicső reformkor küszöbéhez."
    }
  ],
