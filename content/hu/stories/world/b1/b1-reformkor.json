{
  "id": "story.b1.reformkor",
  "title": "The Reform Age",
  "level": "B1",
  "order": 15,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The magnificent saga of the Hungarian Reform Era: Széchenyi's foundational vision, the Chain Bridge, Kossuth's political press, the 1844 language act, and the eve of 1848.",
  "characters": [
    "Széchenyi István",
    "Kossuth Lajos",
    "Petőfi Sándor"
  ],
  "location": "Magyarország, Pozsony, Pest",
  "paragraphs": [
    {
      "type": "narration",
      "text": "1825 őszén Pozsonyban a fiatal gróf, Széchenyi István olyan lépést tett, amely örökre megváltoztatta Magyarországot."
    },
    {
      "type": "narration",
      "text": "A gazdag birtokos nemes felállt az országgyűlésen, és birtokainak teljes egyévi jövedelem összegét ajánlotta fel."
    },
    {
      "type": "narration",
      "text": "Ebből a nemes felajánlásból született meg a Magyar Tudományos Akadémia a magyar nyelv és tudomány ápolására."
    },
    {
      "type": "narration",
      "text": "1830-ban megjelent korszakalkotó könyve, a Hitel, amely a modern polgárosodás gazdasági programját hirdette meg."
    },
    {
      "type": "narration",
      "text": "Kossuth Lajos méltán nevezte őt így: a legnagyobb magyar. Széchenyi zseniális nemzetfejlesztés munkája elindította a reformkort."
    },
    {
      "type": "narration",
      "text": "Hogyan lehet összekötni egy folyó által elválasztott két történelmi várost? Széchenyi merész álmokat szőtt."
    },
    {
      "type": "narration",
      "text": "Elindult a nagyszabású Duna-szabályozás, a Vaskapu szikláinak átrobbantásával pedig megnyílt a modern gőzhajózás útja."
    },
    {
      "type": "narration",
      "text": "Felépült az első állandó kőhíd, a csodálatos Lánchíd, amely Buda és Pest szívét kapcsolta össze."
    },
    {
      "type": "narration",
      "text": "A híd átadásakor a hídpénz fizetése mindenkire kötelező volt, ezzel megkezdődött a nemesi adómentesség megtörése."
    },
    {
      "type": "narration",
      "text": "A korszerű infrastruktúra és a gyors modernizáció révén a magyar főváros Közép-Európa virágzó központjává fejlődött."
    },
    {
      "type": "narration",
      "text": "Miközben Széchenyi hidakat és gyárakat épített, egy zseniális ügyvéd a szavak erejével ébresztette fel az országot."
    },
    {
      "type": "narration",
      "text": "Kossuth Lajos a diákok segítségével kézzel másolta az Országgyűlési Tudósítások lapjait, hogy a cenzúra kijátszása sikerüljön."
    },
    {
      "type": "narration",
      "text": "Később a Pesti Hírlap szerkesztőjeként megteremtette az első modern politikai sajtó felületét a nemzet számára."
    },
    {
      "type": "narration",
      "text": "Páratlan szónoki tehetség révén két forradalmi eszmét hirdetett: a közteherviselést és a jobbágyfelszabadítás ügyét."
    },
    {
      "type": "narration",
      "text": "Kossuth szenvedélyes hangja milliókhoz jutott el, és a reformellenzék legfőbb vezéralakjává emelte a fiatal politikust."
    },
    {
      "type": "narration",
      "text": "Évszázadokon át a latin volt az országgyűlés nyelve. De mikor szólalhatott meg a haza végre a saját anyanyelvén?"
    },
    {
      "type": "narration",
      "text": "1844-ben a rendek elfogadták a történelmi 1844-es nyelvtörvény rendelkezését, amellyel a magyar lett a hivatalos nyelv."
    },
    {
      "type": "narration",
      "text": "Ezzel lezárult a latin nyelv háttérbe szorulása a közigazgatásban, a bíróságokon és a felsőfokú oktatásban."
    },
    {
      "type": "narration",
      "text": "Kölcsey Ferenc 1823-ban megírta a nemzet imádságát, a Himnusz költeményt, Vörösmarty Mihály pedig a hazafias Szózat sorait."
    },
    {
      "type": "narration",
      "text": "Megnyitotta kapuit a pesti Nemzeti Színház is, ahol a magyar színjátszás a nemzeti önazonosság szent temploma lett."
    },
    {
      "type": "narration",
      "text": "1848 kora tavaszán forró izgalom vibrált a levegőben. Európa városaiban sorra törtek ki a felkelések."
    },
    {
      "type": "narration",
      "text": "Kossuth kezdeményezésére megalakult a Védegylet, amely hat éven át a magyar ipar támogatása mellett kötelezte el tagjait."
    },
    {
      "type": "narration",
      "text": "A pesti Pilvax kávéház füstös termeiben a forradalmi fiatal értelmiség Petőfi Sándor és Jókai Mór körül gyülekezett."
    },
    {
      "type": "narration",
      "text": "A pozsonyi reformországgyűlés termeiben a követek feszülten figyelték a megrázó európai változások híreit."
    },
    {
      "type": "narration",
      "text": "A forradalmi hangulat tetőfokára hágott: a nemzeti megújulás órája megkondult, és készen állt a március 15-i csoda."
    }
  ],
