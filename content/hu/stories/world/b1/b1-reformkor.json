{
  "id": "story.b1.reformkor",
  "title": "The Reform Age",
  "level": "B1",
  "order": 15,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The magnificent saga of the Hungarian Reform Era: Széchenyi's foundational vision, the Chain Bridge, Kossuth's political press, the 1844 language act, and the eve of 1848.",
  "characters": [
    "Széchenyi István",
    "Kossuth Lajos",
    "Petőfi Sándor"
  ],
  "location": "Magyarország, Pozsony, Pest",
  "paragraphs": [
    {
      "type": "narration",
      "text": "1825 novemberében Pozsonyban a harmincnégy éves gróf, Széchenyi István olyan lépést tett, amelyet sokan a reformkor kezdetének tekintenek."
    },
    {
      "type": "narration",
      "text": "A gazdag birtokos nemes felállt az országgyűlésen, és birtokainak egyévi jövedelmét ajánlotta fel."
    },
    {
      "type": "narration",
      "text": "Felajánlása nyomán, más főurak adományaival együtt jött létre a Magyar Tudós Társaság, a mai Magyar Tudományos Akadémia, a magyar nyelv és tudomány ápolására."
    },
    {
      "type": "narration",
      "text": "1830-ban megjelent a Hitel című könyve, amelyben a gazdaság és a hitelezés megújítását javasolta."
    },
    {
      "type": "narration",
      "text": "Kossuth Lajos nevezte el őt „a legnagyobb magyarnak”, ezért ma is így emlegetik. A történészek szerint tevékenysége nagyban hozzájárult a reformkor elindulásához."
    },
    {
      "type": "narration",
      "text": "Hogyan lehet összekötni a Duna két partján fekvő várost, Budát és Pestet? Széchenyi kezdeményezésére elindult a Lánchíd építése."
    },
    {
      "type": "narration",
      "text": "Széchenyi részt vett a Duna szabályozásában is: az 1830-as években a Vaskapu szikláinak eltávolításával javítani kezdték a hajózhatóságot, a gőzhajózás pedig egyre fontosabb lett."
    },
    {
      "type": "narration",
      "text": "Felépült az első állandó híd Buda és Pest között, a Lánchíd. William Tierney Clark angol mérnök tervezte, az építést Clark Ádám vezette; 1849-ben adták át."
    },
    {
      "type": "narration",
      "text": "Az 1836-os törvény szerint a hídpénzt a nemeseknek is fizetniük kellett; ez volt a nemesi adómentesség első jelentős megtörése."
    },
    {
      "type": "narration",
      "text": "A híd és más fejlesztések révén Pest és Buda gyorsan fejlődött, és később, 1873-ban egyesült Budapest néven."
    },
    {
      "type": "narration",
      "text": "Miközben Széchenyi a gazdaság fejlesztésén dolgozott, Kossuth Lajos, a fiatal ügyvéd az újságírással és a szónoklattal kezdett hatni az emberekre."
    },
    {
      "type": "narration",
      "text": "Az 1832-36-os országgyűlés idején Kossuth az Országgyűlési Tudósítások lapjait jogász fiatalok segítségével kézzel másoltatta, így kerülte meg a cenzúrát."
    },
    {
      "type": "narration",
      "text": "1841-ben ő lett a Pesti Hírlap szerkesztője, amely a korszak egyik legnagyobb hatású politikai lapja volt."
    },
    {
      "type": "narration",
      "text": "Híres szónok volt, és követelte a közteherviselést, vagyis hogy a nemesek is fizessenek adót, valamint a jobbágyok felszabadítását."
    },
    {
      "type": "narration",
      "text": "Írásai és beszédei sok emberhez eljutottak, és a reformellenzék egyik vezéralakjává tették."
    },
    {
      "type": "narration",
      "text": "Évszázadokon át a latin volt a közigazgatás és az országgyűlés nyelve. Mikor lett hivatalos nyelv a magyar?"
    },
    {
      "type": "narration",
      "text": "1844-ben a rendek elfogadták a nyelvtörvényt, amellyel a magyar lett a hivatalos nyelv a törvényhozásban, a közigazgatásban és az oktatásban."
    },
    {
      "type": "narration",
      "text": "A latin nyelv szerepe ezután egyre kisebb lett."
    },
    {
      "type": "narration",
      "text": "Kölcsey Ferenc 1823-ban, Csekén írta a Himnusz szövegét, Vörösmarty Mihály pedig 1836-ban a Szózatot. A Himnusz zenéjét Erkel Ferenc szerezte 1844-ben."
    },
    {
      "type": "narration",
      "text": "1837-ben megnyílt Pesten az első állandó magyar nyelvű kőszínház, a későbbi Nemzeti Színház."
    },
    {
      "type": "narration",
      "text": "1848 tavaszán Európa több városában forradalmak törtek ki: februárban Párizsban, márciusban Bécsben."
    },
    {
      "type": "narration",
      "text": "Már 1844-ben megalakult a Védegylet Kossuth kezdeményezésére; tagjai hat évre vállalták, hogy magyar termékeket vásárolnak."
    },
    {
      "type": "narration",
      "text": "A pesti Pilvax kávéházban a fiatal értelmiségiek, köztük Petőfi Sándor és Jókai Mór gyűltek össze."
    },
    {
      "type": "narration",
      "text": "A pozsonyi országgyűlésen Kossuth március 3-án beszédet mondott, és alkotmányos kormányzatot követelt."
    },
    {
      "type": "narration",
      "text": "1848. március 15-én Pesten kitört a forradalom; a márciusi ifjak tizenkét pontban foglalták össze követeléseiket."
    }
  ],
