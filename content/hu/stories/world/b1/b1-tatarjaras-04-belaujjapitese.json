  "paragraphs": [
    {
      "type": "narration",
      "text": "1242 tavaszán a mongol sereg hirtelen kivonult az országból, és IV. Béla király azonnal visszatért elpusztult hazájába."
    },
    {
      "type": "narration",
      "text": "A király nem vesztegette az időt, hanem azonnal megkezdte a romokban heverő királyság hatalmas újjáépítését."
    },
    {
      "type": "narration",
      "text": "Új idegen telepeseket hívott be a szomszédos országokból, és letelepítette őket a kihalt városokba és falvakba."
    },
    {
      "type": "narration",
      "text": "Bőséges birtokokat adományozott azoknak a nemeseknek, akik kővárat emeltek a határok védelmére."
    },
    {
      "type": "narration",
      "text": "Hősies és áldozatos munkájáért a magyarok IV. Bélát a második honalapító néven tisztelik máig."
    }
  ],
