  "paragraphs": [
    {
      "type": "narration",
      "text": "1241 telén rettenetes hír érkezett keletről. A mongol és tatár hadsereg gyorsan közeledett a magyar határok felé."
    },
    {
      "type": "narration",
      "text": "A hírhozók kétségbeesve figyelmeztették a fiatal IV. Béla királyt a hatalmas külső fenyegetésre."
    },
    {
      "type": "narration",
      "text": "A tatárok elől menekülő kun harcosok már korábban beléptek az országba, menedéket kérve a királytól."
    },
    {
      "type": "narration",
      "text": "A király véres kardot küldött szét az országban, fegyverbe szólítva a népet, mert a tatárok bármelyik pillanatban betörhetnek."
    },
    {
      "type": "narration",
      "text": "Végül a tatár sereg áttörte a hágókat, és a pusztító vihar megállíthatatlanul zúdult a védtelen Magyarországra."
    },
    {
      "type": "narration",
      "text": "1241. április 11-e éjszakáján a Sajó folyó partján állt fel a királyi hadsereg a mongol sereggel szemben."
    },
    {
      "type": "narration",
      "text": "A magyar katonák védelmi céllal egy szűk szekérvárat hoztak létre, de ez súlyos taktikai hibának bizonyult."
    },
    {
      "type": "narration",
      "text": "A fürge tatár lovasok éjjel átkeltek a hídon, és teljesen bekerítették a magyar tábort. Nyílzápor zúdult a harcosokra."
    },
    {
      "type": "narration",
      "text": "A véres ütközet katasztrofális magyar vereséggel végződött. A hadsereg óriási veszteséget szenvedett, a főurak többsége elesett."
    },
    {
      "type": "narration",
      "text": "IV. Béla király csak a legbátrabb vitézei segítségével tudott elmenekülni a csatatérről. Az ország védtelen maradt."
    },
    {
      "type": "narration",
      "text": "A muhi csata után soha nem látott pusztulás söpört végig a virágzó Magyar Királyság földjén."
    },
    {
      "type": "narration",
      "text": "Számtalan falu és gazdag város felégett a támadásban, a gyönyörű templomok és paloták romba dőltek."
    },
    {
      "type": "narration",
      "text": "A rémült lakosság a sűrű erdőkbe, a Dunakanyar hegyeibe és a védett mocsarakba menekült menedéket keresni."
    },
    {
      "type": "narration",
      "text": "Amikor a Duna vize télen teljesen befagyott, a mongol lovasok átkeltek a jégen, és a termés is teljesen megsemmisült."
    },
    {
      "type": "narration",
      "text": "A pusztítás nyomán rettenetes éhínség tizedelte a túlélőket, de a magyar nemzet élni akarása nem tört meg."
    },
    {
      "type": "narration",
      "text": "1242 tavaszán a mongol sereg hirtelen kivonult az országból, és IV. Béla király azonnal visszatért elpusztult hazájába."
    },
    {
      "type": "narration",
      "text": "A király nem vesztegette az időt, hanem azonnal megkezdte a romokban heverő királyság hatalmas újjáépítését."
    },
    {
      "type": "narration",
      "text": "Új idegen telepeseket hívott be a szomszédos országokból, és letelepítette őket a kihalt városokba és falvakba."
    },
    {
      "type": "narration",
      "text": "Bőséges birtokokat adományozott azoknak a nemeseknek, akik kővárat emeltek a határok védelmére."
    },
    {
      "type": "narration",
      "text": "Hősies és áldozatos munkájáért a magyarok IV. Bélát a második honalapító néven tisztelik máig."
    },
    {
      "type": "narration",
      "text": "A tatárjárás után a király és a nemesség megértette: új katonai védelemre és stratégiára van szükség."
    },
    {
      "type": "narration",
      "text": "A földből és fából épült régi várak helyett vastag falú, modern kővárak építésébe kezdtek a hegyeken."
    },
    {
      "type": "narration",
      "text": "IV. Béla király a budai hegyen új fellegvárat és palotát emelt, amely minden ostromnak képes volt ellenállni."
    },
    {
      "type": "narration",
      "text": "Országszerte több tucat megerősített erődítmény épült, amelyek biztonságos menedéket nyújtottak a lakosságnak."
    },
    {
      "type": "narration",
      "text": "Amikor a tatárok évtizedekkel később újra támadtak, a sziklaszilárd kővárak sikeresen megvédték a hazát."
    }
  ],
