  "paragraphs": [
    {
      "type": "narration",
      "text": "1222 tavaszán Székesfehérváron gyűlt össze a felháborodott magyar nemesség. Számos súlyos sérelmet akartak orvosolni."
    },
    {
      "type": "narration",
      "text": "A király, II. András hatalmas birtokokat osztogatott el, ezért a nemesek írásban követelték régi jogaik védelmét."
    },
    {
      "type": "narration",
      "text": "A király kénytelen volt kiadni a híres Aranybullát, amely megerősítette a nemesi kiváltságokat és az adómentességet."
    },
    {
      "type": "narration",
      "text": "A dokumentum korlátozta az uralkodó teljhatalmát, sőt tartalmazta a híres ellenállási jogot is a királyi törvényszegések esetére."
    },
    {
      "type": "narration",
      "text": "Az Aranybulla évszázadokon át a magyar alkotmányosság és jogállamiság büszke történelmi alapja maradt."
    }
  ],
