{
  "id": "story.b1.matyas",
  "title": "Matthias Corvinus & the Renaissance Court",
  "level": "B1",
  "order": 8,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The grand historical arc of Renaissance Hungary under King Matthias Corvinus (1458–1490): his dramatic Danube election, the invincible Black Army, European Renaissance patronage and the Corvina library, the legend of 'Matthias the Just', and the national grief following his sudden death in 1490.",
  "characters": [],
  "location": "Buda, Visegrád, Bécs, Székesfehérvár",
  "grammar": [
    "superlatives-history",
    "correlative-comparative",
    "cultural-flourishing",
    "folktale-narration",
    "historical-sayings"
  ],
  "vocabularyTopics": [
    "Királyválasztás 1458",
    "Hunyadi Mátyás",
    "Fekete sereg",
    "Állandó hadsereg",
    "Reneszánsz művészet",
    "Bibliotheca Corviniana",
    "Mátyás az igazságos",
    "Adóreform",
    "Mátyás halála 1490",
    "Nemzeti emlékezet"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "1458 dermesztően hideg telén a Duna vize vastag jéggé fagyott Buda és Pest között."
    },
    {
      "type": "narration",
      "text": "A hős nándorfehérvári győző, Hunyadi János ifjabbik fiát, Mátyást a nemesek egyhangúlag királlyá választották."
    },
    {
      "type": "narration",
      "text": "A hagyomány szerint a lelkes néptömeg a befagyott folyó jegén éljenezte a tizennégy éves ifjú uralkodót."
    },
    {
      "type": "narration",
      "text": "Mátyás családjának címerében a csőrében aranygyűrűt tartó fekete holló szerepelt, és a hagyomány szerint erről kapta a Corvinus nevet."
    },
    {
      "type": "narration",
      "text": "Az új király határozott lépésekkel vette át az ország irányítását, és hamarosan megerősítette a királyi tekintélyt. Mátyást 1464-ben koronázták meg a Szent Koronával Székesfehérváron."
    },
    {
      "type": "narration",
      "text": "A nemesi felkelés önmagában nem volt elegendő az ország biztonságos védelméhez."
    },
    {
      "type": "narration",
      "text": "Ezért Mátyás király felállította a híres fekete sereget, Közép-Európa egyik első állandó zsoldoshadseregét, amelyet a királyi bevételekből és adókból tartott fenn."
    },
    {
      "type": "narration",
      "text": "A seregben cseh, német, lengyel és magyar zsoldosok szolgáltak. A kitűnően felszerelt nehézlovasság és a modern tűzfegyverekkel harcoló gyalogság vasszigorú fegyelemben szolgált."
    },
    {
      "type": "narration",
      "text": "A sereg délen az oszmánok ellen is harcolt, nyugaton pedig 1485-ben elfoglalta Bécset. Mátyás egyik híres hadvezére Kinizsi Pál volt."
    },
    {
      "type": "narration",
      "text": "A fekete sereg miatt a Magyar Királyság a tizenötödik század végén Közép-Európa egyik legerősebb katonai hatalmának számított."
    },
    {
      "type": "narration",
      "text": "Mátyás király és a nápolyi származású felesége, Beatrix királyné Budát és Visegrádot igazi reneszánsz központtá emelte."
    },
    {
      "type": "narration",
      "text": "Gyakran úgy mondják, hogy Olaszországon kívül Magyarországon honosodott meg először a reneszánsz művészet és az építészet."
    },
    {
      "type": "narration",
      "text": "A visegrádi palota vörösmárvány szökőkútjai és díszes függőkertjei lenyűgözték a külföldi diplomatákat."
    },
    {
      "type": "narration",
      "text": "A király létrehozta a Bibliotheca Corviniana könyvtárat, amely becslések szerint több ezer kézzel írt és festett kódexet őrzött. A könyvtár kódexeit corvináknak nevezik, ma körülbelül kétszáz maradt fenn közülük."
    },
    {
      "type": "narration",
      "text": "Mátyás udvarában számos itáliai humanista tudós és művész dolgozott, és a budai műhelyben kódexeket másoltak és festettek."
    },
    {
      "type": "narration",
      "text": "Mátyás uralkodása nemcsak a hadi sikerekről és a művészetről szólt, hanem a szigorú törvényességről is."
    },
    {
      "type": "narration",
      "text": "A király 1467-ben átfogó adóreformot hajtott végre: a kapuadó helyett bevezette a királyi kincstár adóját, amelyet háztartásonként, vagyis „füstönként” kellett fizetni, ezért füstadónak vagy füstpénznek is nevezik."
    },
    {
      "type": "narration",
      "text": "A népmesék szerint Mátyás gyakran egyszerű álruhát öltött, és falvakban, mezővárosokban járva nézte meg, hogyan bánnak a bírák a szegény emberekkel."
    },
    {
      "type": "narration",
      "text": "A mesék szerint a gőgös urakat keményen megleckéztette, az elnyomott jobbágyoknak pedig igazságot szolgáltatott."
    },
    {
      "type": "narration",
      "text": "Ezért emlékezik rá a magyar nép mindmáig szeretettel úgy, mint Mátyás, az igazságos király."
    },
    {
      "type": "narration",
      "text": "1490 tavaszán váratlan és megrendítő hír érkezett Bécsből: a nagy király negyvenhét évesen hirtelen meghalt."
    },
    {
      "type": "narration",
      "text": "A királyt Székesfehérváron, a királyi bazilikában temették el."
    },
    {
      "type": "narration",
      "text": "Mátyásnak nem volt törvényes fia, így a halála után a főnemesek között harc kezdődött a trónért."
    },
    {
      "type": "narration",
      "text": "A fekete sereg a következő években feloszlott, és az oszmán veszély újra fenyegetővé vált."
    },
    {
      "type": "narration",
      "text": "A hagyomány szerint ekkor született a mondás, amely ma is él a magyar nyelvben: „Meghalt Mátyás, oda az igazság.”"
    }
  ],
