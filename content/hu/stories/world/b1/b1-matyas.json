    "folktale-narration",
    "historical-sayings"
  ],
  "vocabularyTopics": [
    "Királyválasztás 1458",
    "Hunyadi Mátyás",
    "Fekete sereg",
    "Állandó hadsereg",
    "Reneszánsz művészet",
    "Bibliotheca Corviniana",
    "Mátyás az igazságos",
    "Adóreform",
    "Mátyás halála 1490",
    "Nemzeti emlékezet"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "1458 telén a befagyott Duna jegén tízezres tömeg gyűlt össze Budán. Ki lesz a Magyar Királyság új uralkodója?"
    },
    {
      "type": "narration",
      "text": "A nép és a köznemesség Hunyadi Mátyást követelte, miközben a vezető főnemes csoportok heves vitát folytattak."
    },
    {
      "type": "narration",
      "text": "Hosszú és feszült tárgyalás után megszületett a döntés: az ifjú Hunyadi fiú foglalja el a magyar trón helyét."
    },
    {
      "type": "narration",
      "text": "A megválasztás pillanatában Mátyás még Prágában volt fogságban, de hamarosan hazatért az ünnepélyes eseményre."
    },
    {
      "type": "narration",
      "text": "A szent koronázás után a királyi címerpajzs dísze, a gyűrűt tartó fekete holló az egész ország jelképe lett."
    },
    {
      "type": "narration",
      "text": "A középkori királyok ritkán tartottak fizetett katonákat békében. Mátyás király azonban teljesen megújította a hadviselés művészetét."
    },
    {
      "type": "narration",
      "text": "Létrejött a híres fekete sereg, Közép-Európa első jól képzett állandó hadsereg alakulata."
    },
    {
      "type": "narration",
      "text": "A tapasztalt zsoldos harcosok vaskos fegyelem alatt szolgáltak, modern fegyverzet és puskák védték őket."
    },
    {
      "type": "narration",
      "text": "A kiváló tehetségű hadvezér vezetése alatt a sereg sorra nyerte a hadjáratokat és foglalta el Bécset."
    },
    {
      "type": "narration",
      "text": "A hadsereg fenntartását és a hadisarc fizetését a király szigorú adóztatási rendszere biztosította."
    },
    {
      "type": "narration",
      "text": "Hogyan vált egy közép-európai királyi vár az itáliai kultúra legfontosabb északi központjává?"
    },
    {
      "type": "narration",
      "text": "Mátyás király felesége, Beatrix királyné révén Buda és Visegrád udvarába beköltözött a ragyogó reneszánsz korszak."
    },
    {
      "type": "narration",
      "text": "Olasz mesterek által virágzott az építészet és a művészet, a hegyen felépült a csodás visegrádi palota."
    },
    {
      "type": "narration",
      "text": "A királyi könyvtár a világ egyik legértékesebb gyűjteménye volt, a kézzel másolt corvina kódexek száma meghaladta az ezret."
    },
    {
      "type": "narration",
      "text": "A budai várban számos híres tudós és humanista filozófus talált békés otthonra és támogatásra."
    },
    {
      "type": "narration",
      "text": "A magyar néphagyományban egyetlen király sem maradt olyan elevenen, mint Hunyadi Mátyás. De miért hívták igazságosnak?"
    },
    {
      "type": "narration",
      "text": "A legendák szerint a király gyakran öltött szegényes álruha öltözéket, hogy titokban ellenőrizze a főurak viselkedését."
    },
    {
      "type": "narration",
      "text": "Mátyás bátor adóreform bevezetésével megszüntette a kibúvókat, és a háztartásokra kivetett füstadó fizetését rendelte el."
    },
    {
      "type": "narration",
      "text": "Szigorú rendtartás és következetes bíráskodás jellemezte uralmát, amely a kisemberek védelmét is biztosította."
    },
    {
      "type": "narration",
      "text": "A törvényesség tisztelete miatt a népmese világában Mátyás örökre az elnyomottak védelmezője maradt."
    },
    {
      "type": "narration",
      "text": "1490 tavaszán Bécsben hirtelen bekövetkezett a nagy uralkodó halál eseménye, és mély gyász borult az országra."
    },
    {
      "type": "narration",
      "text": "Mátyás király után nem maradt törvényes felnőtt örökös, így a hatalmas központi monarchia gyorsan hanyatlani kezdett."
    },
    {
      "type": "narration",
      "text": "A nép ajkán azonnal megszületett a szomorú mondás: Meghalt Mátyás, oda az igazság."
    },
    {
      "type": "narration",
      "text": "Ez a híres közmondás generációkon át őrizte azt az emléket, hogy uralkodása igazi aranykor és virágkor volt."
    },
    {
      "type": "narration",
      "text": "A hálás utókor szemében Mátyás gazdag öröksége a nemzet csúcspontja, egy dicsőséges történelmi korszak megtestesítője maradt."
    }
  ],
