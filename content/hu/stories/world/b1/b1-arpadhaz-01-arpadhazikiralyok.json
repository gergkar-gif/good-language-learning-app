  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "Szent István után a hatalom az Árpád-ház kezében maradt. Ez a dinasztia három évszázadon át formálta az ország sorsát."
    },
    {
      "type": "narration",
      "text": "Az Árpád-házi királyok mind István rokonai voltak, tőle származtak vagy a dinasztia más ágából leszármazott utódok voltak."
    },
    {
      "type": "narration",
      "text": "Szent László király szigorú törvénykönyvet adott ki, és a határok védelmében sikeres hadjáratokat vezetett. Később őt is szentté avatták."
    },
    {
      "type": "narration",
      "text": "Könyves Kálmán király igazi tudós uralkodó volt. Felvilágosult módon eltörölte a boszorkányok büntetését, mondván: boszorkányok nem léteznek."
    },
    {
      "type": "narration",
      "text": "Az Árpád-ház királyai és szentjei örökre a nemzet büszkeségei maradtak."
    }
  ],
