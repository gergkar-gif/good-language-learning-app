{
  "id": "story.b1.mohacs",
  "title": "The Battle of Mohács (1526)",
  "level": "B1",
  "order": 9,
  "type": "world",
  "estimatedMinutes": 8,
  "summary": "The catastrophic collapse of medieval Hungary at the Battle of Mohács (August 29, 1526): internal disunity after 1514, the rise of Suleiman I and fall of Nándorfehérvár, the two-hour collapse against Ottoman artillery, the drowning of King Louis II in the Csele brook, and the enduring cultural memory encapsulated in 'Több is veszett Mohácsnál'.",
  "characters": [],
  "location": "Buda, Nándorfehérvár, Mohács, Csele-patak",
  "grammar": [
    "causality-preconditions",
    "temporal-clauses",
    "rapid-sequence",
    "participles-tragedy",
    "proverb-fatalism"
  ],
  "vocabularyTopics": [
    "A Jagelló-korszak",
    "Belső viszályok",
    "1514 parasztfelkelés",
    "I. Szulejmán szultán",
    "Nándorfehérvár eleste 1521",
    "Oszmán előrenyomulás",
    "Mohácsi csata 1526",
    "Tomori Pál",
    "Lovasroham és tüzérség",
    "II. Lajos halála",
    "Csele-patak",
    "Dinasztikus válság",
    "Korszakhatár 1526",
    "Több is veszett Mohácsnál",
    "Nemzeti emlékezet"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "Mátyás halála után harminc év alatt a virágzó királyság a mélybe zuhant. Hogyan omolhat össze egy nagyhatalom ilyen gyorsan?"
    },
    {
      "type": "narration",
      "text": "A meggyengült központi hatalmat a nemesség önzése és a szüntelen belső viszály tette tehetetlenné."
    },
    {
      "type": "narration",
      "text": "Az 1514-es véres parasztfelkelés leverése után a jobbágyság sorsa még nehezebb lett a nemesi megtorlás miatt."
    },
    {
      "type": "narration",
      "text": "A királyi kincstár teljesen kiürült, és a krónikus zsoldoshiány miatt a sereget feloszlatták."
    },
    {
      "type": "narration",
      "text": "A nemesi széthúzás megakadályozta az összefogást, miközben a határokon már gyülekeztek a hódító oszmán csapatok."
    },
    {
      "type": "narration",
      "text": "1526 tavaszán Isztambulból útnak indult I. Szulejmán szultán hatalmas és jól felszerelt serege Közép-Európa felé."
    },
    {
      "type": "narration",
      "text": "A grandiózus katonai hadjárat célja a Magyar Királyság teljes meghódítása és Bécs elérése volt."
    },
    {
      "type": "narration",
      "text": "A félelmetes oszmán túlerő modern ágyú tüzérséggel és janicsár gyalogsággal vonult előre a Duna mentén."
    },
    {
      "type": "narration",
      "text": "Minden déli végvár ostrom alatt roskadozott, Nándorfehérvár eleste után a határok védtelenek maradtak."
    },
    {
      "type": "narration",
      "text": "A magyar királyi udvar kétségbeesett segítségkérés levelei visszhang nélkül maradtak, a nemzet teljes elszigeteltség állapotába került."
    },
    {
      "type": "narration",
      "text": "1526. augusztus 29-én délután Mohács mellett állt szemben a két hadsereg a nyári hőségben."
    },
    {
      "type": "narration",
      "text": "Tomori Pál érsek fővezér bátor elgondolása szerint egy hirtelen, mindent elsöprő roham dönthette el a csatát."
    },
    {
      "type": "narration",
      "text": "A zárt hadrend élén támadó nehéz magyar lovasság kezdetben visszanyomta az oszmán előőrsöket."
    },
    {
      "type": "narration",
      "text": "Ám a szultán soraiból megnyíló gyilkos tüzérségi tűz és a golyózápor pillanatok alatt megtörte a támadást."
    },
    {
      "type": "narration",
      "text": "Kezdetét vette a pánikszerű megfutamodás a mocsár és a patakok felé, a rosszul megválasztott taktika katasztrófát hozott."
    },
    {
      "type": "narration",
      "text": "A vesztes csatatérről fejvesztve menekült a fiatal, húszéves magyar uralkodó, II. Lajos király kíséretével."
    },
    {
      "type": "narration",
      "text": "A viharos menekülés közben a megáradt Csele-patak partján a király lova megcsúszott a sárban és hanyatt esett."
    },
    {
      "type": "narration",
      "text": "A nehéz páncél súlya miatt a király nem tudott felállni a vízből, és szomorú fulladás vetett véget életének."
    },
    {
      "type": "narration",
      "text": "Két hónappal később találták meg a holttest földi maradványait, és Székesfehérváron temették el."
    },
    {
      "type": "narration",
      "text": "Mivel nem maradt hátra törvényes trónörökös, az országban azonnal súlyos dinasztikus válság robbant ki a trónért."
    },
    {
      "type": "narration",
      "text": "Mohács nemcsak egy vesztes ütközet volt, hanem a magyar történelem legnagyobb és legsúlyosabb tragédiája."
    },
    {
      "type": "narration",
      "text": "Ez a végzetes dátum sorsdöntő fordulópont és korszakhatár, amely után a középkori független királyság darabokra hullott."
    },
    {
      "type": "narration",
      "text": "A szomorú közmondás így vigasztalja a bánkódót: Több is veszett Mohácsnál."
    },
    {
      "type": "narration",
      "text": "A véres csata helyszínén ma méltó emlékhely fogadja a látogatókat a nemzeti emlékezet és a gyász jegyében."
    },
    {
      "type": "narration",
      "text": "A tragédia legfontosabb történelmi tanulság üzenete: a széthúzás bukást hoz, de a nemzet megmaradás hite legyőzhetetlen."
    }
  ],
