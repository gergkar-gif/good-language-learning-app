{
  "id": "story.a1.unit27",
  "title": "The City",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg is learning to move around the city more independently."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hol van a bank?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "A bank közel van. A posta is közel van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hová megyünk?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Az állomásra megyünk."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A gyógyszertár hol van?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "A bolt mellett van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "És az iskola?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Az utca végén van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van itt park?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Igen, a park közel van. A kórház messze van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A múzeum és a mozi is itt van?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Igen. A könyvtár a téren van."
    }
  ]
}