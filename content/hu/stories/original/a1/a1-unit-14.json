{
  "id": "story.a1.unit14",
  "title": "A Bad Line",
  "level": "A1",
  "lesson": 70,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Meg",
    "Mariann",
    "Károly",
    "András",
    "Anna"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "A quiet Saturday afternoon. Meg is at home in the new flat. Her phone rings. It is Mariann."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Szia, Meg! Otthon vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, otthon vagyok. És te?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "A parkban sétálok. Ki főz?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Károly a konyhában főz. Én olvasok."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Tényleg? És András? Otthon van?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "András nincs itt. Nem otthon ír, hanem az irodában."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Mikor ír?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Reggel ír. Délután otthon van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "The line is bad. Meg does not catch the next question."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Miért nem főzöl?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Nem értem. Még egyszer, légy szíves?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Nem baj. Még egyszer: miért nem főzöl?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mert olvasok. Este főzök."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Rendben. Hol van Anna?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Anna nincs itt. Talán táncol."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Persze, Anna táncol! Köszi, Meg! Szia!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szia, Mariann!"
    }
  ],
