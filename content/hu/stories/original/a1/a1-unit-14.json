  "title": "Saying No & Asking Questions",
  "level": "A1",
  "lesson": 70,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Károly",
    "Meg",
    "András",
    "Anna",
    "Mariann"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "A small misunderstanding gives Meg a chance to ask questions and say no."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Dolgozol ma?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Nem dolgozom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igaz?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Persze. Igaz."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They check the details carefully."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Tényleg nem dolgozol?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen. Most nem dolgozom."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Miért?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mert tanulok."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Hogyan tanulsz?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Otthon."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg does not understand one question."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Nem értem."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Nem baj. Ez egy kérdés."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A válasz most egyszerű."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Melyik válasz?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ez a válasz."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Valaki kérdez?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, valaki kérdez. Senki nem haragszik."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Van valami más?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Nem, semmi."
    }
  ],
  "narration": {
    "pedagogical": {
      "comprehensionQuestions": [
        {
          "question": "Milyen nyelvi fordulatokat gyakorol Meg ebben a beszélgetésben?",
          "options": [
            "Csak a múlt idő használatát",
            "A hivatalos levélírást",
            "Az árak kérdezését a piacon",
            "A nemet mondást és a kérdések megválaszolását"
          ],
          "correctIndex": 3,
          "explanation": "A lecke témája a tagadás („nem dolgozom”) és a kérdések megértése és megválaszolása (Practising saying no and answering questions)."
        },
        {
          "question": "Miért nem dolgozik Meg aznap?",
          "options": [
            "Mert tanul",
            "Mert fáradt",
            "Mert moziba megy",
            "Mert beteg"
          ],
          "correctIndex": 0,
          "explanation": "Mariann kérdésére („Miért?”) Meg ezt feleli: „Mert tanulok” (Because I am studying)."
        },
        {
          "question": "Hol tanul Meg Károly kérdésére válaszolva?",
          "options": [
            "A könyvtárban",
            "Az egyetemen",
            "Otthon",
            "Egy kávézó teraszán"
          ],
          "correctIndex": 2,
          "explanation": "Károly kérdésére („Hogyan tanulsz?”) Meg válasza: „Otthon” (At home)."
        }
      ]
    }
  }
