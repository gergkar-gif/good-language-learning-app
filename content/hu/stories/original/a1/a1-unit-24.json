{
  "id": "story.a1.unit24",
  "title": "At the Restaurant",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly, Meg, András, Anna and Mariann have a meal together."
    },
    {
      "type": "dialogue",
      "speaker": "Pincér",
      "text": "Jó napot kívánok! Itt az étlap."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szeretnék levest és salátát."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Én csirkét kérek körettel."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Én vegetáriánus vagyok. Salátát szeretnék."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Éhes vagyok, de nem vagyok szomjas."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Kell még valami?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, vizet kérek."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Desszert is kell."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Szeretnék menüt, mert éhes vagyok."
    },
    {
      "type": "dialogue",
      "speaker": "Pincér",
      "text": "Kártya vagy készpénz?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Kártya. Fizetek."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Köszönöm."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A menüben leves, saláta, köret és desszert van. András csirkét kér, Mariann marhát kér. Anna vegetáriánus. Mindenki éhes vagy szomjas. Kártyával vagy készpénzzel fizetnek."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "étterem marha csirke szeretne."
    }
  ]
}