{
  "id": "story.a1.unit25",
  "title": "Shopping",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg and Károly go to a shop to buy something practical."
    },
    {
      "type": "dialogue",
      "speaker": "Eladó",
      "text": "Jó napot kívánok! Mit keres?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Egy pólót és egy táskát keresek."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez a termék jó?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, tetszik. Milyen a méret?"
    },
    {
      "type": "dialogue",
      "speaker": "Eladó",
      "text": "Nagy vagy kicsi?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A nagy jó. Milyen a szín?"
    },
    {
      "type": "dialogue",
      "speaker": "Eladó",
      "text": "Piros, kék, fekete és fehér van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A kék pólót kérem. Mennyi az ár?"
    },
    {
      "type": "dialogue",
      "speaker": "Eladó",
      "text": "Tíz forint."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Rendben. A könyv is ajándék?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Nem, az ajándék külön van."
    }
  ]
}