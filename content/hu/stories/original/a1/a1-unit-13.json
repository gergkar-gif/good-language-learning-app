{
  "id": "story.a1.unit13",
  "title": "What You Do",
  "level": "A1",
  "lesson": 65,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Károly",
    "Meg",
    "András",
    "Anna",
    "Mariann"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly and Meg talk about what they do during the day."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Dolgozom és tanulok."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Olvasok és írok."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "András magyarul beszél."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Anna angolul beszél és hallgat."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They describe ordinary activities."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Este filmet nézek."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Reggel eszem és iszom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Éjjel alszom."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Károly főz."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Meg vesz egy könyvet."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg looks for her phone while Károly waits."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Keresem a telefonomat."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Várok."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Utána sétálunk."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A gyerekek játszanak."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mariann tanít."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Meg kérdez."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Én válaszolok."
    }
  ]
}