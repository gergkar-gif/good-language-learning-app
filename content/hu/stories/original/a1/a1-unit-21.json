{
  "id": "story.a1.unit21",
  "title": "Buying Food",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg and Károly go to a shop because they need food."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Jó napot kívánok!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Kérek kenyeret, tejet és sajtot."
    },
    {
      "type": "dialogue",
      "speaker": "Eladó",
      "text": "Almát vagy narancsot kér?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Kérek két almát és egy narancsot."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Mennyi a hús?"
    },
    {
      "type": "dialogue",
      "speaker": "Eladó",
      "text": "Három forint egy kiló. Nem drága."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Kérek egy kiló húst és egy liter vizet."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg asks about the price and then pays."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mennyi az ár?"
    },
    {
      "type": "dialogue",
      "speaker": "Eladó",
      "text": "Olcsó. Öt forint."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Rendben. Fizetek."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Meg vesz kenyeret, almát, tojást, halat és rizst. Vizet is kér. Egy darab süteményt is szeretne."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "kenyér alma víz."
    }
  ]
}