{
  "id": "story.a1.unit12",
  "title": "Going Somewhere",
  "level": "A1",
  "lesson": 60,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Károly",
    "Meg",
    "András",
    "Anna",
    "Mariann"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg and Károly leave the flat. They talk about destinations."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A busz az állomásra megy."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A villamos a megállóba jön."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A mozi mellett van a kávézó."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ma a kávézóba megyünk."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They pass several places in the city."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Az étterembe megyünk, nem a múzeumba."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Az egyetem messze van a központtól."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A munkahelyem a központban van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A posta a bank mellett van."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A gyógyszertár az út mellett van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They notice an entrance and an exit at the next building."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hol van a bejárat?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A bejárat itt van. A kijárat ott van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ez a hely jó."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They continue towards the centre."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Megyünk a központba."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, a központba megyünk."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A szó: menni."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A szó: jönni."
    }
  ]
}