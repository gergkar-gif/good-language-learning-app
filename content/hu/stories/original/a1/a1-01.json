    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Szia, Béla!"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Szia, Anna!"
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Tea?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Igen, tea."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Kávé?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Nem, kávé."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Csoki?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Igen, csoki."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Taxi?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Igen, taxi a hotelhez."
    }
  ]
}