{
  "id": "story.a1.unit02",
  "title": "Greetings with Károly",
  "level": "A1",
  "lesson": 10,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Meg",
    "Károly",
    "Anna",
    "András",
    "Mariann"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg meets Károly and his friends. They practise greetings and polite expressions."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Jó napot, Meg!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Jó napot, Károly! Hogy vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Jól vagyok, köszönöm. És te?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Jól vagyok, köszönöm."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg does not understand what Anna asks, so she asks her to repeat it more slowly."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Hogy vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Elnézést, nem értem. Megismételnéd? Lassabban, kérem."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Hogy... vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ó, értem! Jól vagyok, köszönöm."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Tessék, egy kávé!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Köszönöm! Rendben."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "It's time to go. Meg says goodbye to everyone."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Viszlát, Meg!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Viszlát, Károly! Viszlát, Anna! Viszlát, András! Viszlát, Mariann!"
    }
  ]
}
