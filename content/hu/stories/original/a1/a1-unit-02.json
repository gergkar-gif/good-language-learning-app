  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg meets Károly and his friends. They practise greetings and polite expressions."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Jó reggelt! Jó napot! Jó estét!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Jó reggelt! Jó napot! Jó estét! Jó éjszakát!"
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Viszlát, Meg!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Köszönöm. Szívesen."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ön, uram. Ön, asszonyom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ön, uram. Ön, asszonyom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ön, uram. Ön, asszonyom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ön, uram. Ön, asszonyom."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Bocsánat. Elnézést."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg does not understand a question, so she asks the speaker to repeat it."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Megismételné? Még egyszer, kérem. Lassabban, kérem."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Persze. Mit mondott?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Értem. Nem értem."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Rendben. Tessék."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "The short exchange is enough for Meg to continue the conversation without English."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Rendben. Köszönöm. Viszlát!"
    }
  ]
}