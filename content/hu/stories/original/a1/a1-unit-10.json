{
  "id": "story.a1.unit10",
  "title": "Foundations",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "The first foundation arc comes together at a small gathering with Károly, Meg, Anna, András and Mariann."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Szia, Meg!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szia! Köszönöm."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg introduces herself and asks simple questions."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Meg vagyok. Mi a neved?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Károly vagyok."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hol laksz?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Budapesten lakom."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Anna and András join them. Meg can identify people, objects and family members."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ő Anna. Ő András."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ők a család."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Mi ez?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ez egy könyv."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "There are several books and chairs. Meg can now recognise plurals."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "A könyvek és a székek itt vannak."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A barátok is itt vannak."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg also understands simple possession."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez a táskád?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, a táska az enyém."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Ez a könyved?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Nem, a könyvem itt van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "The group continues speaking Hungarian. Meg no longer needs every short exchange translated."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen. Értem."
    }
  ]
}