{
  "id": "story.a1.unit10",
  "title": "A Small Gathering",
  "level": "A1",
  "type": "original",
  "characters": [
    "Károly",
    "Meg",
    "Anna",
    "András",
    "Mariann"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Anna and András visit Meg and Károly in their flat."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szia, Anna! Szia, András!"
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Szia, Meg! Hogy vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Jól vagyok, köszönöm. És te?"
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Jól vagyok, köszönöm."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg shows them the flat."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Itt van a konyha. A szoba ott van."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Nagyon szép lakás!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Köszönöm! A szobánk kicsi, de a konyha nagy."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Anna sees a bag on a chair."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Kié a táska?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A táska az enyém. A kulcsom a táskában van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Mariann arrives. She is Meg's friend."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Szia! Bocsánat!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Semmi baj. Ő Anna, ő András."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Van testvéred, Mariann?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Igen, van egy bátyám. Ő magas és nagyon vicces."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "There are many people, but not enough chairs."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Sok ember van itt. Több szék kell."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Rendben! A székek a konyhában vannak."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Tessék, a kávé."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Köszönöm!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szívesen! A barátok együtt vannak."
    }
  ],
  "narration": {
    "pedagogical": {
