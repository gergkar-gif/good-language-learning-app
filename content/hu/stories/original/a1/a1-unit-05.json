{
  "id": "story.a1.unit05",
  "title": "What Is This?",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg is in Károly's lakás. They look around the szoba together."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez a szoba."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mi ez?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez egy asztal. Az ott egy szék."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg sees a könyv, a telefon and a lámpa. The ajtó and ablak are open."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mi ez a könyv?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez egy könyv. A telefon ott van az asztalon."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "És a lámpa?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Itt van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They walk to the konyha. There is a kulcs by the ajtó."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hol van a kulcs?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ott van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg asks about another tárgy."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van itt egy szék?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Nincs. Van egy asztal."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg can now ask what something is and where it is."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez a tárgy egy telefon."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Micsoda ez?"
    }
  ]
}