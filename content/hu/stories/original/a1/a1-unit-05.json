{
  "id": "story.a1.unit05",
  "title": "What Is This?",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg is in Károly's apartment. They look around the room together."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez a szoba."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mi ez?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez egy asztal. Az ott egy szék."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg sees a book, a phone, and a lamp. The door and window are open."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mi ez a könyv?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez egy könyv. A telefon ott van az asztalon."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "És a lámpa?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Itt van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They walk to the kitchen. There is a key by the door."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hol van a kulcs?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ott van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg asks about another object."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van itt egy szék?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Nincs. Van egy asztal."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg can now ask what something is and where it is."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez a tárgy egy telefon."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Micsoda ez?"
    }
  ]
}