{
  "id": "story.a1.unit26",
  "title": "Clothes & Appearance",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly, Meg, Anna and Mariann talk about clothes and choose something to wear."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Szép ez a ruha."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen. A szoknya is szép."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Én inget és pulóvert viselek."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A kabát hosszú, de kényelmes."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A nadrág rövid?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Nem, a nadrág hosszú."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Ez a zokni színes."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A sapka világos vagy sötét?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Sötét. A csizma is sötét."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szeretném felpróbálni a cipőt."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Ez csúnya, de az szép."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Rendben, ezt viselem."
    }
  ]
}