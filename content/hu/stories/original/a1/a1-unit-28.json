{
  "id": "story.a1.unit28",
  "title": "Transport & Directions",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg and Mariann travel across Budapest and have a small navigation problem."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mivel megyünk?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Busszal vagy villamossal."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van jegyünk?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Igen. A megálló ott van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A metróval megyünk?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Nem, most busszal utazunk."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hol a pályaudvar?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Menj egyenesen, aztán jobbra."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "És a taxi?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "A taxi balra van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mikor indul a vonat?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Hamarosan. Mi felszállunk, aztán te leszállsz."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mikor érkezünk?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Hamarosan. Jön a busz."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "gyalog bicikli érkezik utazik."
    }
  ]
}