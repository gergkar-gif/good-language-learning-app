{
  "id": "story.a1.unit01",
  "title": "Meg in Budapest",
  "level": "A1",
  "lesson": 5,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Károly",
    "Meg"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "Meg is in Budapest with Károly. She knows little Hungarian, but today she wants to try a small everyday adventure."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Szia, Meg!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szia!"
    },
    {
      "type": "narration",
      "text": "Károly points to a book and a phone on the table."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Mi ez?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ez egy könyv."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "És mi az?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Az egy telefon."
    },
    {
      "type": "narration",
      "text": "Then Károly points to a coffee and a glass of water."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Mi ez?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ez egy kávé. És az egy víz."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen. Jó?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, jó."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Nem rossz, Meg! Jó!"
    },
    {
      "type": "narration",
      "text": "Outside, Meg sees a big house."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mi az? Egy nagy ház?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen. Az egy nagy ház."
    },
    {
      "type": "narration",
      "text": "Meg turns to Károly."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ki ő?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ő Anna."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "És te? Károly vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen, Károly vagyok."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Én Meg vagyok. Köszönöm!"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Kérem."
    },
    {
      "type": "narration",
      "text": "Meg smiles. She has used Hungarian on her own for the first time."
    }
  ]
}