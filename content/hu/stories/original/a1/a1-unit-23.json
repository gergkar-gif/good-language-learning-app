{
  "id": "story.a1.unit23",
  "title": "At the Café",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "The group meets at a café. Meg orders in Hungarian."
    },
    {
      "type": "dialogue",
      "speaker": "Pincér",
      "text": "Jó napot kívánok! Itt az étlap."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Kérek egy kávét és egy teát."
    },
    {
      "type": "dialogue",
      "speaker": "Pincér",
      "text": "Szeretne limonádét vagy üdítőt?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szeretnék egy limonádét. És egy szendvicset kérek."
    },
    {
      "type": "dialogue",
      "speaker": "Pincér",
      "text": "Kér még süteményt?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, kérek egy süteményt."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Én kérek reggelit."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Kérek cukrot és tejet is."
    },
    {
      "type": "dialogue",
      "speaker": "Pincér",
      "text": "Hozom. Meleg a kávé."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Köszönöm. Finom."
    },
    {
      "type": "dialogue",
      "speaker": "Pincér",
      "text": "Kérik a számlát?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, kérem."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "The waiter brings coffee, tea, lemonade, and soda. Meg asks for a sandwich, a pastry, and a breakfast plate, along with some sugar and milk."
    }
  ]
}