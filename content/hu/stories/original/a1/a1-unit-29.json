{
  "id": "story.a1.unit29",
  "title": "Hobbies & Free Time",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "The friends talk about free time and discover activities they enjoy together."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Mit csinálsz szabadidőben?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szeretek sportolni. Szeretem az úszást és a futást."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Én a focit szeretem."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Szeretem a zenét és a filmeket."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Szeretek olvasni."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szeretsz táncolni?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen, szeretek táncolni."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Én szeretek kirándulni."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Találkozunk a hétvégén?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, együtt."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Én játszani is szeretek."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Én szeretek filmet nézni és zenét hallgatni."
    }
  ]
}