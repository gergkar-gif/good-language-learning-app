{
  "id": "story.a1.02",
  "title": "Anna és Béla",
  "level": "A1",
  "lesson": 2,
  "type": "original",
  "estimatedMinutes": 1,
  "characters": [
    "Anna",
    "Béla"
  ],
  "paragraphs": [
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Én Anna vagyok."
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Én Béla vagyok."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Te diák vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Igen, diák vagyok."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Én tanár vagyok."
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Ő Anna."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Ő Béla."
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Anna magyar."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Béla angol?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Nem, Béla magyar."
    }
  ]
}