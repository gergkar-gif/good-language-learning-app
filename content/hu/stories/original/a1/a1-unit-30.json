{
  "id": "story.a1.unit30",
  "title": "Friends & Making Plans",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "The group wants to make a plan for a shared activity."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Van egy tervem. Szeretnétek együtt programot?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen. Mikor találkozunk?"
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Holnap délután jó?"
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Nekem nem jó délután, de este ráérek."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Nekem is jó az este."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Akarunk találkozni hétkor?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, szeretnék."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Nekem hét óra jó."
    },
    {
      "type": "dialogue",
      "speaker": "Mariann",
      "text": "Lehet nyolc óra?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen, lehet."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Hol találkozunk?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A téren. Ez a program."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Jó. Akkor együtt megyünk."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "meghív találkozó találkozik hétvége szeretne."
    }
  ]
}