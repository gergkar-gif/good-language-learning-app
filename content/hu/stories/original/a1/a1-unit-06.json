{
  "id": "story.a1.unit06",
  "title": "Family",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly shows Meg a family photo. He introduces everyone in it, one by one."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ez a családom."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ki az?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Az az anyám."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "És az?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Az az apám."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg asks if Károly has any siblings."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van testvéred?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen. Van egy bátyám és egy húgom."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "He points to two more people in the photo."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ki az?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Az a bátyám, az a húgom."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "The photo also has Károly's grandparents and his wife."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ki az?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Az a nagymamám, az a nagypapám."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "És az?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Az a feleségem."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg counts all the family members in the photo."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Sok családtag van a képen."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen. A családtagok együtt vannak."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg is happy — she already understands most of Károly's family."
    }
  ]
}