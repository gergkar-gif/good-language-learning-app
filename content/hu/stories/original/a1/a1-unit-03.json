{
  "id": "story.a1.unit03",
  "title": "Meg meets Anna and András",
  "level": "A1",
  "lesson": 15,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Károly",
    "Meg",
    "Anna",
    "András"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "Károly introduces Meg to his sister Anna and his brother András. The group is still speaking mostly English, but Meg wants to try more Hungarian.",
      "lang": "en"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Meg, ő Anna."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szia, Anna!"
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Szia! Ki vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Én Meg vagyok."
    },
    {
      "type": "narration",
      "text": "Anna smiles and asks Meg one more question.",
      "lang": "en"
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Hol laksz?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Én itt lakom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen. Meg itt lakik Budapesten."
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Ki ő?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ő Meg. Ő a barátom."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "És te? Ki vagy?"
    },
    {
      "type": "dialogue",
      "speaker": "András",
      "text": "Én András vagyok."
    },
    {
      "type": "narration",
      "text": "Meg understands most of the short exchange. She can now say her name and give a simple answer about where she lives.",
      "lang": "en"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Én Meg vagyok. Itt lakom."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Mi a neved?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A nevem Meg."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ő egy ember. Ő egy férfi. Ő ott van."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ő a barátom. A család fontos."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Ő egy nő."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A név fontos."
    }
  ]
}