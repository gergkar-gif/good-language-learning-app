{
  "id": "story.a1.unit07",
  "title": "Describing People",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg meets several people in Budapest. She asks Károly what each one is like."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Milyen ő?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ő egy magas férfi. Kedves és vicces."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "The man is Károly's friend. He has brown hair and is very strong."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ő a barátod?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen, ő a barátom."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "A young woman arrives. She is short, blonde, and quiet."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Milyen a nő?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Fiatal, szőke és csendes."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Another woman is old and very kind. She is not loud."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ő egy ismerős. Nagyon kedves."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg notices a small person near the door. The person is strong."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ő milyen?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Kicsi, de erős."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg now understands that a person can be a man or a woman."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Sok érdekes ember van itt."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They continue talking about friends and acquaintances."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Milyen az ember?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A férfi magas, a nő alacsony."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A barna haj szép."
    }
  ]
}