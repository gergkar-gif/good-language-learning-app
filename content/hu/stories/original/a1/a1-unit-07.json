{
  "id": "story.a1.unit07",
  "title": "Describing People",
  "level": "A1",
  "type": "original",
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg meets several people in Budapest. She asks Károly milyen they are."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Milyen ő?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ő egy magas férfi. Kedves és vicces."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "The férfi is Károly's barát. He has barna hair and is nagyon erős."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ő a barátod?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Igen, ő a barátom."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "A fiatal nő arrives. She is alacsony, szőke and csendes."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Milyen a nő?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Fiatal, szőke és csendes."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Another woman is öreg and very kind. She is not hangos."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Ő egy ismerős. Nagyon kedves."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg notices a kicsi person near the door. The person is erős."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ő milyen?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Kicsi, de erős."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg now understands that an ember can be a férfi or a nő."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Sok érdekes ember van itt."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They continue talking about friends and acquaintances."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Milyen az ember?"
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A férfi magas, a nő alacsony."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A barna haj szép."
    }
  ]
}