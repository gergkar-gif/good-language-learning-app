{
  "id": "story.a1.04",
  "title": "Ma és tegnap",
  "level": "A1",
  "lesson": 4,
  "type": "original",
  "estimatedMinutes": 1,
  "characters": [
    "Anna",
    "Béla"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "speaker": "Anna",
      "text": "Ma Anna Budapesten lakik."
    },
    {
      "type": "narration",
      "speaker": "Anna",
      "text": "Ma Anna tanul."
    },
    {
      "type": "narration",
      "speaker": "Anna",
      "text": "Béla ma dolgozik."
    },
    {
      "type": "narration",
      "speaker": "Anna",
      "text": "Tegnap Anna otthon tanult."
    },
    {
      "type": "narration",
      "speaker": "Anna",
      "text": "Tegnap Béla otthon dolgozott."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Ma tanulsz?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Igen, ma tanulok."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Tegnap tanultál?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Igen, tegnap tanultam."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Tegnap Budapesten laktál?"
    }
  ]
}