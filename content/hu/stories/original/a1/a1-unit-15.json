  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg follows Károly through a normal day."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Reggel felkelek és felébredek."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Reggelizek."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Délben ebédelek."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Délután dolgozom."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "The day continues."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Este vacsorázom."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Éjjel alszom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Reggel indulok."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Munka után haza megyek."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A munka reggel kezdődik."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A munka délután fejeződik be."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They compare their schedules."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Van egy szünet délben."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van egy óra délután."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Minden nap dolgozom."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Gyakran tanulok este."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Mikor fekszel le?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Este lefekszem."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "A nap véget ér."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen. Jó éjszakát."
    }
  ],
  "narration": {
