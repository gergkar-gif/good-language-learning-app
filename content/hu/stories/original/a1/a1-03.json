{
  "id": "story.a1.03",
  "title": "Tanulok és dolgozom",
  "level": "A1",
  "lesson": 3,
  "type": "original",
  "estimatedMinutes": 1,
  "characters": [
    "Anna",
    "Béla"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "speaker": "Anna",
      "text": "Anna tanul."
    },
    {
      "type": "narration",
      "speaker": "Anna",
      "text": "Béla dolgozik."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Tanulsz?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Igen, tanulok."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Dolgozol?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Nem, ma nem dolgozom."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Beszélsz angolul?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Igen, beszélek angolul."
    },
    {
      "type": "dialogue",
      "speaker": "Anna",
      "text": "Hol laksz?"
    },
    {
      "type": "dialogue",
      "speaker": "Béla",
      "text": "Budapesten lakom."
    }
  ]
}