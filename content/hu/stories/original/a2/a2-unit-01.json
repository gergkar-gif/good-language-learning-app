{
  "id": "story.a2.unit01",
  "title": "Meg's Daily Routine",
  "level": "A2",
  "lesson": 5,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Meg",
    "Károly"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly asks Meg to describe a typical weekday."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hétkor felkelek, aztán zuhanyozom."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Utána felöltözöm, végül reggelizem."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Kilenctől ötig dolgozom."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly wants to know if she works on the weekend too."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hétköznap dolgozom, hétvégén nem."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szombat a szabadnapom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Én hetente kétszer sportolok."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Én soha nem sportolok, de havonta egyszer moziba megyek."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "By evening, Meg is tired."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Este fáradt vagyok, ezért sokáig alszom."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Éjfélkor lefekszem."
    }
  ]
}
