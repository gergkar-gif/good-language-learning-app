{
  "id": "story.a2.unit02",
  "title": "Meg's Schedule",
  "level": "A2",
  "lesson": 5,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Meg",
    "Károly"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly is curious about Meg's weekly schedule."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Milyen a heti beosztásod?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hétfőtől péntekig dolgozom."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Mettől meddig dolgozol?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Kilenctől ötig."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Aztán kedden este hétkor magyarórám van."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "She also has a dentist appointment coming up next week."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Jövő héten van egy időpontom a fogorvosnál."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Mikor?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Október tizedikén, reggel."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly checks whether she's free over the weekend."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Szabad vagy foglalt vagy szombaton?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Szabad vagyok."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Jó. Van egy programom szombaton."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Ez a heti beosztásom: sok, de jó."
    }
  ]
}
