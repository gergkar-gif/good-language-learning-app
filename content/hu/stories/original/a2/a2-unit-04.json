{
  "id": "story.a2.unit04",
  "title": "New People in Meg's Life",
  "level": "A2",
  "lesson": 5,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Meg",
    "Károly"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly asks Meg about her new colleague."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Milyen az új kolléganőd?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Petra nagyon szorgalmas és barátságos."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van egy kolléganőm, aki mindig segít."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg also tells him about the neighbor she's gotten to know."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van egy szomszédom is, Tamás."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Tamás szakállas és szemüveges."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Milyen ember?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Olyan ember, aki nagyon türelmes és vicces."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Károly asks if Petra and Tamás are similar."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Petra és Tamás hasonlóak?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Nem, nagyon különbözőek!"
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg's life in Budapest is full of new people now, not just the core group."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Sok új embert ismerek most."
    }
  ]
}
