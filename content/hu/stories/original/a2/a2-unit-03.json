{
  "id": "story.a2.unit03",
  "title": "Meeting Károly's Parents",
  "level": "A2",
  "lesson": 5,
  "type": "original",
  "estimatedMinutes": 3,
  "characters": [
    "Meg",
    "Károly",
    "Gábor",
    "Ildikó"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Today Meg is meeting Károly's parents, Gábor and Ildikó, for the first time."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Egy kicsit izgulok."
    },
    {
      "type": "dialogue",
      "speaker": "Károly",
      "text": "Az apám és anyám nagyon kedvesek."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They arrive at the house, and Károly introduces her."
    },
    {
      "type": "dialogue",
      "speaker": "Gábor",
      "text": "Szia Meg! Isten hozott!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Köszönöm! Nagyon szép ez a ház."
    },
    {
      "type": "dialogue",
      "speaker": "Ildikó",
      "text": "Köszönjük!"
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg tells them a little about her own family."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "A családom Dél-Afrikában lakik."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Van két húgom is."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Gábor asks whether Meg's family also gets together often, the way theirs does."
    },
    {
      "type": "dialogue",
      "speaker": "Gábor",
      "text": "A családod is gyakran összejön?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Igen, mi is gyakran összejövünk."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "By the end of the visit, Meg doesn't feel nervous anymore."
    },
    {
      "type": "dialogue",
      "speaker": "Ildikó",
      "text": "Nagyon kedves vagy, Meg."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Köszönöm. Most már nem izgulok."
    }
  ]
}
