{
  "id": "grammar.a1.17.a",
  "title": "Age with éves",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Use [number] *éves* *vagyok* to state your age. Éves means “years old” in this construction."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Harminc éves vagyok.",
          "english": "I am thirty years old."
        },
        {
          "spanish": "Hány éves vagy?",
          "english": "How old are you?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}
