{
  "id": "grammar.a1.17.b",
  "title": "Question and answer pattern",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "The basic age exchange is *Hány* *éves* *vagy*? followed by a number + éves *vagyok*."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Hány éves vagy?",
          "english": "How old are you?"
        },
        {
          "spanish": "Huszonöt éves vagyok.",
          "english": "I am twenty-five years old."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}
