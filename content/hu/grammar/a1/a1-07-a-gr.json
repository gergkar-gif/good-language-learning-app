{
  "id": "grammar.a1.07.a",
  "title": "Mikor?",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Use Mikor? to ask when an activity happens."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "hungarian": "Mikor dolgozol?",
          "english": "When do you work?"
        },
        {
          "hungarian": "Mikor tanulsz?",
          "english": "When do you study?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Move into practice quickly. The goal is usable interaction, not memorising a rule."
    }
  ]
}