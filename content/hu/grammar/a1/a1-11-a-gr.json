{
  "id": "grammar.a1.06.a",
  "title": "Personal pronouns",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Use én for I, te for you and ő for he/she."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Én Meg vagyok.",
          "english": "I am Meg."
        },
        {
          "spanish": "Te Károly vagy.",
          "english": "You are Károly."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}