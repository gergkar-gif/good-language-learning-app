{
  "id": "grammar.a1.02.a",
  "title": "Én, te, ő",
  "sections": [
    {
      "type": "text",
      "title": "Three singular pronouns",
      "content": "Hungarian uses én for I, te for you and ő for both he and she."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Én Károly vagyok.",
          "english": "I am Károly."
        },
        {
          "spanish": "Te Meg vagy.",
          "english": "You are Meg."
        },
        {
          "spanish": "Ő Anna.",
          "english": "He / she is Anna."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}