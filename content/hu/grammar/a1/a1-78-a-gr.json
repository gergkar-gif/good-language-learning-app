{
  "id": "grammar.a1.78.a",
  "title": "The days of the week",
  "sections": [
    {
      "type": "text",
      "content": "The Hungarian week starts with hétfő (Monday). Day names are ordinary nouns — unlike English, they are not capitalized."
    },
    {
      "type": "table",
      "title": "hétfő – vasárnap",
      "rows": [
        [
          "hétfő",
          "Monday"
        ],
        [
          "kedd",
          "Tuesday"
        ],
        [
          "szerda",
          "Wednesday"
        ],
        [
          "csütörtök",
          "Thursday"
        ],
        [
          "péntek",
          "Friday"
        ],
        [
          "szombat",
          "Saturday"
        ],
        [
          "vasárnap",
          "Sunday"
        ]
      ]
    },
    {
      "type": "tip",
      "content": "Ma hétfő van. (Today is Monday.) uses the same zero-copula pattern you already know: no van is needed just to name the day — 'Ma hétfő.' works fine too."
    }
  ]
}
