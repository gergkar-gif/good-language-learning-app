{
  "id": "grammar.a1.78.a",
  "title": "The seven days",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Hungarian starts the week with Monday. To ask the day, say *Milyen nap van ma?* and answer *Ma kedd van.* *Nap* means “day”."
    },
    {
      "type": "table",
      "title": "The days of the week",
      "rows": [
        [
          "hétfő",
          "Monday"
        ],
        [
          "kedd",
          "Tuesday"
        ],
        [
          "szerda",
          "Wednesday"
        ],
        [
          "csütörtök",
          "Thursday"
        ],
        [
          "péntek",
          "Friday"
        ],
        [
          "szombat",
          "Saturday"
        ],
        [
          "vasárnap",
          "Sunday"
        ]
      ]
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Milyen nap van ma?",
          "english": "What day is it today?"
        },
        {
          "spanish": "Ma szerda van.",
          "english": "Today is Wednesday."
        },
        {
          "spanish": "Ma hétfő van?",
          "english": "Is it Monday today?"
        },
        {
          "spanish": "Nem, ma kedd van.",
          "english": "No, today is Tuesday."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Days are written with a small letter in Hungarian: *hétfő*, *szombat*. A capital letter only starts a sentence."
    }
  ]
}
