{
  "id": "grammar.a1.03.a",
  "title": "Ki? and Mi?",
  "sections": [
    {
      "type": "text",
      "title": "Who and what",
      "content": "Use ki? when asking about a person and mi? when asking about a thing."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Ki ő?",
          "english": "Who is he / she?"
        },
        {
          "spanish": "Mi ez?",
          "english": "What is this?"
        },
        {
          "spanish": "Mi az?",
          "english": "What is that?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}