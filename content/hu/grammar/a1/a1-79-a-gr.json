{
  "id": "grammar.a1.79.a",
  "title": "The twelve months",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Here are the twelve months. Many look like the English names. To say which month it is, use *Most június van.* “It is June now.”"
    },
    {
      "type": "table",
      "title": "The months",
      "rows": [
        [
          "január",
          "January"
        ],
        [
          "február",
          "February"
        ],
        [
          "március",
          "March"
        ],
        [
          "április",
          "April"
        ],
        [
          "május",
          "May"
        ],
        [
          "június",
          "June"
        ],
        [
          "július",
          "July"
        ],
        [
          "augusztus",
          "August"
        ],
        [
          "szeptember",
          "September"
        ],
        [
          "október",
          "October"
        ],
        [
          "november",
          "November"
        ],
        [
          "december",
          "December"
        ]
      ]
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Most január van.",
          "english": "It is January now."
        },
        {
          "spanish": "Most május van?",
          "english": "Is it May now?"
        },
        {
          "spanish": "Nem április, hanem március van.",
          "english": "It is not April but March."
        },
        {
          "spanish": "Most október van.",
          "english": "It is October now."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Months are written with a small letter, like the days. Watch the spelling: *március*, *május* and *július* end in *-us*, and *szeptember* begins with *sz-*."
    }
  ]
}
