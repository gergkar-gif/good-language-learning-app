{
  "id": "grammar.a1.18.a",
  "title": "Hol? and living",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "*Hol*? asks where. For this unit, use *lakom* to say where you live."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Hol laksz?",
          "english": "Where do you live?"
        },
        {
          "spanish": "Budapesten lakom.",
          "english": "I live in Budapest."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}
