{
  "id": "grammar.a1.09.b",
  "title": "Short personal questions",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Ki *vagy*? asks who you are. *Hol* *laksz*? asks where you live."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Ki vagy?",
          "english": "Who are you?"
        },
        {
          "spanish": "Hol laksz?",
          "english": "Where do you live?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}
