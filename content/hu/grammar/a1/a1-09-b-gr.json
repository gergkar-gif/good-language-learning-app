{
  "id": "grammar.a1.09.b",
  "title": "Early and late",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Use korán for early and későn for late."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "hungarian": "Korán felkelek.",
          "english": "I get up early."
        },
        {
          "hungarian": "Néha későn jövök.",
          "english": "Sometimes I come late."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Move into practice quickly. The goal is usable interaction, not memorising a rule."
    }
  ]
}