{
  "id": "grammar.a1.19.a",
  "title": "Personal-information questions",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Mi a... ? asks for information identified by a noun: Mi a címed? Mi a telefonszámod?"
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Mi a címed?",
          "english": "What is your address?"
        },
        {
          "spanish": "Mi a telefonszámod?",
          "english": "What is your phone number?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}