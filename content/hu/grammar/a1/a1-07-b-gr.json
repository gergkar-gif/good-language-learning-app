{
  "id": "grammar.a1.07.b",
  "title": "Clock time with -kor",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "For the simple hours in this unit, add -kor to the hour: hétkor, nyolckor."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "hungarian": "Hétkor felkelek.",
          "english": "I get up at seven."
        },
        {
          "hungarian": "Nyolckor dolgozom.",
          "english": "I work at eight."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Move into practice quickly. The goal is usable interaction, not memorising a rule."
    }
  ]
}