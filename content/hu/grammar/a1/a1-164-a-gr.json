{
  "id": "grammar.a1.164.a",
  "title": "Before and After in Time: Előtt vs Után",
  "sections": [
    {
      "type": "text",
      "content": "Just as *előtt* means 'in front of' spatially, it also means **before** in time. Pair it with events or clock hours:\n- *hét óra előtt* = before 7 o'clock\n- *vacsora előtt* = before dinner\n- *az utazás előtt* = before the journey\n- *munka után* = after work"
    },
    {
      "type": "table",
      "title": "Temporal Pair: előtt vs után",
      "rows": [
        [
          "öt óra előtt",
          "before five o'clock"
        ],
        [
          "öt óra után",
          "after five o'clock"
        ],
        [
          "ebéd előtt",
          "before lunch"
        ],
        [
          "ebéd után",
          "after lunch"
        ],
        [
          "az óra előtt",
          "before class"
        ],
        [
          "az óra után",
          "after class"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Vacsora előtt sétálunk egyet.",
          "english": "Before dinner, we take a short walk."
        },
        {
          "spanish": "Nyolc óra után hívj fel!",
          "english": "Call me after eight o'clock!"
        }
      ]
    }
  ]
}