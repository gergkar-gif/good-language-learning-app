{
  "id": "grammar.a1.07.a",
  "title": "Ki? and Mi?",
  "sections": [
    {
      "type": "text",
      "title": "Explanation",
      "content": "Ki? asks who. Mi? asks what. Use Ki ő? to identify a person."
    },
    {
      "type": "examples",
      "title": "Examples",
      "items": [
        {
          "spanish": "Ki ő?",
          "english": "Who is he/she?"
        },
        {
          "spanish": "Mi ez?",
          "english": "What is this?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the explanation short and move quickly into practice."
    }
  ]
}