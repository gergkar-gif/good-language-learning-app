{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test.schema.json",
  "title": "Level test",
  "description": "The check at the end of a level. Multi-modal CEFR assessment covering Language in Context (cloze, text-input, communicative choice) and optional written/spoken productive tasks.",
  "type": "object",
  "required": [
    "id",
    "level",
    "passMark",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^test\\.(a1|a2|b1|b2|c1)$",
      "examples": [
        "test.a1"
      ]
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "passMark": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 1,
      "description": "Fraction correct needed to pass. 0.8 across A1-C1."
    },
    "questions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 40,
      "items": {
        "$ref": "#/definitions/question"
      }
    },
    "writingTask": {
      "type": "object",
      "required": [
        "id",
        "title",
        "prompt",
        "minWords",
        "targetKeywords",
        "teaches"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string"
        },
        "minWords": {
          "type": "integer",
          "minimum": 10
        },
        "targetKeywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "teaches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    },
    "speakingTask": {
      "type": "object",
      "required": [
        "id",
        "title",
        "prompt",
        "targetKeywords",
        "teaches"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "targetKeywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minSeconds": {
          "type": "integer",
          "minimum": 5
        },
        "teaches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    }
  },
  "definitions": {
    "question": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "sentence",
            "options",
            "correct",
            "teaches"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "type": {
              "enum": [
                "dropdown"
              ]
            },
            "sentence": {
              "type": "string",
              "pattern": "_{3,}"
            },
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "correct": {
              "type": "integer",
              "minimum": 0
            },
            "teaches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "sentence",
            "answer",
            "teaches"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "type": {
              "const": "text-input"
            },
            "sentence": {
              "type": "string",
              "pattern": "_{3,}"
            },
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "altAnswers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "teaches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "prompt",
            "options",
            "correct",
            "teaches"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "type": {
              "const": "choice"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "correct": {
              "type": "integer",
              "minimum": 0
            },
            "teaches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            }
          }
        }
      ]
    }
  }
}
