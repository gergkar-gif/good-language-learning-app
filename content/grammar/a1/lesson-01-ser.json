{
  "id": "grammar.a1.01.ser",
  "title": "Greetings & Introductions",
  "sections": [
    {
      "type": "text",
      "title": "Greetings",
      "content": "Use these expressions when meeting someone for the first time."
    },
    {
      "type": "table",
      "rows": [
        ["Hola.", "Hello."],
        ["Buenos días.", "Good morning."],
        ["Buenas tardes.", "Good afternoon."],
        ["Buenas noches.", "Good evening / Good night."],
        ["Adiós.", "Goodbye."],
        ["Hasta luego.", "See you later."]
      ]
    },
    {
      "type": "text",
      "title": "Introducing Yourself",
      "content": "Use the verb 'ser' to say who you are and where you are from."
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Soy Carlos.",
          "english": "I am Carlos."
        },
        {
          "spanish": "Soy de Hungría.",
          "english": "I am from Hungary."
        },
        {
          "spanish": "Soy de Sudáfrica.",
          "english": "I am from South Africa."
        },
        {
          "spanish": "¿Cómo te llamas?",
          "english": "What's your name?"
        },
        {
          "spanish": "Me llamo Meg.",
          "english": "My name is Meg."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Spanish usually omits the subject pronoun. Instead of 'Yo soy Carlos.', speakers normally say 'Soy Carlos.'"
    },
    {
      "type": "external-link",
      "title": "Lingolia",
      "url": "https://espanol.lingolia.com/en/grammar/verbs/ser-estar"
    }
  ]
}