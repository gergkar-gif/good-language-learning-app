  "writingTask": {
    "id": "es-a1-writing",
    "title": "Un día en mi vida",
    "prompt": "Escribe un texto breve (30–50 palabras) describiendo tu rutina diaria y qué te gusta hacer en tu tiempo libre.",
    "context": "Escribe para el foro de la comunidad de estudiantes de idiomas.",
    "minWords": 30,
    "targetKeywords": [
