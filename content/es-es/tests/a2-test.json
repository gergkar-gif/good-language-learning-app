  "writingTask": {
    "id": "es-a2-writing",
    "title": "Un fin de semana inolvidable",
    "prompt": "Escribe un correo electrónico a un amigo (45–70 palabras) describiendo una excursión o viaje reciente. Explica qué tiempo hacía, qué hacías cuando ocurrió algo interesante y qué le recomiendas si visita ese lugar.",
    "context": "Combina pretérito imperfecto e indefinido y da al menos un consejo con imperativo o condicional.",
    "minWords": 45,
    "targetKeywords": [
      "cuando",
      "mientras",
      "era",
      "decidí",
      "recomiendo"
    ],
    "teaches": [
      "narrative-tenses",
      "imperfecto-vs-indefinido",
      "advice",
      "connectors"
    ]
  },
  "speakingTask": {
    "id": "es-a2-speaking",
    "title": "Mensaje de voz con recomendaciones",
    "prompt": "Graba un mensaje de voz (30–45 segundos) para un amigo que va a visitar tu ciudad: salúdalo, dale 2 consejos prácticos (qué debe hacer y qué no debe hacer) y proponle un plan para verse.",
    "minSeconds": 20,
    "targetKeywords": [
      "deberías",
      "no te preocupes",
      "si quieres",
      "visita"
    ],
