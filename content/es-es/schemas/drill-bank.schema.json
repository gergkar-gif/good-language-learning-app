{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "drill-bank.schema.json",
  "title": "Drill bank file",
  "description": "A standalone, skill-organised bank of practice items for Workshop drillers — not tied to any single lesson, unlike content/es/exercises. `modules` is the browsable skill catalogue (id, title, item count); every item in `items` belongs to exactly one module by id.",
  "type": "object",
  "required": ["title", "version", "variant", "exercise_count", "modules", "items"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "variant": {
      "type": "string",
      "description": "Regional dialect this bank was written for.",
      "examples": ["es-LATAM"]
    },
    "exercise_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Must equal items.length."
    },
    "design_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "exercise_count"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
            "description": "Skill slug, snake_case. Not the same vocabulary as an exercise file's `teaches` tags (kebab-case) — Workshop's grammar index normalises underscores to hyphens when matching the two."
          },
          "title": { "type": "string", "minLength": 1 },
          "exercise_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Must equal the number of items whose module equals this id."
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "level", "variant", "module", "type", "prompt", "options", "answer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1"]
        },
        "variant": { "type": "string", "minLength": 1 },
        "module": {
          "type": "string",
          "description": "Must match a modules[].id in this file."
        },
        "type": {
          "type": "string",
          "enum": ["multiple_choice"],
          "description": "Only multiple_choice exists today; more may be added as the bank grows."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "The Spanish sentence with a blank, usually written as ___."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "Must be one of the strings in options, verbatim."
        },
        "explanation": {
          "type": "string",
          "description": "Shown after the learner answers, right or wrong — why the answer is correct."
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
