{
  "id": "lesson.c1.02.05",
  "title": "Double Participles in Formal Writing",
  "level": "C1",
  "goal": "Choose between imprimido and impreso, freído and frito, proveído and provisto, and read a column on style doubts.",
  "grammar": "double participles in formal writing",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can pick the right participle when it describes a noun (*pescado frito*, *un texto impreso*).",
        "I can use either participle after *haber* with *imprimir*, *freír* and *proveer*.",
        "I can read a style-guide column and pick out its answers to readers’ doubts."
      ]
