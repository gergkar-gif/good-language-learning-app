{
  "id": "lesson.c1.01.03",
  "title": "Compact Style: Noun Phrases",
  "level": "C1",
  "goal": "Write compactly by turning verb clauses into noun phrases, and know when to stop.",
  "grammar": "dense nominal style in academic prose",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can turn a verb clause into a noun phrase that works as the subject.",
        "I can describe a result or a method with nouns like *validez*, *fiabilidad* and *alcance*.",
        "I can say how one thing affects another with *incidir en*."
      ]
