{
  "id": "lesson.c1.23.02",
  "title": "Figurative Prepositional Verbs",
  "level": "C1",
  "goal": "Extend prepositional verbs to figurative idioms whose preposition shifts the verb's core meaning.",
  "grammar": "verbos-regimen-preposicional",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can use figurative prepositional verbs such as *dar con*, *caer en la cuenta* and *cargar con* accurately.",
        "I can recognise how a fixed preposition shifts an everyday verb into a figurative idiom.",
        "I can avoid swapping prepositions in fixed verbal expressions."
      ]
    },
