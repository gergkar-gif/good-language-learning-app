{
  "id": "lesson.c1.21.02",
  "title": "Understatement and Overstatement in Irony",
  "level": "C1",
  "goal": "Use everyday understatement and overstatement expressions to convey dry irony",
  "grammar": "c1-irony-humour-vocab",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can convey dry irony through understatement with *no está mal* and *un poquito*.",
        "I can heighten an ironic contrast with *nada menos que*, *para colmo* and *la hazaña*.",
        "I can clarify humorous intent with *en broma* and recognise *la exageración* in speech."
