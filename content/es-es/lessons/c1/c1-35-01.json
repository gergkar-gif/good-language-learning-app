  "title": "Audience Address & Formal Courtesy",
  "level": "C1",
  "goal": "Address a live audience with formal vocatives, courteous *ustedes* imperatives and consistent pronouns.",
  "grammar": "sociolinguistica-tratamiento-cortesia",
