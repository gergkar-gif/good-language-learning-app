{
  "id": "lesson.c1.23.05",
  "title": "Figurative Gerunds in Storytelling",
  "level": "C1",
  "goal": "Use figurative gerunds to convey stance and manner in narrative, and read an original short story rich in idioms.",
  "grammar": "gerundio-acciones-paralelas",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can use figurative gerunds such as *esquivando*, *fingiendo* and *haciendo la vista gorda* to show attitude.",
        "I can avoid the *gerundio de posterioridad* when describing two sequential events.",
        "I can interpret everyday idioms, figurative comparisons and fronting in a short story."
      ]
