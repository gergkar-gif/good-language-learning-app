{
  "id": "grammar.a1.07.02.articles-hay",
  "title": "Articles + hay",
  "sections": [
    {
      "type": "text",
      "title": "Talking about things in the house",
      "content": "You know the indefinite articles *un*, *una*, *unos* and *unas* from Unit 3. Use them after *hay* when you introduce an unspecified thing, and make the article agree with the noun."
    },
    {
      "type": "table",
      "title": "Articles with hay",
      "rows": [
        [
          "masculine singular",
          "un"
        ],
        [
          "feminine singular",
          "una"
        ],
        [
          "masculine plural",
          "unos"
        ],
        [
          "feminine plural",
          "unas"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Hay un sofá.",
          "english": "There is a sofa."
        },
        {
          "spanish": "Hay una mesa.",
          "english": "There is a table."
        },
        {
          "spanish": "Hay unos libros.",
          "english": "There are some books."
        },
        {
          "spanish": "Hay unas sillas.",
          "english": "There are some chairs."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The article agrees with the noun: un *sofá*, una *mesa*, unos *libros*, unas *sillas*."
    }
  ]
}
