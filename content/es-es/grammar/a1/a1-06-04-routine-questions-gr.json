{
  "id": "grammar.a1.06.04.routine-questions",
  "title": "Present-tense questions",
  "sections": [
    {
      "type": "text",
      "title": "Ask about routines",
      "content": "Use ¿*Qué haces*? to ask what someone does and ¿*Cuándo* ...? to ask when an action happens. The verb changes according to the person you are asking about."
    },
    {
      "type": "table",
      "title": "Useful questions",
      "rows": [
        [
          "¿Qué haces?",
          "What do you do?"
        ],
        [
          "¿Cuándo trabajas?",
          "When do you work?"
        ],
        [
          "¿Cuándo estudias?",
          "When do you study?"
        ],
        [
          "¿Qué comes?",
          "What do you eat?"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¿Qué haces por la mañana?",
          "english": "What do you do in the morning?"
        },
        {
          "spanish": "¿Cuándo trabajas?",
          "english": "When do you work?"
        },
        {
          "spanish": "¿Qué comes en casa?",
          "english": "What do you eat at home?"
        },
        {
          "spanish": "¿Cuándo estudias español?",
          "english": "When do you study Spanish?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Question words such as *qué* and *cuándo* normally come at the start of the question."
    }
  ]
}
