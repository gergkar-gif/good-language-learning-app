{
  "id": "grammar.a1.18.01.gustar",
  "title": "Gustar Construction",
  "sections": [
    {
      "type": "text",
      "title": "Indirect Object Pronouns with Gustar",
      "content": "Verbs like *gustar* use **INDIRECT object pronouns** (*me, te, le, nos, les*). The verb agrees with what is liked (the subject of the Spanish sentence)."
    },
    {
      "type": "table",
      "title": "Gustar with singular vs plural",
      "rows": [
        [
          "A mí *me gusta* el fútbol",
          "I like football (singular)"
        ],
        [
          "A mí *me gustan* los deportes",
          "I like sports (plural)"
        ],
        [
          "A ti *te encanta* la música",
          "You love music"
        ],
        [
          "A ella *le interesan* los libros",
          "She is interested in books"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Nos gusta la comida mexicana.",
          "english": "We like Mexican food."
        },
        {
          "spanish": "A Carlos le gustan los gatos.",
          "english": "Carlos likes cats."
        }
      ]
    }
  ]
}
