  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg is sitting on the terrace reading a magazine when she decides to call Carlos."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "¡Hola, Meg! ¿Cómo estás?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¡Hola! Muy bien. Te llamo porque tengo una duda con la tarea. ¿Estás ocupado ahora mismo?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "No, en este momento estoy cocinando la cena y escuchando las noticias en español."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg smiles as she hears sizzling sounds in the background."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¿Qué estás preparando para cenar?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Estoy salteando verduras con arroz. Y tú, ¿qué estás haciendo en tu casa?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Estoy descansando en la terraza, escribiendo mensajes y leyendo un artículo de viaje."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "¡Qué relajante! Termino de cocinar y te llamo para revisar la tarea juntos."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Perfecto, Carlos. ¡Buen provecho con la cena!"
    }
  ],
