  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Carlos returns home on Monday evening after finishing his first full day at his new office."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¡Hola, Carlos! ¿Cómo fue tu primer día de trabajo en la oficina?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "¡Muy interesante! Mi horario empieza temprano por la mañana, pero el equipo es excelente."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¿Qué profesiones tienen tus nuevos compañeros de trabajo?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "En mi departamento hay un ingeniero, dos periodistas y una traductora. Mi jefa es muy organizada."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Carlos shows Meg a folder of project guidelines and schedules."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Mañana tengo que preparar un informe importante y asistir a una reunión a las diez."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Es una gran responsabilidad, pero eres muy trabajador y lo vas a hacer genial."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Muchas gracias, Meg. Ahora toca descansar para empezar con energía mañana."
    }
  ],
