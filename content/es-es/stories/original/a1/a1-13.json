  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Meg and Carlos are waiting at a street corner café when Meg's phone rings."
    },
    {
      "type": "dialogue",
      "speaker": "Kaylee",
      "text": "¡Hola, Meg! Estoy perdida en el barrio antiguo. ¿Dónde está la cafetería?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "No te preocupes, Kaylee. ¿Dónde estás ahora mismo?"
    },
    {
      "type": "dialogue",
      "speaker": "Kaylee",
      "text": "Estoy delante de una tienda de ropa y veo un semáforo en la esquina."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "Carlos takes the phone to guide her through the nearby streets."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Kaylee, cruza el semáforo y sigue todo recto por esa calle durante dos minutos."
    },
    {
      "type": "dialogue",
      "speaker": "Kaylee",
      "text": "¿Y luego? ¿Giro a la derecha o a la izquierda?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Gira a la derecha en la primera esquina. Vas a ver una farmacia y nuestro café al lado."
    },
    {
      "type": "dialogue",
      "speaker": "Kaylee",
      "text": "¡Ya veo el letrero verde! Ya estoy llegando. ¡Muchas gracias, Carlos!"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "De nada, Kaylee. ¡Aquí te esperamos!"
    }
  ],
