{
  "id": "story.a1.01",
  "title": "Carlos conoce a Meg",
  "level": "A1",
  "category": "original",
  "lesson": 1,
  "estimatedMinutes": 2,
  "characters": [
    "Carlos",
    "Meg"
  ],
  "paragraphs": [
    {
      "type": "narration",
      "text": "Carlos vive en Hanói. Hoy va a un restaurante mexicano para practicar español."
    },
    {
      "type": "narration",
      "text": "En el restaurante hay una fiesta de tacos y un intercambio de idiomas."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hola."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Hola."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Me llamo Meg. ¿Cómo te llamas?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Me llamo Carlos."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Mucho gusto."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Mucho gusto."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¿De dónde eres?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Soy de Hungría. ¿Y tú?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Soy de Sudáfrica."
    },
    {
      "type": "narration",
      "text": "Carlos y Meg hablan un poco. Los dos estudian español."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Adiós."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Hasta luego."
    },
    {
      "type": "narration",
      "text": "Es el comienzo de una nueva amistad."
    }
  ]
}