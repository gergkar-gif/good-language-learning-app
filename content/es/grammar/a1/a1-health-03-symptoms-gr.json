{
  "id": "grammar.a1.health.03.symptoms",
  "title": "Tener + symptoms",
  "sections": [
    {
      "type": "text",
      "title": "Describe common symptoms",
      "content": "Use tener expressions to say which symptoms you have. Keep the expression with tener in the first person when describing yourself."
    },
    {
      "type": "table",
      "title": "Symptoms",
      "rows": [
        [
          "I have a headache.",
          "Tengo dolor de cabeza."
        ],
        [
          "I have a cough.",
          "Tengo tos."
        ],
        [
          "I have a fever.",
          "Tengo fiebre."
        ],
        [
          "I have a sore throat.",
          "Tengo dolor de garganta."
        ],
        [
          "I have a stomachache.",
          "Tengo dolor de estómago."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Tengo fiebre y tos.",
          "english": "I have a fever and a cough."
        },
        {
          "spanish": "Tengo dolor de cabeza.",
          "english": "I have a headache."
        },
        {
          "spanish": "Tengo dolor de garganta y tos.",
          "english": "I have a sore throat and a cough."
        }
      ]
    },
    {
      "type": "tip",
      "content": "You can connect two symptoms with y: Tengo fiebre y tos."
    }
  ]
}
