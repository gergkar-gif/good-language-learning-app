{
  "id": "grammar.a1.07.01.hay",
  "title": "Hay",
  "sections": [
    {
      "type": "text",
      "title": "There is / there are",
      "content": "Use *hay* to say that something exists or is present. *Hay* works for both singular and plural nouns."
    },
    {
      "type": "table",
      "title": "Hay",
      "rows": [
        [
          "singular",
          "Hay una cocina."
        ],
        [
          "plural",
          "Hay dos habitaciones."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Hay una cocina.",
          "english": "There is a kitchen."
        },
        {
          "spanish": "Hay dos habitaciones.",
          "english": "There are two rooms."
        },
        {
          "spanish": "Hay un baño.",
          "english": "There is a bathroom."
        },
        {
          "spanish": "Hay tres ventanas.",
          "english": "There are three windows."
        }
      ]
    },
    {
      "type": "tip",
      "content": "*Hay* does not change for singular and plural: *hay* una habitación, *hay* *tres* habitaciones."
    }
  ]
}
