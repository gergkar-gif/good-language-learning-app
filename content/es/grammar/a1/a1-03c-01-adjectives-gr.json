{
  "id": "grammar.a1.03c.01.adjectives",
  "title": "What Is Someone Like?",
  "sections": [
    {
      "type": "text",
      "title": "Ser + adjective",
      "content": "Use ser + an adjective to describe a person's characteristics. The adjective normally follows ser. At this stage, focus on the pattern person + ser + adjective."
    },
    {
      "type": "table",
      "title": "Ser in simple descriptions",
      "rows": [
        [
          "soy + adjective",
          "Yo soy alto."
        ],
        [
          "eres + adjective",
          "Tú eres simpática."
        ],
        [
          "es + adjective",
          "Ana es joven."
        ],
        [
          "son + adjective",
          "Carlos y Ana son altos."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Carlos es alto.",
          "english": "Carlos is tall."
        },
        {
          "spanish": "Ana es joven.",
          "english": "Ana is young."
        },
        {
          "spanish": "Meg es simpática.",
          "english": "Meg is friendly."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The adjective agrees with the person it describes. Gender and plural agreement are the focus of the next lessons. For further reference, see Lingolia's Spanish adjective reference."
    }
  ]
}