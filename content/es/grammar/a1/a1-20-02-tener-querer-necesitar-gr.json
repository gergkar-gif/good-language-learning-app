{
  "id": "grammar.a1.20.02.tener-querer-necesitar",
  "title": "Tener, querer and necesitar",
  "sections": [
    {
      "type": "text",
      "title": "Talk about travel essentials",
      "content": "Use tener, querer and necesitar to say what you have, what you want and what you need."
    },
    {
      "type": "table",
      "title": "Travel essentials",
      "rows": [
        [
          "I have a ticket.",
          "Tengo un billete."
        ],
        [
          "I want a ticket.",
          "Quiero un billete."
        ],
        [
          "I need a bag.",
          "Necesito una bolsa."
        ],
        [
          "I need water.",
          "Necesito agua."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Tengo un billete.",
          "english": "I have a ticket."
        },
        {
          "spanish": "Quiero una maleta.",
          "english": "I want a suitcase."
        },
        {
          "spanish": "Necesito agua.",
          "english": "I need water."
        }
      ]
    },
    {
      "type": "tip",
      "content": "These verbs express different ideas: tener = have, querer = want, necesitar = need."
    }
  ]
}
