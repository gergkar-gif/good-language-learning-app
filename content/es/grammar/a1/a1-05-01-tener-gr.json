{
  "id": "grammar.a1.05.01.tener",
  "title": "Tener",
  "sections": [
    {
      "type": "text",
      "title": "Tener means \"to have\"",
      "content": "Use tener to say what someone has. The verb changes with the subject: tengo, tienes, tiene, tenemos, tienen."
    },
    {
      "type": "table",
      "title": "Tener",
      "rows": [
        [
          "yo",
          "tengo"
        ],
        [
          "tú",
          "tienes"
        ],
        [
          "él / ella / usted",
          "tiene"
        ],
        [
          "nosotros / nosotras",
          "tenemos"
        ],
        [
          "ellos / ellas / ustedes",
          "tienen"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Tengo una hermana.",
          "english": "I have a sister."
        },
        {
          "spanish": "¿Tienes un hermano?",
          "english": "Do you have a brother?"
        },
        {
          "spanish": "Ana tiene dos hijos.",
          "english": "Ana has two children."
        },
        {
          "spanish": "Tenemos una familia grande.",
          "english": "We have a big family."
        }
      ]
    },
    {
      "type": "tip",
      "content": "For family relationships, tener is followed directly by the noun: Tengo *dos* hermanos."
    }
  ]
}
