{
  "id": "grammar.a1.03.04.adjectives",
  "title": "Adjective agreement",
  "sections": [
    {
      "type": "text",
      "title": "Describing people",
      "content": "Many common adjectives change their ending to agree with the person or noun they describe. Masculine singular commonly ends in -o and feminine singular in -a. Plural forms add -s."
    },
    {
      "type": "table",
      "title": "Agreement patterns",
      "rows": [
        [
          "un chico alto",
          "a tall boy"
        ],
        [
          "una chica alta",
          "a tall girl"
        ],
        [
          "unos chicos altos",
          "some tall boys"
        ],
        [
          "unas chicas altas",
          "some tall girls"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Carlos es alto.",
          "english": "Carlos is tall."
        },
        {
          "spanish": "Meg es alta.",
          "english": "Meg is tall."
        },
        {
          "spanish": "Carlos y Meg son simpáticos.",
          "english": "Carlos and Meg are friendly."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The adjective agrees with the person being described, not with the speaker."
    }
  ]
}
