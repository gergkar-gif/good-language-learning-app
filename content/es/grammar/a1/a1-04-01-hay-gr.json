{
  "id": "grammar.a1.04.01.hay",
  "title": "Hay",
  "sections": [
    {
      "type": "text",
      "title": "Saying what exists",
      "content": "Use *hay* to say that a person, place or thing exists or is present. Hay works with both singular and plural nouns."
    },
    {
      "type": "table",
      "title": "Hay with singular and plural",
      "rows": [
        [
          "Hay un parque.",
          "There is a park."
        ],
        [
          "Hay una farmacia.",
          "There is a pharmacy."
        ],
        [
          "Hay dos bancos.",
          "There are two banks."
        ],
        [
          "Hay muchas tiendas.",
          "There are many shops."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Hay un hotel.",
          "english": "There is a hotel."
        },
        {
          "spanish": "Hay una cafetería.",
          "english": "There is a café."
        },
        {
          "spanish": "Hay tres tiendas.",
          "english": "There are three shops."
        }
      ]
    },
    {
      "type": "tip",
      "content": "*Hay* does not change between singular and plural. The noun or number tells you whether you mean one or more."
    }
  ]
}
