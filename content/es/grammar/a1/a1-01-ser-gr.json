{
  "id": "grammar.a1.01.ser",
  "title": "Introducing Yourself",
  "sections": [
    {
      "type": "text",
      "title": "Introducing Yourself",
      "content": "Use the verb 'ser' to say who you are and where you are from."
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Soy Carlos.",
          "english": "I am Carlos."
        },
        {
          "spanish": "Soy de Hungría.",
          "english": "I am from Hungary."
        },
        {
          "spanish": "Soy de Sudáfrica.",
          "english": "I am from South Africa."
        },
        {
          "spanish": "¿Cómo te llamas?",
          "english": "What's your name?"
        },
        {
          "spanish": "Me llamo Meg.",
          "english": "My name is Meg."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Spanish usually omits the subject pronoun. Instead of 'Yo soy Carlos.', speakers normally say 'Soy Carlos.'"
    }
  ]
}
