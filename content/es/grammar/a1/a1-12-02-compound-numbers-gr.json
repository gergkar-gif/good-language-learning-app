{
  "id": "grammar.a1.12.02.compound-numbers",
  "title": "Compound numbers",
  "sections": [
    {
      "type": "text",
      "title": "Count to 100",
      "content": "From 21 to 29, Spanish uses veinti- plus the unit. From 30 onwards, use tens + y + unit."
    },
    {
      "type": "table",
      "title": "Useful number patterns",
      "rows": [
        [
          "21",
          "veintiuno"
        ],
        [
          "22",
          "veintidós"
        ],
        [
          "25",
          "veinticinco"
        ],
        [
          "30",
          "treinta"
        ],
        [
          "31",
          "treinta y uno"
        ],
        [
          "40",
          "cuarenta"
        ],
        [
          "50",
          "cincuenta"
        ],
        [
          "60",
          "sesenta"
        ],
        [
          "70",
          "setenta"
        ],
        [
          "80",
          "ochenta"
        ],
        [
          "90",
          "noventa"
        ],
        [
          "100",
          "cien"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Tengo treinta y uno años.",
          "english": "I am thirty-one years old."
        },
        {
          "spanish": "Hay cincuenta personas.",
          "english": "There are fifty people."
        },
        {
          "spanish": "La clase tiene veinticinco estudiantes.",
          "english": "The class has twenty-five students."
        }
      ]
    },
    {
      "type": "tip",
      "content": "For 31–99, join the tens and units with y: treinta y dos, cuarenta y cinco, noventa y nueve."
    }
  ]
}
