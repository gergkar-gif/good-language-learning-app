          "Rest.",
          "Descansa."
        ],
        [
          "Drink water.",
          "Toma agua."
        ],
        [
          "Eat something.",
          "Come algo."
        ],
        [
          "Sleep.",
          "Duerme."
        ],
        [
          "Go to the doctor.",
          "Ve al médico."
        ]
      ]
    },
