{
  "id": "grammar.a1.weather.02.weather-conditions",
  "title": "Hot, cold and rainy",
  "sections": [
    {
      "type": "text",
      "title": "Describe different conditions",
      "content": "Use familiar weather expressions to say whether it is hot, cold, rainy, sunny, windy or cloudy."
    },
    {
      "type": "table",
      "title": "Common conditions",
      "rows": [
        [
          "hot",
          "hace calor"
        ],
        [
          "cold",
          "hace frío"
        ],
        [
          "rainy / it is raining",
          "llueve"
        ],
        [
          "sunny",
          "hace sol"
        ],
        [
          "windy",
          "hace viento"
        ],
        [
          "cloudy",
          "está nublado"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Hoy hace calor.",
          "english": "Today it is hot."
        },
        {
          "spanish": "Hoy llueve.",
          "english": "Today it is raining."
        },
        {
          "spanish": "Hace viento.",
          "english": "It is windy."
        },
        {
          "spanish": "Está nublado.",
          "english": "It is cloudy."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Weather expressions often use different structures. Learn the complete phrase: hace calor, hace frío, hace sol, hace viento, llueve, está nublado."
    }
  ]
}
