{
  "id": "grammar.a1.health.02.tener-expressions",
  "title": "Tener expressions",
  "sections": [
    {
      "type": "text",
      "title": "Say what is wrong",
      "content": "Many common health problems are expressed with tener + noun. Use the whole expression rather than translating it word for word."
    },
    {
      "type": "table",
      "title": "Common tener expressions",
      "rows": [
        [
          "I have a headache.",
          "Tengo dolor de cabeza."
        ],
        [
          "I have a stomachache.",
          "Tengo dolor de estómago."
        ],
        [
          "I have a sore throat.",
          "Tengo dolor de garganta."
        ],
        [
          "I have a fever.",
          "Tengo fiebre."
        ],
        [
          "I have a cough.",
          "Tengo tos."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Tengo dolor de cabeza.",
          "english": "I have a headache."
        },
        {
          "spanish": "Tengo dolor de garganta.",
          "english": "I have a sore throat."
        },
        {
          "spanish": "Tengo tos.",
          "english": "I have a cough."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Health expressions often use tener: tengo fiebre, tengo tos, tengo dolor de cabeza."
    }
  ]
}
