{
  "id": "grammar.a1.01.greetings",
  "title": "Greetings",
  "sections": [
    {
      "type": "text",
      "title": "Greetings",
      "content": "Use these expressions when meeting someone for the first time."
    },
    {
      "type": "table",
      "rows": [
        ["Hola.", "Hello."],
        ["Buenos días.", "Good morning."],
        ["Buenas tardes.", "Good afternoon."],
        ["Buenas noches.", "Good evening / Good night."],
        ["Adiós.", "Goodbye."],
        ["Hasta luego.", "See you later."]
      ]
    }
  ]
}
