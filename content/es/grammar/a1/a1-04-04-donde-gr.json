{
  "id": "grammar.a1.04.04.donde",
  "title": "¿Dónde...?",
  "sections": [
    {
      "type": "text",
      "title": "Asking where",
      "content": "Use ¿Dónde...? to ask where a person or thing is. Answer with está or están plus a location."
    },
    {
      "type": "table",
      "title": "Question and answer",
      "rows": [
        [
          "¿Dónde está el banco?",
          "Where is the bank?"
        ],
        [
          "Está cerca.",
          "It is nearby."
        ],
        [
          "¿Dónde está la farmacia?",
          "Where is the pharmacy?"
        ],
        [
          "Está a la derecha.",
          "It is on the right."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¿Dónde está la biblioteca?",
          "english": "Where is the library?"
        },
        {
          "spanish": "La biblioteca está a la izquierda.",
          "english": "The library is on the left."
        },
        {
          "spanish": "¿Dónde están los restaurantes?",
          "english": "Where are the restaurants?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Match está with one thing and están with more than one."
    }
  ]
}
