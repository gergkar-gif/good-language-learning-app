  "title": "Time + present tense",
  "sections": [
    {
      "type": "text",
      "title": "Talk about a daily schedule",
      "content": "Combine time expressions with familiar present-tense verbs to say when daily activities happen."
    },
    {
      "type": "table",
      "title": "Schedule patterns",
      "rows": [
        [
          "I work at eight.",
          "Trabajo a las ocho."
        ],
        [
          "I eat at one.",
          "Como a la una."
        ],
        [
          "I study at six.",
          "Estudio a las seis."
        ],
        [
          "I sleep at eleven.",
          "Duermo a las once."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Trabajo a las ocho.",
          "english": "I work at eight."
        },
        {
          "spanish": "Como a la una.",
          "english": "I eat at one."
        },
        {
          "spanish": "Estudio a las seis.",
          "english": "I study at six."
        },
        {
          "spanish": "La clase empieza a las nueve.",
          "english": "The class starts at nine."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Put the time before or after the activity: A las ocho trabajo. / Trabajo a las ocho."
    }
  ]
