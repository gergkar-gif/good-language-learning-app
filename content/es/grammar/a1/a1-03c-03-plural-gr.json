{
  "id": "grammar.a1.03c.03.plural",
  "title": "Describing More Than One Person",
  "sections": [
    {
      "type": "text",
      "title": "Plural agreement",
      "content": "Adjectives also agree with number. Most adjectives ending in a vowel take -s in the plural. Adjectives ending in a consonant such as joven take -es."
    },
    {
      "type": "table",
      "title": "Singular and plural",
      "rows": [
        [
          "alto",
          "altos"
        ],
        [
          "alta",
          "altas"
        ],
        [
          "joven",
          "jóvenes"
        ],
        [
          "amable",
          "amables"
        ],
        [
          "simpática",
          "simpáticas"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Carlos es alto.",
          "english": "Carlos is tall."
        },
        {
          "spanish": "Carlos y Andreas son altos.",
          "english": "Carlos and Andreas are tall."
        },
        {
          "spanish": "Ana y Meg son simpáticas.",
          "english": "Ana and Meg are friendly."
        },
        {
          "spanish": "Lauren y Kaylee son jóvenes.",
          "english": "Lauren and Kaylee are young."
        }
      ]
    },
    {
      "type": "tip",
      "content": "For a mixed-gender group, use the masculine plural form: Carlos y Ana son altos. For further reference, see Lingolia's Spanish adjective agreement reference."
    },
    {
      "type": "external-link",
      "topic": "Spanish adjective agreement",
      "site": "Lingolia",
      "url": "https://espanol.lingolia.com/en/grammar/adjectives"
    }
  ]
}
