{
  "id": "grammar.a1.08.01.food-shopping",
  "title": "Food and shopping",
  "sections": [
    {
      "type": "text",
      "title": "Food noun phrases",
      "content": "Use articles with food nouns just as you do with other nouns. Use un or una for one item and unos or unas for more than one. The article agrees with the noun."
    },
    {
      "type": "table",
      "title": "Food noun phrases",
      "rows": [
        [
          "masculine singular",
          "un pan"
        ],
        [
          "feminine singular",
          "una manzana"
        ],
        [
          "masculine plural",
          "unos tomates"
        ],
        [
          "feminine plural",
          "unas naranjas"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Quiero un pan.",
          "english": "I want a loaf of bread."
        },
        {
          "spanish": "Necesito una manzana.",
          "english": "I need an apple."
        },
        {
          "spanish": "Hay unos tomates.",
          "english": "There are some tomatoes."
        },
        {
          "spanish": "Hay unas naranjas.",
          "english": "There are some oranges."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The article agrees with the food noun: un tomate, una manzana, unos tomates, unas manzanas."
    }
  ]
}
