{
  "id": "grammar.a1.03.05.integration",
  "title": "Introducing and describing people",
  "sections": [
    {
      "type": "text",
      "title": "Putting the structures together",
      "content": "You can combine articles, ser and adjectives to identify and describe people. Keep the sentences short and clear."
    },
    {
      "type": "table",
      "title": "Useful patterns",
      "rows": [
        [
          "Es un chico alto.",
          "He is a tall boy."
        ],
        [
          "Es una chica alta.",
          "She is a tall girl."
        ],
        [
          "Ella es una persona amable.",
          "She is a kind person."
        ],
        [
          "Son unos amigos simpáticos.",
          "They are friendly friends."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Carlos es un chico alto.",
          "english": "Carlos is a tall boy."
        },
        {
          "spanish": "Meg es una chica amable.",
          "english": "Meg is a kind girl."
        },
        {
          "spanish": "Son unos amigos simpáticos.",
          "english": "They are friendly friends."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Check three things: the article, the noun and the adjective. They should fit together in gender and number."
    }
