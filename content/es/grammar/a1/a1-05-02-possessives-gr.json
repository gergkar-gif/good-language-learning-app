{
  "id": "grammar.a1.05.02.possessives",
  "title": "Possessive adjectives",
  "sections": [
    {
      "type": "text",
      "title": "My, your and his/her/their",
      "content": "Possessive adjectives come before the noun. Mi means \"my\", tu means \"your\", and su means \"his\", \"her\" or \"their\". They have plural forms before plural nouns: mis, tus, sus."
    },
    {
      "type": "table",
      "title": "Possessives",
      "rows": [
        [
          "my",
          "mi / mis"
        ],
        [
          "your (tú)",
          "tu / tus"
        ],
        [
          "his / her / their",
          "su / sus"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Mi madre es amable.",
          "english": "My mother is kind."
        },
        {
          "spanish": "Tus hermanos son jóvenes.",
          "english": "Your brothers / siblings are young."
        },
        {
          "spanish": "Su padre es de Chile.",
          "english": "His / Her / Their father is from Chile."
        },
        {
          "spanish": "Mis padres son de Hungría.",
          "english": "My parents are from Hungary."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The possessive agrees with the noun in number, not with the owner: mi hermano, mis hermanos."
    }
  ]
}
