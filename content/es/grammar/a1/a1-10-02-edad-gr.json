{
  "id": "grammar.a1.10.02.edad",
  "title": "How Old Are You?",
  "sections": [
    {
      "type": "text",
      "title": "How Old Are You?",
      "content": "Spanish does age with 'tener', not with 'ser': you have twenty-five years. So it is 'tengo veinticinco años', never 'soy veinticinco'. This is one of the first things people ask about a birthday."
    },
    {
      "type": "table",
      "title": "Asking and saying age",
      "rows": [
        [
          "¿Cuántos años tienes?",
          "How old are you?"
        ],
        [
          "Tengo veinticinco años.",
          "I'm twenty-five."
        ],
        [
          "¿Cuántos años tiene?",
          "How old is he/she?"
        ]
      ]
    },
    {
      "type": "table",
      "title": "At the party",
      "rows": [
        [
          "el color",
          "the colour"
        ],
        [
          "la bebida",
          "the drink"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¿Cuántos años tiene Meg?",
          "english": "How old is Meg?"
        },
        {
          "spanish": "¿Cuál es tu bebida favorita?",
          "english": "What's your favourite drink?"
        },
        {
          "spanish": "Mi color favorito es el verde.",
          "english": "My favourite colour is green."
        }
      ]
    },
    {
      "type": "tip",
      "content": "English drops 'years old' in speech, Spanish never drops 'años': 'tengo veinticinco años', not just 'tengo veinticinco'."
    },
