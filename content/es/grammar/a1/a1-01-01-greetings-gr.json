{
  "id": "grammar.a1.01.01.greetings",
  "title": "Greetings",
  "sections": [
    {
      "type": "text",
      "title": "Basic greetings",
      "content": "Spanish uses different greetings depending on the time and situation. Hola is a general greeting. Buenos días is used in the morning, while buenas tardes is used in the afternoon and buenas noches in the evening or at night."
    },
    {
      "type": "table",
      "title": "Common greetings",
      "rows": [
        [
          "Hola",
          "Hello / Hi"
        ],
        [
          "Buenos días",
          "Good morning"
        ],
        [
          "Buenas tardes",
          "Good afternoon"
        ],
        [
          "Buenas noches",
          "Good evening / Good night"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Hola.",
          "english": "Hello."
        },
        {
          "spanish": "Buenos días.",
          "english": "Good morning."
        },
        {
          "spanish": "Buenas tardes.",
          "english": "Good afternoon."
        },
        {
          "spanish": "Buenas noches.",
          "english": "Good evening / Good night."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Hola works throughout the day. Use buenos or buenas according to the expression: buenos días, but buenas tardes and buenas noches."
    }
  ]
}
