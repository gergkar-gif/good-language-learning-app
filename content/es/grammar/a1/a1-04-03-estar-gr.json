{
  "id": "grammar.a1.04.03.estar",
  "title": "Estar for location",
  "sections": [
    {
      "type": "text",
      "title": "Saying where something is",
      "content": "Use estar to say where a person or thing is located. Use *está* for one person or thing and *están* for more than one."
    },
    {
      "type": "table",
      "title": "Estar for location",
      "rows": [
        [
          "El banco está aquí.",
          "The bank is here."
        ],
        [
          "La farmacia está allí.",
          "The pharmacy is there."
        ],
        [
          "Los restaurantes están cerca.",
          "The restaurants are nearby."
        ],
        [
          "Las tiendas están lejos.",
          "The shops are far away."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "La cafetería está cerca.",
          "english": "The café is nearby."
        },
        {
          "spanish": "El hotel está allí.",
          "english": "The hotel is there."
        },
        {
          "spanish": "Los bancos están aquí.",
          "english": "The banks are here."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Use hay to say something exists: Hay una *farmacia*. Use *está* or *están* to say where a known thing is: La farmacia está *allí*."
    }
  ]
}
