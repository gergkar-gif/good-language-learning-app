{
  "id": "grammar.a1.directions.01.movement-location",
  "title": "Movement and location",
  "sections": [
    {
      "type": "text",
      "title": "Where are we going?",
      "content": "Use ir + a to say where someone is going. Use estar to say where someone or a place is located."
    },
    {
      "type": "table",
      "title": "Movement vs location",
      "rows": [
        [
          "I go to the market.",
          "Voy al mercado."
        ],
        [
          "I am at the market.",
          "Estoy en el mercado."
        ],
        [
          "The museum is here.",
          "El museo está aquí."
        ],
        [
          "We go to the park.",
          "Vamos al parque."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Voy al mercado.",
          "english": "I go to the market."
        },
        {
          "spanish": "Estoy en el mercado.",
          "english": "I am at the market."
        },
        {
          "spanish": "¿Adónde vas?",
          "english": "Where are you going?"
        },
        {
          "spanish": "¿Dónde estás?",
          "english": "Where are you?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Use ir for movement and estar for location: Voy al parque, but Estoy en el parque."
    }
  ]
}
