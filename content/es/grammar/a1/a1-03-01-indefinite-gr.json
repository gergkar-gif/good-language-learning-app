{
  "id": "grammar.a1.03.01.indefinite",
  "title": "Indefinite articles",
  "sections": [
    {
      "type": "text",
      "title": "Naming something",
      "content": "Use un or una for one thing and unos or unas for more than one. The article agrees with the noun."
    },
    {
      "type": "table",
      "title": "Indefinite articles",
      "rows": [
        [
          "un libro",
          "a book"
        ],
        [
          "una mesa",
          "a table"
        ],
        [
          "unos libros",
          "some books"
        ],
        [
          "unas mesas",
          "some tables"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Es un libro.",
          "english": "It is a book."
        },
        {
          "spanish": "Es una foto.",
          "english": "It is a photo."
        },
        {
          "spanish": "Son unos amigos.",
          "english": "They are some friends."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Learn the article together with the noun. This helps you remember whether the noun is masculine or feminine."
    }
  ]
}
