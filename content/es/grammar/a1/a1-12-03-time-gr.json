{
  "id": "grammar.a1.12.03.time",
  "title": "Telling the time",
  "sections": [
    {
      "type": "text",
      "title": "Tell the time",
      "content": "Use ¿Qué hora es? to ask the time. Use Es la una for one o'clock and Son las... for other hours."
    },
    {
      "type": "table",
      "title": "Time patterns",
      "rows": [
        [
          "1:00",
          "Es la una."
        ],
        [
          "2:00",
          "Son las dos."
        ],
        [
          "3:30",
          "Son las tres y media."
        ],
        [
          "5:15",
          "Son las cinco y cuarto."
        ],
        [
          "6:45",
          "Son las siete menos cuarto."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¿Qué hora es?",
          "english": "What time is it?"
        },
        {
          "spanish": "Son las cuatro.",
          "english": "It is four o'clock."
        },
        {
          "spanish": "Son las ocho y media.",
          "english": "It is half past eight."
        },
        {
          "spanish": "Es la una y cuarto.",
          "english": "It is quarter past one."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Use la with one and las with all other hours: Es la una, but Son las dos."
    }
  ]
}
