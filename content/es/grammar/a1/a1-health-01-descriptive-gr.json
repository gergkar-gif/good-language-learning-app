{
  "id": "grammar.a1.health.01.descriptive",
  "title": "Basic descriptive health structures",
  "sections": [
    {
      "type": "text",
      "title": "Describe how you feel",
      "content": "Use estar + adjective to describe a current physical state. Use tener expressions for common health conditions such as tener fiebre or tener dolor."
    },
    {
      "type": "table",
      "title": "Basic descriptions",
      "rows": [
        [
          "I am tired.",
          "Estoy cansado."
        ],
        [
          "I am sick.",
          "Estoy enfermo."
        ],
        [
          "I am well.",
          "Estoy bien."
        ],
        [
          "I have a fever.",
          "Tengo fiebre."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Estoy cansado.",
          "english": "I am tired."
        },
        {
          "spanish": "Estoy enfermo.",
          "english": "I am sick."
        },
        {
          "spanish": "Estoy bien.",
          "english": "I am well."
        },
        {
          "spanish": "Tengo fiebre.",
          "english": "I have a fever."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Use estar for a current state: Estoy cansado. Use tener in fixed health expressions: Tengo fiebre."
    }
  ]
}
