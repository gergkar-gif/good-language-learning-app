{
  "id": "grammar.a1.08.02.quantities",
  "title": "Numbers and quantities",
  "sections": [
    {
      "type": "text",
      "title": "Say how many",
      "content": "Use numbers before plural nouns to say how many items you want or need. For amounts of food and drink, common quantity expressions include kilo, botella and paquete."
    },
    {
      "type": "table",
      "title": "Useful quantities",
      "rows": [
        [
          "one",
          "uno / una"
        ],
        [
          "two",
          "dos"
        ],
        [
          "three",
          "tres"
        ],
        [
          "a kilo",
          "un kilo"
        ],
        [
          "a bottle",
          "una botella"
        ],
        [
          "a packet",
          "un paquete"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Quiero dos manzanas.",
          "english": "I want two apples."
        },
        {
          "spanish": "Necesito tres tomates.",
          "english": "I need three tomatoes."
        },
        {
          "spanish": "Quiero un kilo de arroz.",
          "english": "I want a kilo of rice."
        },
        {
          "spanish": "Necesito una botella de agua.",
          "english": "I need a bottle of water."
        }
      ]
    },
    {
      "type": "tip",
      "content": "After a number greater than one, use the plural noun: dos manzanas, tres tomates."
    }
  ]
}
