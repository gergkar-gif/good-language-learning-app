{
  "id": "grammar.a1.03.03.definite",
  "title": "Definite articles",
  "sections": [
    {
      "type": "text",
      "title": "Talking about a specific thing",
      "content": "Use el, la, los or las when the noun is specific or already known. The article agrees with the noun in gender and number."
    },
    {
      "type": "table",
      "title": "Definite articles",
      "rows": [
        [
          "el teléfono",
          "the phone"
        ],
        [
          "la puerta",
          "the door"
        ],
        [
          "los libros",
          "the books"
        ],
        [
          "las fotos",
          "the photos"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "El teléfono está aquí.",
          "english": "The phone is here."
        },
        {
          "spanish": "La familia está en casa.",
          "english": "The family is at home."
        },
        {
          "spanish": "Las fotos son bonitas.",
          "english": "The photos are nice."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Compare un libro with el libro: the first introduces a book; the second refers to a specific book."
    }
  ]
}
