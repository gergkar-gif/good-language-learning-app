{
  "id": "grammar.a1.08.04.necesitar",
  "title": "Necesitar",
  "sections": [
    {
      "type": "text",
      "title": "Say what you need",
      "content": "Necesitar means to need. It is a regular -ar verb, so it follows the present-tense pattern you learned earlier."
    },
    {
      "type": "table",
      "title": "Necesitar in the present",
      "rows": [
        [
          "yo",
          "necesito"
        ],
        [
          "tú",
          "necesitas"
        ],
        [
          "él / ella / usted",
          "necesita"
        ],
        [
          "nosotros / nosotras",
          "necesitamos"
        ],
        [
          "ellos / ellas / ustedes",
          "necesitan"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Necesito leche.",
          "english": "I need milk."
        },
        {
          "spanish": "¿Qué necesitas?",
          "english": "What do you need?"
        },
        {
          "spanish": "Ella necesita arroz.",
          "english": "She needs rice."
        },
        {
          "spanish": "Necesitamos dos paquetes.",
          "english": "We need two packets."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Necesitar works like other regular -ar verbs: necesito, necesitas, necesita, necesitamos, necesitan."
    }
  ]
}
