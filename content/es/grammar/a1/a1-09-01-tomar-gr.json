{
  "id": "grammar.a1.09.01.tomar",
  "title": "Tomar",
  "sections": [
    {
      "type": "text",
      "title": "Say what you drink",
      "content": "Tomar means to drink or to have, especially when talking about drinks. It is a regular -ar verb in the present tense."
    },
    {
      "type": "table",
      "title": "Tomar in the present",
      "rows": [
        [
          "yo",
          "tomo"
        ],
        [
          "tú",
          "tomas"
        ],
        [
          "él / ella / usted",
          "toma"
        ],
        [
          "nosotros / nosotras",
          "tomamos"
        ],
        [
          "ellos / ellas / ustedes",
          "toman"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Tomo café.",
          "english": "I drink coffee."
        },
        {
          "spanish": "¿Qué tomas?",
          "english": "What do you drink?"
        },
        {
          "spanish": "Ella toma té.",
          "english": "She drinks tea."
        },
        {
          "spanish": "Tomamos agua.",
          "english": "We drink water."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Tomar follows the regular -ar pattern: tomo, tomas, toma, tomamos, toman."
    }
  ]
}
