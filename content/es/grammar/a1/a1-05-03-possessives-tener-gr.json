{
  "id": "grammar.a1.05.03.possessives-tener",
  "title": "Possessives + tener",
  "sections": [
    {
      "type": "text",
      "title": "Combine the two structures",
      "content": "Use tener to say that someone has family members. Add a possessive when you need to show whose family member you mean: mi, tu, su, mis, *tus*, sus."
    },
    {
      "type": "table",
      "title": "Useful patterns",
      "rows": [
        [
          "I have...",
          "tengo ..."
        ],
        [
          "you have...",
          "tienes ..."
        ],
        [
          "he / she has...",
          "tiene ..."
        ],
        [
          "we have...",
          "tenemos ..."
        ],
        [
          "they have...",
          "tienen ..."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Tengo dos hermanos.",
          "english": "I have two brothers / siblings."
        },
        {
          "spanish": "Esta es mi madre.",
          "english": "This is my mother."
        },
        {
          "spanish": "¿Tienes tus fotos?",
          "english": "Do you have your photos?"
        },
        {
          "spanish": "Su familia tiene tres hijos.",
          "english": "His / Her family has three children."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The possessive tells us who the family member belongs to: mi *madre*, tu hermano, sus *hijos*."
    }
  ]
}
