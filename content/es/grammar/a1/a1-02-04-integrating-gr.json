{
  "id": "grammar.a1.02.04.unit",
  "title": "u",
  "sections": [
    {
      "type": "text",
      "title": "A short introduction",
      "content": "You can combine the structures from this unit to introduce people clearly: say who someone is, name the person, and add a simple connection."
    },
    {
      "type": "table",
      "title": "Useful patterns",
      "rows": [
        [
          "Él es Carlos.",
          "He is Carlos."
        ],
        [
          "Ella es Meg.",
          "She is Meg."
        ],
        [
          "Carlos presenta a Meg.",
          "Carlos introduces Meg."
        ],
        [
          "Ella es mi amiga.",
          "She is my friend."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Aquí está mi grupo.",
          "english": "Here is my group."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the introduction simple. At A1, short sentences are enough to identify people and explain the connection."
    }
  ]
}
