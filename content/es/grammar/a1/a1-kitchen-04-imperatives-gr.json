{
  "id": "grammar.a1.kitchen.04.imperatives",
  "title": "Basic affirmative imperatives",
  "sections": [
    {
      "type": "text",
      "title": "Give simple instructions",
      "content": "For a basic affirmative tú command, regular -ar verbs use -a and regular -er / -ir verbs use -e."
    },
    {
      "type": "table",
      "title": "Regular affirmative commands",
      "rows": [
        [
          "preparar",
          "prepara"
        ],
        [
          "cortar",
          "corta"
        ],
        [
          "mezclar",
          "mezcla"
        ],
        [
          "comer",
          "come"
        ],
        [
          "abrir",
          "abre"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Corta los tomates.",
          "english": "Cut the tomatoes."
        },
        {
          "spanish": "Mezcla los ingredientes.",
          "english": "Mix the ingredients."
        },
        {
          "spanish": "Come la ensalada.",
          "english": "Eat the salad."
        },
        {
          "spanish": "Abre la botella.",
          "english": "Open the bottle."
        }
      ]
    },
    {
      "type": "tip",
      "content": "This lesson uses only basic affirmative tú commands. Negative commands and irregular commands are not introduced."
    }
  ]
}
