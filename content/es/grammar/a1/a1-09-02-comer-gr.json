{
  "id": "grammar.a1.09.02.comer",
  "title": "Comer",
  "sections": [
    {
      "type": "text",
      "title": "Say what you eat",
      "content": "Comer means to eat. It is a regular -er verb in the present tense."
    },
    {
      "type": "table",
      "title": "Comer in the present",
      "rows": [
        [
          "yo",
          "como"
        ],
        [
          "tú",
          "comes"
        ],
        [
          "él / ella / usted",
          "come"
        ],
        [
          "nosotros / nosotras",
          "comemos"
        ],
        [
          "ellos / ellas / ustedes",
          "comen"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Como un sándwich.",
          "english": "I eat a sandwich."
        },
        {
          "spanish": "¿Qué comes?",
          "english": "What do you eat?"
        },
        {
          "spanish": "Ella come una ensalada.",
          "english": "She eats a salad."
        },
        {
          "spanish": "Comemos en el café.",
          "english": "We eat at the café."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Comer follows the regular -er pattern: como, comes, come, comemos, comen."
    }
  ]
}
