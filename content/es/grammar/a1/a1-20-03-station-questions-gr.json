{
  "id": "grammar.a1.20.03.station-questions",
  "title": "Questions and practical interaction",
  "sections": [
    {
      "type": "text",
      "title": "Ask practical questions at the station",
      "content": "Use familiar question structures to ask about tickets, times, destinations and platforms at a station."
    },
    {
      "type": "table",
      "title": "At the station",
      "rows": [
        [
          "Where is the station?",
          "¿Dónde está la estación?"
        ],
        [
          "Where is the train?",
          "¿Dónde está el tren?"
        ],
        [
          "What time is the train?",
          "¿A qué hora sale el tren?"
        ],
        [
          "Where is platform three?",
          "¿Dónde está el andén tres?"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¿Dónde está la estación?",
          "english": "Where is the station?"
        },
        {
          "spanish": "¿A qué hora sale el tren?",
          "english": "What time does the train leave?"
        },
        {
          "spanish": "¿Dónde está el andén tres?",
          "english": "Where is platform three?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Use ¿Dónde está...? for locations and ¿A qué hora...? when asking about time."
    }
  ]
}
