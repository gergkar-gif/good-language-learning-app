{
  "id": "grammar.a1.06.02.ar-verbs",
  "title": "Regular -AR verbs",
  "sections": [
    {
      "type": "text",
      "title": "The -AR pattern",
      "content": "Regular -ar verbs use the same present-tense endings. Remove -ar from the infinitive and add the ending for the subject."
    },
    {
      "type": "table",
      "title": "Trabajar",
      "rows": [
        [
          "yo",
          "trabajo"
        ],
        [
          "tú",
          "trabajas"
        ],
        [
          "él / ella / usted",
          "trabaja"
        ],
        [
          "nosotros / nosotras",
          "trabajamos"
        ],
        [
          "ellos / ellas / ustedes",
          "trabajan"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Trabajo en casa.",
          "english": "I work at home."
        },
        {
          "spanish": "Tú estudias español.",
          "english": "You study Spanish."
        },
        {
          "spanish": "Ana cocina en casa.",
          "english": "Ana cooks at home."
        },
        {
          "spanish": "Trabajamos por la mañana.",
          "english": "We work in the morning."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The subject does not need to be repeated when the verb ending makes it clear: Trabajo en *casa*."
    }
  ]
}
