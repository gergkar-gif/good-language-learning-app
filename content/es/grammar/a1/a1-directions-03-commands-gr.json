  "title": "Basic directional commands",
  "sections": [
    {
      "type": "text",
      "title": "Give simple directions",
      "content": "Use familiar affirmative tú commands to give short directional instructions."
    },
    {
      "type": "table",
      "title": "Directional commands",
      "rows": [
        [
          "go",
          "ve"
        ],
        [
          "walk",
          "camina"
        ],
        [
          "turn",
          "gira"
        ],
        [
          "continue",
          "sigue"
        ],
        [
          "stop",
          "para"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Ve a la derecha.",
          "english": "Go to the right."
        },
        {
          "spanish": "Camina por la calle.",
          "english": "Walk along the street."
        },
        {
          "spanish": "Gira a la izquierda.",
          "english": "Turn left."
        },
        {
          "spanish": "Sigue recto.",
          "english": "Continue straight."
        }
      ]
    },
    {
      "type": "tip",
      "content": "These are simple affirmative tú commands for giving directions: ve, camina, gira, sigue, para."
    }
