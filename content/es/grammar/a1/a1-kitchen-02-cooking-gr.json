{
  "id": "grammar.a1.kitchen.02.cooking",
  "title": "Cooking",
  "sections": [
    {
      "type": "text",
      "title": "Describe cooking actions",
      "content": "Use regular present-tense verbs to say what people do in the kitchen."
    },
    {
      "type": "table",
      "title": "Regular cooking verbs",
      "rows": [
        [
          "preparar",
          "preparo, preparas, prepara..."
        ],
        [
          "cortar",
          "corto, cortas, corta..."
        ],
        [
          "mezclar",
          "mezclo, mezclas, mezcla..."
        ],
        [
          "cocinar",
          "cocino, cocinas, cocina..."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Preparo la comida.",
          "english": "I prepare the food."
        },
        {
          "spanish": "Corto los tomates.",
          "english": "I cut the tomatoes."
        },
        {
          "spanish": "Mezclo los ingredientes.",
          "english": "I mix the ingredients."
        },
        {
          "spanish": "Cocinamos el arroz.",
          "english": "We cook the rice."
        }
      ]
    },
    {
      "type": "tip",
      "content": "These are regular -ar verbs. Use the same present-tense endings you already know."
    }
  ]
}
