{
  "id": "grammar.a1.06.03.er-ir-verbs",
  "title": "Regular -ER and -IR verbs",
  "sections": [
    {
      "type": "text",
      "title": "Two more regular patterns",
      "content": "Regular -er and -ir verbs also follow clear present-tense patterns. The -er and -ir endings are similar, but nosotros uses -emos for -er verbs and -imos for -ir verbs."
    },
    {
      "type": "table",
      "title": "Comer and vivir",
      "rows": [
        [
          "yo",
          "como / vivo"
        ],
        [
          "tú",
          "comes / vives"
        ],
        [
          "él / ella / usted",
          "come / vive"
        ],
        [
          "nosotros / nosotras",
          "comemos / vivimos"
        ],
        [
          "ellos / ellas / ustedes",
          "comen / viven"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Como en casa.",
          "english": "I eat at home."
        },
        {
          "spanish": "Tú bebes café.",
          "english": "You drink coffee."
        },
        {
          "spanish": "Vivimos en Hanoi.",
          "english": "We live in Hanoi."
        },
        {
          "spanish": "Ellos escriben por la mañana.",
          "english": "They write in the morning."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Regular verbs keep their stem. Only the ending changes: comer → como, comes, come."
    }
  ]
}
