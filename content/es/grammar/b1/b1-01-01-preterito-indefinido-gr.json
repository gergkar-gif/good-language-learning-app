{
  "id": "grammar.b1.01.01.preterito-indefinido",
  "title": "What Happened?",
  "sections": [
    {
      "type": "text",
      "content": "The pretérito indefinido presents completed events that move a story forward. Sequencing expressions make the order of events explicit."
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "De repente, apareció un hombre.",
          "english": "Suddenly, a man appeared."
        },
        {
          "spanish": "Enseguida salió de la casa.",
          "english": "He immediately left the house."
        },
        {
          "spanish": "Algo extraño ocurrió.",
          "english": "Something strange happened."
        },
        {
          "spanish": "El hombre huyó.",
          "english": "The man fled."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Use the indefinido to answer «¿Qué pasó?» when the event is presented as completed."
    }
  ]
}
