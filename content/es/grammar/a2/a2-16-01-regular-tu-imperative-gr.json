{
  "id": "grammar.a2.16.01.regular-tu-imperative",
  "title": "Do It!",
  "sections": [
    {
      "type": "text",
      "title": "Regular tú imperatives",
      "content": "To tell a friend to do something, use the *tú* affirmative command. It looks exactly like the *él/ella/usted* present tense form."
    },
    {
