{
  "id": "grammar.a2.12.02.placement",
  "title": "Pronoun Placement and Agreement",
  "sections": [
    {
      "type": "text",
      "content": "A direct object pronoun normally comes immediately before a conjugated verb: La *compré*. Lo *recibí*. Los *compramos*. Las preparamos. Choose lo, la, los or las according to the object being replaced."
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Compré la flor → La compré.",
          "english": "I bought the flower → I bought it."
        },
        {
          "spanish": "Compramos los regalos → Los compramos.",
          "english": "We bought the gifts → We bought them."
        },
        {
          "spanish": "Recibí las tarjetas → Las recibí.",
          "english": "I received the cards → I received them."
        },
        {
          "spanish": "Preparó la sorpresa → La preparó.",
          "english": "He/she prepared the surprise."
        }
      ]
    },
    {
      "type": "table",
      "rows": [
        [
          "la flor → la",
          "the flower → it"
        ],
        [
          "los regalos → los",
          "the gifts → them"
        ],
        [
          "las tarjetas → las",
          "the cards → them"
        ]
      ]
    },
    {
      "type": "tip",
      "content": "Choose the pronoun from the object being replaced: el regalo → lo, la tarjeta → la, los *regalos* → los, las flores → las."
    },
    {
      "type": "external-link",
      "topic": "direct object pronouns",
      "site": "Lingolia",
      "url": "https://www.lingolia.com/en/grammar/pronouns/direct-object-pronouns"
    }
  ]
}
