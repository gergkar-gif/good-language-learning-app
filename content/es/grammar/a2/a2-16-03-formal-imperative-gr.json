  "sections": [
    {
      "type": "text",
      "title": "Usted / Ustedes Commands",
      "content": "To be formal (*usted*) or address a group (*ustedes* in Latin America), use the present subjunctive forms."
    },
    {
      "type": "table",
      "title": "Formal Commands",
      "rows": [
        [
          "Ending",
          "Usted",
          "Ustedes"
        ],
        [
          "-ar",
          "-e (hable)",
          "-en (hablen)"
        ],
        [
          "-er / -ir",
          "-a (coma, escriba)",
          "-an (coman, escriban)"
        ]
      ]
    }
  ]
