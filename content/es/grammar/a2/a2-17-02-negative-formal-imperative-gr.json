{
  "id": "grammar.a2.17.02.negative-formal-imperative",
  "title": "Don't Do It, Sir",
  "sections": [
    {
      "type": "text",
      "title": "Negative Formal Commands",
      "content": "For formal negative commands, just add *no* before the formal affirmative command. They both use the subjunctive."
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "No hable.",
          "english": "Don't speak. (formal)"
        },
        {
          "spanish": "No fumen.",
          "english": "Don't smoke. (plural)"
        }
      ]
    }
  ]
}