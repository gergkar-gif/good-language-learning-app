{
  "id": "grammar.a2.03.02.preguntas",
  "title": "Ya and Todavía in Questions",
  "sections": [
    {
      "type": "text",
      "content": "Use ya in questions when asking whether something has happened already. A short negative answer can use No, todavía no. The pretérito perfecto remains the same."
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¿Ya has visto el río?",
          "english": "Have you already seen the river?"
        },
        {
          "spanish": "Sí, ya lo he visto.",
          "english": "Yes, I have already seen it."
        },
        {
          "spanish": "¿Ya han comprado los billetes?",
          "english": "Have they already bought the tickets?"
        },
        {
          "spanish": "No, todavía no.",
          "english": "No, not yet."
        }
      ]
    },
    {
      "type": "table",
      "rows": [
        [
          "ya + perfecto",
          "already + perfect"
        ],
        [
          "todavía no + perfecto",
          "not yet + perfect"
        ],
        [
          "¿Ya has + participio?",
          "Have you already + participle?"
        ]
      ]
    },
    {
      "type": "tip",
      "content": "Keep the auxiliary and participle together. Use ya for completed actions and todavía no for actions that have not happened yet."
    },
    {
      "type": "external-link",
      "topic": "the pretérito perfecto",
      "site": "Lingolia",
      "url": "https://www.lingolia.com/en/grammar/tenses/preterito-perfecto"
    }
  ]
}