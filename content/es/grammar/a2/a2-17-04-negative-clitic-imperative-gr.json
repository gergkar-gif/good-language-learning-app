{
  "id": "grammar.a2.17.04.negative-clitic-imperative",
  "title": "Don't Tell Me!",
  "sections": [
    {
      "type": "text",
      "title": "Pronouns with Negative Commands",
      "content": "In negative commands, pronouns CANNOT be attached to the verb. They must go BEFORE the conjugated verb, just like in normal sentences."
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¡No me digas!",
          "english": "Don't tell me!"
        },
        {
          "spanish": "¡No lo pongas ahí!",
          "english": "Don't put it there!"
        }
      ]
    },
    {
      "type": "table",
      "title": "Affirmative vs Negative",
      "rows": [
        [
          "Affirmative",
          "Negative"
        ],
        [
          "¡Dímelo!",
          "¡No me lo digas!"
        ],
        [
          "¡Siéntate!",
          "¡No te sientes!"
        ]
      ]
    }
  ]
}