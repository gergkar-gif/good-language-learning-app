{
  "id": "grammar.a2.03.01.experiencias",
  "title": "Talking About Experiences",
  "sections": [
    {
      "type": "text",
      "content": "Use the pretérito perfecto to talk about experiences during a recent outing. The form is haber + past participle. The action is connected to the present and is part of the current experience."
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Hemos llegado al embarcadero.",
          "english": "We have arrived at the pier."
        },
        {
          "spanish": "Hemos comprado los billetes.",
          "english": "We have bought the tickets."
        },
        {
          "spanish": "La barquera ha remado despacio.",
          "english": "The boatwoman has rowed slowly."
        },
        {
          "spanish": "Carlos ha visto las cuevas.",
          "english": "Carlos has seen the caves."
        }
      ]
    },
    {
      "type": "table",
      "rows": [
        [
          "ya + perfecto",
          "already + perfect"
        ],
        [
          "todavía no + perfecto",
          "not yet + perfect"
        ],
        [
          "¿Ya has + participio?",
          "Have you already + participle?"
        ]
      ]
    },
    {
      "type": "tip",
      "content": "Keep the auxiliary and participle together. Use ya for completed actions and todavía no for actions that have not happened yet."
    },
    {
      "type": "external-link",
      "topic": "the pretérito perfecto",
      "site": "Lingolia",
      "url": "https://www.lingolia.com/en/grammar/tenses/preterito-perfecto"
    }
  ]
}