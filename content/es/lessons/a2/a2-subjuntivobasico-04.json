  },
  "sections": [
    {
      "type": "goal",
      "title": "Lesson Goals",
      "items": [
        "Use 'cuando + subjuntivo' when referring to an action that has NOT happened yet.",
        "Distinguish routine past/present time ('cuando llego a casa ceno') from anticipated future time ('cuando llegue a casa te llamo')."
      ]
    },
