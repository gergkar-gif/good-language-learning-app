  "id": "lesson.a2.subjuntivobasico.04",
  "title": "When I Arrive: Future Time with 'Cuando'",
  "level": "A2",
  "goal": "Use 'cuando + subjuntivo' to express future, anticipated moments.",
  "grammar": "cuando + presente de subjuntivo (tiempo futuro)",
  "metadata": {
