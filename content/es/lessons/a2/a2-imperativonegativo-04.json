{
  "id": "lesson.a2.imperativonegativo.04",
  "title": "Pronoun Placement: Tell Me vs. Don't Tell Me",
  "level": "A2",
  "goal": "Place object pronouns correctly with affirmative and negative commands.",
  "grammar": "pronombres con imperativos (posición y acento)",
  "metadata": {
    "estimatedMinutes": 15
  },
  "sections": [
    {
      "type": "goal",
      "title": "Lesson Goals",
      "items": [
        "Attach pronouns to the end of affirmative commands (¡Dime!, ¡Hazlo!, ¡Levántate!).",
        "Place pronouns before negative commands (¡No me digas!, ¡No lo hagas!, ¡No te levantes!).",
        "Apply written accent marks when syllable count increases on affirmative commands."
      ]
    },
