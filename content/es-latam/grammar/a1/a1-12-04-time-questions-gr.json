{
  "id": "grammar.a1.12.04.time-questions",
  "title": "Time questions",
  "sections": [
    {
      "type": "text",
      "title": "Ask when something happens",
      "content": "Use *¿A qué hora...?* to ask what time an activity happens. Use *¿Cuándo...?* to ask more generally when it happens."
    },
    {
      "type": "table",
      "title": "Time questions",
      "rows": [
        [
          "¿A qué hora comes?",
          "What time do you eat?"
        ],
        [
          "¿A qué hora trabajas?",
          "What time do you work?"
        ],
        [
          "¿Cuándo es la clase?",
          "When is the class?"
        ],
        [
          "¿A qué hora es la fiesta?",
          "At what time is the party?"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¿A qué hora comes?",
          "english": "What time do you eat?"
        },
        {
          "spanish": "Como a la una.",
          "english": "I eat at one."
        },
        {
          "spanish": "¿Cuándo es la clase?",
          "english": "When is the class?"
        },
        {
          "spanish": "La clase es a las nueve.",
          "english": "The class is at nine."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Use *a la una* for one o'clock and *a las* + plural hour for other times: *a la una*, *a las dos*, *a las nueve*."
    }
  ]
}
