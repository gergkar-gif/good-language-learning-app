{
  "id": "grammar.a1.weather.01.weather",
  "title": "Weather expressions",
  "sections": [
    {
      "type": "text",
      "title": "Talk about the weather",
      "content": "Spanish uses simple fixed expressions to describe the weather. Use *hace* with temperature and many general weather conditions, and *hay* or *está* for other common conditions."
    },
    {
      "type": "table",
      "title": "Basic weather expressions",
      "rows": [
        [
          "Hace calor.",
          "It is hot."
        ],
        [
          "Hace frío.",
          "It is cold."
        ],
        [
          "Hace sol.",
          "It is sunny."
        ],
        [
          "Hace viento.",
          "It is windy."
        ],
        [
          "Llueve.",
          "It is raining."
        ],
        [
          "Está nublado.",
          "It is cloudy."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Hace calor hoy.",
          "english": "It is hot today."
        },
        {
          "spanish": "Hace frío.",
          "english": "It is cold."
        },
        {
          "spanish": "Hace sol.",
          "english": "It is sunny."
        },
        {
          "spanish": "Está nublado.",
          "english": "It is cloudy."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Treat these as useful weather patterns. Do not translate them word for word from English."
    }
  ]
}
