{
  "id": "grammar.a1.directions.02.movement-prepositions",
  "title": "Prepositions of movement",
  "sections": [
    {
      "type": "text",
      "title": "Move through town",
      "content": "Use simple movement prepositions to describe going to, *into*, *through* and towards places."
    },
    {
      "type": "table",
      "title": "Movement expressions",
      "rows": [
        [
          "a",
          "to / towards"
        ],
        [
          "por",
          "through"
        ],
        [
          "a",
          "into"
        ],
        [
          "de",
          "from"
        ],
        [
          "por",
          "up"
        ],
        [
          "hacia",
          "towards"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Voy al mercado.",
          "english": "I go to the market."
        },
        {
          "spanish": "Camino por la calle.",
          "english": "I walk along the street."
        },
        {
          "spanish": "Voy hacia el centro.",
          "english": "I go towards the centre."
        },
        {
          "spanish": "Vengo del parque.",
          "english": "I come from the park."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Keep the movement expression attached to the place: *al mercado*, *por la calle*, *hacia el centro*, *del parque*."
    }
  ]
}
