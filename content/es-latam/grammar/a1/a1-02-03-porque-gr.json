{
  "id": "grammar.a1.02.03.unit",
  "title": "Por qué and porque",
  "sections": [
    {
      "type": "text",
      "title": "Question and reason",
      "content": "Use *por* *qué* in a question when you want to ask for a reason. Use *porque* when you give the reason."
    },
    {
      "type": "table",
      "title": "The two forms",
      "rows": [
        [
          "¿Por qué eres nuevo aquí?",
          "Why are you new here?"
        ],
        [
          "Porque soy de Hungría.",
          "Because I am from Hungary."
        ],
        [
          "¿Por qué estudias español?",
          "Why do you study Spanish?"
        ],
        [
          "Porque soy estudiante.",
          "Because I am a student."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Porque soy estudiante.",
          "english": "Because I am a student."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The accent mark matters: *por* *qué* asks the question; *porque* gives the reason."
    }
  ]
}
