{
  "id": "grammar.a1.kitchen.03.kitchen-actions",
  "title": "Kitchen Actions",
  "sections": [
    {
      "type": "text",
      "title": "More kitchen actions",
      "content": "Use regular present-tense verbs to describe simple actions such as washing, adding, opening and using ingredients or kitchen objects."
    },
    {
      "type": "table",
      "title": "Kitchen action verbs",
      "rows": [
        [
          "lavar",
          "lavo, lavas, lava..."
        ],
        [
          "añadir",
          "añado, añades, añade..."
        ],
        [
          "abrir",
          "abro, abres, abre..."
        ],
        [
          "usar",
          "uso, usas, usa..."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Lavo los tomates.",
          "english": "I wash the tomatoes."
        },
        {
          "spanish": "Añado sal.",
          "english": "I add salt."
        },
        {
          "spanish": "Abro la botella.",
          "english": "I open the bottle."
        },
        {
          "spanish": "Uso una cuchara.",
          "english": "I use a spoon."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The focus is on recognising and producing familiar present-tense patterns in a kitchen context."
    }
  ]
}
