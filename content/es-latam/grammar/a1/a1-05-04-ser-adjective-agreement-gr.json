{
  "id": "grammar.a1.05.04.ser-adjective-agreement",
  "title": "Ser + adjective agreement",
  "sections": [
    {
      "type": "text",
      "title": "Describe family members",
      "content": "You know *ser* + adjective and agreement from Units 1 to 4: the adjective agrees with the person in gender and number. Here the people are your family. Adjectives such as *tranquilo* and *divertido* change (*tranquila*, *tranquilos*, *tranquilas*); *amable* stays the same in the singular."
    },
    {
      "type": "table",
      "title": "Agreement",
      "rows": [
        [
          "masculine singular",
          "tranquilo"
        ],
        [
          "feminine singular",
          "tranquila"
        ],
        [
          "masculine plural",
          "tranquilos"
        ],
        [
          "feminine plural",
          "tranquilas"
        ],
        [
          "singular, either gender",
          "amable"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Mi padre es tranquilo.",
          "english": "My father is calm."
        },
        {
          "spanish": "Mi madre es tranquila.",
          "english": "My mother is calm."
        },
        {
          "spanish": "Mis hermanos son divertidos.",
          "english": "My brothers / siblings are fun."
        },
        {
          "spanish": "Mis hermanas son amables.",
          "english": "My sisters are kind."
        }
      ]
    },
    {
      "type": "tip",
      "content": "The adjective describes the person, so it agrees with the noun: *hermana* *tranquila*, *hermanos* *tranquilos*."
    }
  ]
}
