{
  "id": "grammar.a1.06.04.reflexive-verbs",
  "title": "Reflexive Verbs",
  "sections": [
    {
      "type": "text",
      "title": "Reflexive Pronouns",
      "content": "Reflexive verbs are used when the subject performs an action on itself. They require reflexive pronouns."
    },
    {
      "type": "table",
      "title": "Conjugation of *levantarse* (to get up)",
      "rows": [
        [
          "I get up",
          "yo *me levanto*"
        ],
        [
          "You get up",
          "tú *te levantas*"
        ],
        [
          "He/She/You(f) gets up",
          "él/ella/usted *se levanta*"
        ],
        [
          "We get up",
          "nosotros/nosotras *nos levantamos*"
        ],
        [
          "They/You all get up",
          "ellos/ellas/ustedes *se levantan*"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Me despierto a las siete.",
          "english": "I wake up at seven."
        },
        {
          "spanish": "Carlos se ducha por la mañana.",
          "english": "Carlos showers in the morning."
        }
      ]
    }
  ]
}
