{
  "id": "grammar.a1.work.01.present-review",
  "title": "Present tense review",
  "sections": [
    {
      "type": "text",
      "title": "Talk about work",
      "content": "Use familiar present-tense verbs to say what you do at work and where you work."
    },
    {
      "type": "table",
      "title": "Work verbs",
      "rows": [
        [
          "I work.",
          "Trabajo."
        ],
        [
          "I study.",
          "Estudio."
        ],
        [
          "I speak Spanish.",
          "Hablo español."
        ],
        [
          "I write reports.",
          "Escribo informes."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Trabajo en una oficina.",
          "english": "I work in an office."
        },
        {
          "spanish": "Estudio por la mañana.",
          "english": "I study in the morning."
        },
        {
          "spanish": "Escribo informes.",
          "english": "I write reports."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Use the familiar present tense to describe regular work activities. The subject can often be omitted because the verb form shows who is acting."
    }
  ]
}
