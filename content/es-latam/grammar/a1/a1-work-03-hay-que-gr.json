{
  "id": "grammar.a1.work.03.hay-que",
  "title": "Hay que",
  "sections": [
    {
      "type": "text",
      "title": "Talk about general obligations",
      "content": "Use hay que + infinitive when something needs to be done in general, without naming a specific person."
    },
    {
      "type": "table",
      "title": "Hay que",
      "rows": [
        [
          "Hay que trabajar.",
          "You have to work."
        ],
        [
          "Hay que estudiar.",
          "It is necessary to study."
        ],
        [
          "Hay que llegar temprano.",
          "You have to arrive early."
        ],
        [
          "Hay que escribir.",
          "It is necessary to write."
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Hay que trabajar hoy.",
          "english": "You have to work today. / It is necessary to work today."
        },
        {
          "spanish": "Hay que llegar temprano.",
          "english": "You have to arrive early."
        },
        {
          "spanish": "Hay que estudiar.",
          "english": "You have to study."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Hay que is impersonal. Do not change hay according to the person: hay que trabajar, not *tienes que trabajar when you mean a general rule."
    }
  ]
}
