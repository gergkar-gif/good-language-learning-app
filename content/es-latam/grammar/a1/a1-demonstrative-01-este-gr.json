{
  "id": "grammar.a1.demonstrative.01.este",
  "title": "Demonstratives: This & These",
  "sections": [
    {
      "type": "text",
      "title": "Pointing Close by",
      "content": "Demonstrative adjectives point out specific objects in space. When an object is close to the speaker (here / *aquí*), use **este** (masculine singular), **esta** (feminine singular), **estos** (masculine plural), or **estas** (feminine plural)."
    },
    {
      "type": "table",
      "title": "Forms of este",
      "rows": [
        [
          "este libro",
          "this book (masculine singular)"
        ],
        [
          "esta manzana",
          "this apple (feminine singular)"
        ],
        [
          "estos libros",
          "these books (masculine plural)"
        ],
        [
          "estas manzanas",
          "these apples (feminine plural)"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Quiero este libro.",
          "english": "I want this book."
        },
        {
          "spanish": "Esta manzana es muy grande.",
          "english": "This apple is very big."
        },
        {
          "spanish": "Estos pantalones son nuevos.",
          "english": "These trousers are new."
        },
        {
          "spanish": "Estas camisas son nuevas.",
          "english": "These shirts are new."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Watch out for the masculine plural: it is **estos**, never *estes*!"
    }
  ]
}