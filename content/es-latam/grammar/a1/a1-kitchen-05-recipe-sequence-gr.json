{
  "id": "grammar.a1.kitchen.05.recipe-sequence",
  "title": "Imperatives + sequence",
  "sections": [
    {
      "type": "text",
      "title": "Follow a simple recipe",
      "content": "You know *primero* (Unit 1) and *después* and *luego* (Unit 7); *finalmente* is new. Use affirmative instructions with these sequence words to follow a short recipe."
    },
    {
      "type": "table",
      "title": "Sequence words",
      "rows": [
        [
          "primero",
          "first"
        ],
        [
          "después",
          "then"
        ],
        [
          "luego",
          "next"
        ],
        [
          "finalmente",
          "finally"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Primero, lava los tomates.",
          "english": "First, wash the tomatoes."
        },
        {
          "spanish": "Después, corta los tomates.",
          "english": "Then, cut the tomatoes."
        },
        {
          "spanish": "Luego, mezcla los ingredientes.",
          "english": "Next, mix the ingredients."
        },
        {
          "spanish": "Finalmente, come la ensalada.",
          "english": "Finally, eat the salad."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Sequence words make the order clear. Put the action after the sequence word: Primero, *corta*... Después, *mezcla*..."
    }
  ]
}
