{
  "id": "grammar.a2.imperativonegativo.03.formal",
  "title": "Negative Commands (usted / ustedes)",
  "sections": [
    {
      "type": "text",
      "content": "Good news: unlike informal 'tú' commands, formal commands for 'usted' and 'ustedes' use the EXACT SAME verb form in both affirmative and negative! You simply add 'no' in front."
    },
    {
      "type": "table",
      "title": "Formal Affirmative vs. Negative",
      "rows": [
        [
          "¡Hable! (Speak! - ud.)",
          "¡No hable! (Don't speak!)"
        ],
        [
          "¡Pase! (Come in! - ud.)",
          "¡No pase! (Do not enter!)"
        ],
        [
          "¡Firme! (Sign! - ud.)",
          "¡No firme todavía! (Don't sign yet!)"
        ],
        [
          "¡Fumen fuera! (uds.)",
          "¡No fumen aquí! (Don't smoke here!)"
        ],
        [
          "¡Hagan caso! (uds.)",
          "¡No hagan ruido! (Don't make noise!)"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Por favor, no pase sin permiso.",
          "english": "Please, do not enter without permission."
        },
        {
          "spanish": "Señores, no fumen en el edificio.",
          "english": "Gentlemen, do not smoke in the building."
        },
        {
          "spanish": "No se preocupe, señor.",
          "english": "Do not worry, sir."
        }
      ]
    }
  ]
}