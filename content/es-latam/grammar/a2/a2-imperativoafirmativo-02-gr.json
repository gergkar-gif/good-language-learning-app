{
  "id": "grammar.a2.imperativoafirmativo.02.irregulares",
  "title": "The 8 Irregular Affirmative Commands (tú)",
  "sections": [
    {
      "type": "text",
      "content": "There are exactly 8 irregular verbs in the affirmative informal (tú) imperative. All of them are short, one-syllable words that native speakers use constantly."
    },
    {
      "type": "table",
      "title": "The 8 Irregulars",
      "rows": [
        [
          "venir",
          "ven (come)"
        ],
        [
          "decir",
          "di (say/tell)"
        ],
        [
          "salir",
          "sal (leave/go out)"
        ],
        [
          "hacer",
          "haz (do/make)"
        ],
        [
          "tener",
          "ten (have/take)"
        ],
        [
          "ir",
          "ve (go)"
        ],
        [
          "poner",
          "pon (put/place)"
        ],
        [
          "ser",
          "sé (be)"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "¡Ven aquí ahora mismo!",
          "english": "Come here right now!"
        },
        {
          "spanish": "Haz la tarea antes de cenar.",
          "english": "Do your homework before dinner."
        },
        {
          "spanish": "Ten cuidado en la calle.",
          "english": "Be careful in the street."
        },
        {
          "spanish": "Di la verdad siempre.",
          "english": "Always tell the truth."
        }
      ]
    },
    {
      "type": "tip",
      "content": "Mnemonic memory trick: 'Vin Diesel has ten weapons' -> Ven Di Sal Haz Ten Ve Pon Sé."
    }
  ]
}