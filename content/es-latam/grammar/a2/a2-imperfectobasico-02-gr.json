{
  "id": "grammar.a2.imperfectobasico.02.morfologia-er-ir",
  "title": "Imperfecto: -ER and -IR Verb Endings",
  "sections": [
    {
      "type": "text",
      "content": "-ER and -IR verbs share the same imperfecto endings. Remove the infinitive ending and add -ía, -ías, -ía, -íamos, -íais, -ían. All forms carry a written accent on the í."
    },
    {
      "type": "table",
      "title": "comer (to eat)",
      "rows": [
        [
          "yo",
          "comía"
        ],
        [
          "tú",
          "comías"
        ],
        [
          "él/ella/usted",
          "comía"
        ],
        [
          "nosotros",
          "comíamos"
        ],
        [
          "ellos/ustedes",
          "comían"
        ]
      ]
    },
    {
      "type": "table",
      "title": "vivir (to live)",
      "rows": [
        [
          "yo",
          "vivía"
        ],
        [
          "tú",
          "vivías"
        ],
        [
          "él/ella/usted",
          "vivía"
        ],
        [
          "nosotros",
          "vivíamos"
        ],
        [
          "ellos/ustedes",
          "vivían"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "spanish": "Ana vivía en un piso pequeño.",
          "english": "Ana used to live in a small flat."
        },
        {
          "spanish": "Leíamos libros todos los veranos.",
          "english": "We used to read books every summer."
        },
        {
          "spanish": "¿Qué comías de niño?",
          "english": "What did you use to eat as a child?"
        }
      ]
    },
    {
      "type": "tip",
      "content": "Unlike -AR verbs (-aba), -ER/-IR use -ía. The accent on í is always written — even in nosotros (-íamos)."
    }
  ]
}
