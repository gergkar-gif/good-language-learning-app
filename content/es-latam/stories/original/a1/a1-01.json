  "paragraphs": [
    {
      "type": "narration",
      "lang": "en",
      "text": "Carlos is from Hungary, but he lives in Hanoi now. Today he arrives at a Mexican restaurant for a language exchange."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "At a small table, a young woman looks up with a friendly smile."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¡Hola! Buenos días, señor. Buenas tardes si ya es tarde aquí."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Buenos días. Por favor, ¿aquí es el intercambio de español?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Sí, aquí es. Yo soy Meg. ¿Cómo te llamas? ¿Cuál es tu nombre?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Me llamo Carlos. Mucho gusto, Meg. Encantado de conocer a una persona tan amable."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¡Mucho gusto, Carlos! Encantada. ¿De qué país eres? ¿De dónde eres?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Soy de Hungría. También soy nuevo aquí en la ciudad de Hanói, en Vietnam. ¿Y tú?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Soy de Sudáfrica. No soy de España, pero me gusta mucho el español."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "A friendly waiter arrives at the table to welcome them."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Muchas gracias, señor. Todo está muy bien."
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¿Quién eres en Hanói, Carlos? ¿Eres chico estudiante o trabajas?"
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Soy un chico estudiante. Ahora estudio español. ¿Y tú, chica?"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "Yo también soy estudiante. Primero practicamos un poco y después comemos tacos."
    },
    {
      "type": "narration",
      "lang": "en",
      "text": "They spend a delightful hour talking and practicing together until evening falls."
    },
    {
      "type": "dialogue",
      "speaker": "Carlos",
      "text": "Buenas noches, Meg. Muchas gracias por la conversación. ¡Hasta luego!"
    },
    {
      "type": "dialogue",
      "speaker": "Meg",
      "text": "¡Hasta mañana, Carlos! Adiós y gracias."
    }
  ],
