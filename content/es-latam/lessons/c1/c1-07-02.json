{
  "id": "lesson.c1.07.02",
  "title": "Cuyo: Possession in Formal Sentences",
  "level": "C1",
  "goal": "Use cuyo, cuya, cuyos and cuyas to attach a possession to a person or thing in formal sentences about procedures.",
  "grammar": "possession with cuyo",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can attach a possession to a person or thing in a formal sentence with *cuyo*, *cuya*, *cuyos* and *cuyas*.",
        "I can make *cuyo* agree with the thing possessed, not with the owner.",
        "I can avoid *que su* in place of *cuyo*."
      ]
