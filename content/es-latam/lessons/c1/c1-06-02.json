{
  "id": "lesson.c1.06.02",
  "title": "The Future Subjunctive: Reading Old Legal Texts",
  "level": "C1",
  "goal": "Recognise the future subjunctive (hablare, fuere, hubiere) in old legal texts and fixed phrases, and give its modern equivalent.",
  "grammar": "the future subjunctive, for recognition",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can recognise the future subjunctive (*hablare*, *comiere*, *fuere*, *hubiere*) in an old legal text.",
        "I can give the modern equivalent: the present subjunctive or the present indicative.",
        "I can tell *hablare* from *hablaré* and *hablara*."
      ]
