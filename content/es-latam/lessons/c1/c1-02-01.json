{
  "id": "lesson.c1.02.01",
  "title": "Que or De Que: Two Common Errors",
  "level": "C1",
  "goal": "Choose between que and de que after verbs, nouns and adjectives, and avoid the two errors that mark careless writing.",
  "grammar": "dequeísmo and queísmo",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can tell when a verb, noun or adjective needs *de* before *que*.",
        "I can correct *pienso de que* and *me alegro que* in a text.",
        "I can write *estoy seguro de que* and *me di cuenta de que* in sentences of my own."
      ]
