{
  "id": "lesson.c1.20.05",
  "title": "Balanced Judgement in Speech and Columns",
  "level": "C1",
  "goal": "Weigh pros and cons with contrast markers and read an opinion column on a city tram",
  "grammar": "contrast-markers",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can distinguish *ahora bien*, *no obstante*, *en cambio* and *por el contrario* in balanced arguments.",
        "I can use verdict and fairness expressions like *sopesar*, *todo hay que decirlo* and *a fin de cuentas*.",
        "I can follow an opinion column that combines concessions, evaluative clauses and balanced judgement."
      ]
