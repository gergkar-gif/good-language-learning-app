{
  "id": "lesson.c1.22.05",
  "title": "The Voice of a Crónica: Stance and Atmosphere",
  "level": "C1",
  "goal": "Use stance adverbs to shape a personal voice and read a *crónica* of a Saturday market",
  "grammar": "stance-adverbs",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can distinguish sentence-level stance adverbs (*Curiosamente, ...*, *Irónicamente, ...*) from manner adverbs.",
        "I can use market and atmosphere vocabulary like *el pregón*, *regatear*, *el vuelto* and *cálido*.",
        "I can follow a *crónica* that blends evaluative suffixes, relative clauses and a warm, ironic voice."
      ]
