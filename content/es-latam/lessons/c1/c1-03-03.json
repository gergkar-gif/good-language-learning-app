{
  "id": "lesson.c1.03.03",
  "title": "How Sure Is the Result?",
  "level": "C1",
  "goal": "Show how sure you are of a result with modal verbs, and name or rule out its cause.",
  "grammar": "degrees of certainty in results",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can say how sure I am of a result with *tener que*, *deber de* and *poder*.",
        "I can name a likely cause with *tratarse de* and *deberse a*.",
        "I can rule a cause out with *no poder*, and point to a past cause with *haber* and a participle."
      ]
