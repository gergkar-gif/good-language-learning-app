{
  "id": "lesson.c1.01.04",
  "title": "Restating and Defining with Precision",
  "level": "C1",
  "goal": "Restate, correct, narrow and define in an academic argument.",
  "grammar": "reformulation and precision in definitions",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can restate an idea with *esto es* and correct it with *mejor dicho*.",
