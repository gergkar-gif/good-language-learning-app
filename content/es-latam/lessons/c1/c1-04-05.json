{
  "id": "lesson.c1.04.05",
  "title": "Attribution and Distance",
  "level": "C1",
  "goal": "Attribute and hedge claims in a news report, and read a report that separates what is confirmed from what is not.",
  "grammar": "attribution and distance in the news",
  "sections": [
    {
      "type": "goal",
      "items": [
        "I can attribute a claim to a source and report it with distance (*según los bomberos*, *parece que*).",
        "I can mark a claim as attributed but not proved with *supuestamente* and *presuntamente*.",
        "I can follow a news report and tell what is confirmed from what is not."
      ]
