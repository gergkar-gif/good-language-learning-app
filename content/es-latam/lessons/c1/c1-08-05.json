{
  "id": "lesson.c1.08.05",
  "title": "Interpreting Data With Caution",
  "level": "C1",
  "goal": "Hedge demographic claims with modal probability and cautious verbs, and read a regional data report.",
  "grammar": "hedging and modal probability in data interpretation",
  "sections": [
