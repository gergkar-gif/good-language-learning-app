  "title": "Still Doing It: Continuity Periphrases",
  "level": "A2",
  "goal": "Say that an action or a state continues with seguir + gerundio and seguir sin + infinitivo.",
  "grammar": "seguir + gerundio y seguir sin + infinitivo",
