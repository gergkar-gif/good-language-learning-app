@@ -1,35 +1,59 @@
 {
   "id": "grammar.b1.guerrafria.03.no-cabe-duda-de-que",
-  "title": "No cabe duda de que: afirmar con seguridad",
+  "title": "The gerund: two actions at the same time",
   "sections": [
     {
       "type": "text",
-      "content": "*No cabe duda de que* (there is no doubt that) is a strong, formal way to assert a claim as settled fact -- and, unlike es cuestionable que, it takes the indicative, since it's affirming rather than evaluating uncertainty. It fits the historian's confident tone when the evidence for a claim is genuinely overwhelming. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know the gerund for actions that happen at the same time from B1 Unit 2 (*Llegó corriendo*, *Volvimos a casa cantando*) and *estar* + gerund from A1 Unit 19. The gerund says what the subject of the main verb is doing while the main action happens. It does not change for person, tense, gender or number."
+    },
+    {
+      "type": "table",
+      "title": "Gerunds on the topic",
+      "rows": [
+        [
+          "planear → planeando",
+          "planning"
+        ],
+        [
+          "esperar → esperando",
+          "waiting"
+        ],
+        [
+          "responder → respondiendo",
+          "answering"
+        ],
+        [
+          "participar → participando",
+          "taking part"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "No cabe duda de que el ejemplo cubano y la lógica de la Guerra Fría empujaron a la política latinoamericana hacia una polarización cada vez más extrema.",
-          "english": "There is no doubt that the Cuban example and Cold War logic pushed Latin American politics toward increasingly extreme polarization."
+          "spanish": "Los guerrilleros pasaban meses en las montañas, planeando ataques.",
+          "english": "The guerrilla fighters spent months in the mountains, planning attacks."
         },
         {
-          "spanish": "No cabe duda de que muchos militares latinoamericanos adoptaron lo que se conocería como la Doctrina de Seguridad Nacional.",
-          "english": "There is no doubt that many Latin American militaries adopted what would become known as the National Security Doctrine."
+          "spanish": "Los oficiales estudiaban en la escuela, aprendiendo técnicas militares.",
+          "english": "The officers studied at the school, learning military techniques."
         },
         {
-          "spanish": "No cabe duda de que esta polarización también radicalizó, en sentido contrario, a sectores de la izquierda latinoamericana.",
-          "english": "There is no doubt that this polarization also radicalized, in the opposite direction, sectors of the Latin American left."
+          "spanish": "Algunos grupos respondieron con violencia, radicalizándose cada vez más.",
+          "english": "Some groups answered with violence, becoming more and more radical."
         },
         {
-          "spanish": "No cabe duda de que esta dinámica de polarización extrema resultaría extraordinariamente costosa para la región.",
-          "english": "There is no doubt that this dynamic of extreme polarization would prove extraordinarily costly for the region."
+          "spanish": "Otros buscaron el cambio participando en elecciones y en sindicatos.",
+          "english": "Others sought change by taking part in elections and in unions."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*No cabe duda de que* + indicative sits at the opposite end of the certainty scale from es cuestionable que + subjunctive, which you learned earlier -- the two phrases let a writer signal exactly how confident they are in a claim, just by choosing which one to use."
+      "content": "The gerund always shares its subject with the main verb: in *Los oficiales estudiaban aprendiendo técnicas*, the officers both studied and learned. If the two actions have different subjects, use *mientras* or *cuando* instead."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-guerrafria-04-so-pretexto-de-gr.json b/content/es-latam/grammar/b1/b1-guerrafria-04-so-pretexto-de-gr.json
