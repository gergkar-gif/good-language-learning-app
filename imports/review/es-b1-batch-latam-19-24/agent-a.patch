diff --git a/content/es-latam/grammar/b1/b1-industrializacion-01-no-fue-hasta-que-gr.json b/content/es-latam/grammar/b1/b1-industrializacion-01-no-fue-hasta-que-gr.json
index b4bf8afc..95d060ab 100644
--- a/content/es-latam/grammar/b1/b1-industrializacion-01-no-fue-hasta-que-gr.json
+++ b/content/es-latam/grammar/b1/b1-industrializacion-01-no-fue-hasta-que-gr.json
@@ -1,35 +1,35 @@
 {
   "id": "grammar.b1.industrializacion.01.no-fue-hasta-que",
-  "title": "No fue hasta que: precisar cuándo ocurrió algo",
+  "title": "Debido a and a raíz de: giving the cause",
   "sections": [
     {
       "type": "text",
-      "content": "*No fue hasta que* (it wasn't until that) pinpoints the exact moment something finally happened, correcting an assumption that it happened earlier -- ideal for showing that ISI only became truly dominant once World War II forced the issue, not simply because of the 1929 crisis alone. With a real past event, it takes the indicative. These sentences are taken directly from the previous reading."
+      "content": "You know *debido a* and *a raíz de* from B1 Unit 6. Both mean \"because of\" and are followed by a noun, not by a verb. They are the formal way to give the cause of a big change, which is what historians do when they explain why Latin American countries began to make things at home."
     },
     {
       "type": "examples",
       "items": [
         {
-          "spanish": "La industrialización por sustitución de importaciones no fue hasta que estalló la Segunda Guerra Mundial, en 1939, que se convirtió realmente en el modelo dominante.",
-          "english": "Import substitution industrialization wasn't until World War II broke out, in 1939, that it truly became the dominant model."
+          "spanish": "Debido a la crisis de 1929, los países pudieron comprar menos productos del extranjero.",
+          "english": "Because of the crisis of 1929, the countries could buy fewer foreign products."
         },
         {
-          "spanish": "No fue hasta que las potencias industriales tradicionales volcaron toda su capacidad hacia el esfuerzo bélico que los países latinoamericanos se vieron forzados a fabricar por su cuenta.",
-          "english": "It wasn't until the traditional industrial powers poured all their capacity into the war effort that Latin American countries were truly forced to manufacture on their own."
+          "spanish": "A raíz de la Segunda Guerra Mundial, llegaron menos máquinas a la región.",
+          "english": "As a result of the Second World War, fewer machines reached the region."
         },
         {
-          "spanish": "No fue hasta el final de la guerra que los gobiernos de la región comprendieron plenamente el potencial de este modelo.",
-          "english": "It wasn't until the war's end that the region's governments fully understood this model's potential."
+          "spanish": "Los productos importados eran más caros debido a los aranceles.",
+          "english": "Imported products were more expensive because of the tariffs."
         },
         {
-          "spanish": "Este periodo en el que producir en casa dejó de ser una necesidad puramente coyuntural marcaría las siguientes tres décadas.",
-          "english": "This period, in which producing at home stopped being a purely temporary necessity, would mark the following three decades."
+          "spanish": "Debido a estas medidas, la industria creció en varios países.",
+          "english": "Because of these measures, industry grew in several countries."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*No fue hasta que* sets up a que clause later in the sentence with the real news -- read it as a two-part frame: \"it wasn't until X happened that Y finally did,\" always in that order."
+      "content": "After *debido a* and *a raíz de* put a noun (*la crisis*, *los aranceles*). Before a full clause use *porque* instead (*porque llegaban menos máquinas*). The phrase can open the sentence, followed by a comma, or come after the main clause."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-industrializacion-02-por-parte-de-gr.json b/content/es-latam/grammar/b1/b1-industrializacion-02-por-parte-de-gr.json
index 4ee733b9..c2b30de4 100644
--- a/content/es-latam/grammar/b1/b1-industrializacion-02-por-parte-de-gr.json
