@@ -1,35 +1,35 @@
 {
   "id": "grammar.b1.industrializacion.02.por-parte-de",
-  "title": "Por parte de: atribuir la acción en construcciones formales",
+  "title": "Mediante: how the state built industry",
   "sections": [
     {
       "type": "text",
-      "content": "*Por parte de* (on the part of, by) is the formal way to attribute an action to an agent inside a passive or noun-heavy sentence -- common in institutional and economic writing, and a natural fit for a reading about state-driven industrialization. These sentences are taken directly from the previous reading."
+      "content": "You know *mediante* (\"by means of\") from B1 Unit 24, a formal prepositional phrase of means. A noun follows it directly (not *mediante de*), and it often opens the sentence. Historians use it to say how governments built new industries: by means of tariffs, loans or state companies."
     },
     {
       "type": "examples",
       "items": [
         {
-          "spanish": "Se inauguró en Brasil, por parte del gobierno de Getúlio Vargas, la Companhia Siderúrgica Nacional.",
-          "english": "The Companhia Siderúrgica Nacional was inaugurated in Brazil by the government of Getúlio Vargas."
+          "spanish": "Mediante aranceles altos, los gobiernos hacían más caros los autos importados.",
+          "english": "By means of high tariffs, governments made imported cars more expensive."
         },
         {
-          "spanish": "Esta inversión, financiada en buena parte por parte del propio Estado brasileño, ilustraba el nuevo papel económico de muchos gobiernos.",
-          "english": "This investment, financed largely by the Brazilian state itself, illustrated the new economic role many governments had taken on."
+          "spanish": "El Estado ayudaba a las fábricas mediante créditos.",
+          "english": "The state helped the factories by means of loans."
         },
         {
-          "spanish": "Industrias similares fueron impulsadas por parte de prácticamente todos los gobiernos de la región.",
-          "english": "Similar industries were promoted by practically every government in the region."
+          "spanish": "Mediante estas ayudas, la industria creció.",
+          "english": "By means of this help, industry grew."
         },
         {
-          "spanish": "Gracias en gran medida al impulso sostenido por parte de estos gobiernos, países como Brasil ya contaban con sectores industriales complejos.",
-          "english": "Thanks in large part to the sustained push on the part of these governments, countries like Brazil already had complex industrial sectors."
+          "spanish": "Los gobiernos protegían la industria mediante impuestos a los productos extranjeros.",
+          "english": "Governments protected industry by means of taxes on foreign products."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*Por parte de* always names who is behind an action described more impersonally elsewhere in the sentence -- it pairs naturally with a passive verb (*fueron impulsadas por parte de...*) or a nominalized action (*el impulso por parte de...*), rarely with a simple active verb that already has its subject stated."
+      "content": "Say how something is done with *mediante* + noun, then give the result: *Mediante créditos, las fábricas compraron máquinas nuevas*. Do not add *de* after it: *mediante créditos*, never *mediante de créditos*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-industrializacion-03-no-dejar-de-gr.json b/content/es-latam/grammar/b1/b1-industrializacion-03-no-dejar-de-gr.json
index d2fae071..d04481a4 100644
--- a/content/es-latam/grammar/b1/b1-industrializacion-03-no-dejar-de-gr.json
+++ b/content/es-latam/grammar/b1/b1-industrializacion-03-no-dejar-de-gr.json
@@ -1,35 +1,35 @@
 {
   "id": "grammar.b1.industrializacion.03.no-dejar-de",
-  "title": "No dejar de + infinitivo: un proceso que no se detiene",
+  "title": "Dejar de + infinitive: leaving the countryside",
   "sections": [
     {
       "type": "text",
-      "content": "*No dejar de* + infinitive (to not stop doing something, to keep on doing it) stresses that a process ran continuously, without pause, across the whole period being described -- the natural way to narrate a migration wave that didn't just happen once but kept happening, decade after decade. These sentences are taken directly from the previous reading."
+      "content": "You know *dejar de* + infinitive from B1 Unit 12: it means to stop doing something you did before (*dejé de fumar*). With *no*, *no dejar de* + infinitive means to keep on doing it (*no dejo de cocinar en casa*). Both are useful for migration: what people stopped doing when they left the countryside, and what they kept doing."
     },
     {
       "type": "examples",
       "items": [
         {
-          "spanish": "Las nuevas fábricas no dejaron de atraer, década tras década, a millones de campesinos que abandonaban el campo.",
-          "english": "The new factories kept attracting, decade after decade, millions of peasants leaving the countryside."
+          "spanish": "Millones de personas dejaron de vivir en el campo.",
+          "english": "Millions of people stopped living in the countryside."
         },
         {
-          "spanish": "Ciudades como São Paulo, Ciudad de México y Buenos Aires no dejaron de crecer a un ritmo verdaderamente vertiginoso.",
-          "english": "Cities like São Paulo, Mexico City and Buenos Aires kept growing at a truly dizzying pace."
+          "spanish": "Muchos campesinos dejaron de trabajar la tierra y buscaron empleo en una fábrica.",
+          "english": "Many peasants stopped working the land and looked for a job in a factory."
         },
         {
-          "spanish": "Las ciudades receptoras no dejaron de enfrentar una contradicción fundamental entre infraestructura y crecimiento poblacional.",
-          "english": "Receiving cities kept facing a fundamental contradiction between infrastructure and population growth."
+          "spanish": "Muchos migrantes no dejaron de enviar dinero a su familia.",
+          "english": "Many migrants kept sending money to their family."
         },
         {
-          "spanish": "Esta migración masiva no dejaría de transformar el propio rostro demográfico de la región.",
-          "english": "This massive migration would keep transforming the region's very demographic face."
+          "spanish": "Las ciudades no dejaron de crecer.",
+          "english": "The cities kept growing."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*No dejar de* + infinitive is a double negative that reads as a strong positive -- \"didn't stop doing\" means \"kept doing, continuously\" -- so translate it as an ongoing action, never literally as an interruption."
+      "content": "*Dejar de* is always followed by an infinitive, never by a gerund or a noun: *dejaron de vivir*, not *dejaron de viviendo*. Use the preterite (*dejaron de*) for a change that happened at some point, and the imperfect for a habit that stopped slowly."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-industrializacion-04-por-mas-que-gr.json b/content/es-latam/grammar/b1/b1-industrializacion-04-por-mas-que-gr.json
