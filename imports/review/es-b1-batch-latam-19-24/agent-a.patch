@@ -1,35 +1,35 @@
 {
   "id": "grammar.b1.industrializacion.04.por-mas-que",
-  "title": "Por más que + subjuntivo: una desigualdad persistente",
+  "title": "Verbs of change: how the cities changed",
   "sections": [
     {
       "type": "text",
-      "content": "*Por más que* (no matter how much, however much) is a stronger, more emphatic cousin of *aunque*, and takes the subjunctive -- perfect for a reading whose whole point is that real change kept running into an equally real, stubborn limit. These sentences are taken directly from the previous reading."
+      "content": "You know *ponerse*, *volverse*, *hacerse*, *quedarse* and *convertirse en* from B1 Unit 25: *ponerse* + adjective is a change that can pass, *volverse* + adjective a deeper change, *hacerse* + noun a change by effort or with time, *quedarse* + adjective a result and *convertirse en* + noun a big change. They fit the new urban societies, where cities, neighbourhoods and classes changed."
     },
     {
       "type": "examples",
       "items": [
         {
-          "spanish": "Por más que la industrialización generara empleo industrial formal, una proporción todavía mayor de los recién llegados terminó en la economía informal.",
-          "english": "However much industrialization generated formal industrial jobs, an even larger share of newcomers ended up in the informal economy."
+          "spanish": "Con la migración, la ciudad se convirtió en un lugar muy distinto.",
+          "english": "With migration, the city became a very different place."
         },
         {
-          "spanish": "Por más que aumentara su participación laboral, los salarios de las mujeres permanecieron sistemáticamente por debajo de los de sus compañeros varones.",
-          "english": "However much their labor participation grew, women's wages stayed systematically below their male counterparts'."
+          "spanish": "Algunos barrios se hicieron más grandes con el tiempo.",
+          "english": "Some neighbourhoods grew bigger with time."
         },
         {
-          "spanish": "Por más que llegara inicialmente solo a una minoría con ingresos estables, esta cultura de consumo comenzó a definir nuevas aspiraciones compartidas.",
-          "english": "However much it initially reached only a minority with stable income, this consumer culture began to define new shared aspirations."
+          "spanish": "Los sindicatos se volvieron una fuerza importante en la política.",
+          "english": "The unions became an important force in politics."
         },
         {
-          "spanish": "Por más que estas transformaciones sociales resultaran genuinamente profundas, no lograron eliminar las viejas desigualdades heredadas.",
-          "english": "However genuinely profound these social transformations turned out to be, they failed to eliminate the old inherited inequalities."
+          "spanish": "Un hijo de campesinos se hizo ingeniero.",
+          "english": "A peasant's son became an engineer."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*Por más que* always takes the subjunctive, unlike *aunque*, which can take either mood depending on whether the point is granted as fact or hypothetically -- *por más que* is reserved specifically for this emphatic \"no matter how much\" concession."
+      "content": "Choose the verb by the kind of change: *convertirse en* + noun for a big change (*se convirtió en una ciudad grande*), *hacerse* for a change with time or effort (*se hizo ingeniero*, *se hizo más grande*), *volverse* for a deeper change. Always use the reflexive *se*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-industrializacion-05-pese-a-que-gr.json b/content/es-latam/grammar/b1/b1-industrializacion-05-pese-a-que-gr.json
