@@ -1,35 +1,55 @@
 {
   "id": "grammar.b1.gobiernosmilitares.04.no-obstante",
-  "title": "No obstante: un contraste formal",
+  "title": "Impersonal and passive se: what was closed, suspended and asked for",
   "sections": [
     {
       "type": "text",
-      "content": "*No obstante* (nevertheless, notwithstanding) is a more formal, written-register alternative to *sin embargo* -- common in historical and academic prose. It can open a sentence as a connector, or, less commonly, work like a preposition before a noun phrase (*no obstante* los intentos de...). These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know *se* with a verb from B1 Unit 6: *se prohibieron* leaves out who acted (*Se busca una persona*, *se buscan personas*). It is the natural way to list what a government did without naming everyone: what was closed, suspended or asked for."
+    },
+    {
+      "type": "table",
+      "title": "Se in the past",
+      "rows": [
+        [
+          "*Se cerró el Congreso.*",
+          "singular noun, singular verb"
+        ],
+        [
+          "*Se pidieron muchos préstamos.*",
+          "plural noun, plural verb"
+        ],
+        [
+          "*En octubre de 1983 se votó.*",
+          "no noun: singular verb"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Estas políticas económicas generaron, no obstante, un fuerte endeudamiento externo y una desindustrialización considerable.",
-          "english": "These economic policies nevertheless generated heavy external debt and considerable deindustrialization."
+          "spanish": "Se cerró el Congreso y se suspendió la actividad de los partidos políticos.",
+          "english": "Congress was closed and the activity of the political parties was suspended."
         },
         {
-          "spanish": "No obstante los intentos de mantenerse en el poder, la junta militar se vio obligada a convocar elecciones.",
-          "english": "Notwithstanding its attempts to remain in power, the military junta was forced to call elections."
+          "spanish": "Se pidieron muchos préstamos al exterior.",
+          "english": "Many loans were requested from abroad."
         },
         {
-          "spanish": "El régimen había prometido modernizar la economía; no obstante, los resultados finales estuvieron bastante alejados de esa promesa.",
-          "english": "The regime had promised to modernize the economy; nevertheless, the final results were quite far from that promise."
+          "spanish": "Se anunciaron elecciones, y en octubre de 1983 se votó.",
+          "english": "Elections were announced, and in October 1983 people voted."
         },
         {
-          "spanish": "La guerra fue breve; no obstante, sus consecuencias políticas resultarían decisivas para el futuro inmediato del país.",
-          "english": "The war was brief; nevertheless, its political consequences would prove decisive for the country's immediate future."
+          "spanish": "Se prohibieron los partidos políticos en varios países.",
+          "english": "Political parties were banned in several countries."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "As a connector between two clauses, *no obstante* usually sits between commas or starts a new sentence, just like *sin embargo*. Used before a noun (*no obstante* + noun), it means despite -- a more formal equivalent of a pesar de."
+      "content": "With a noun, the verb agrees with it: *se cerró el Congreso*, *se pidieron préstamos*. When nobody is named, the actor stays hidden; for the actor use an ordinary verb: *la junta cerró el Congreso*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-gobiernosmilitares-05-en-definitiva-gr.json b/content/es-latam/grammar/b1/b1-gobiernosmilitares-05-en-definitiva-gr.json
index 4ee9e970..d64d64fb 100644
--- a/content/es-latam/grammar/b1/b1-gobiernosmilitares-05-en-definitiva-gr.json
+++ b/content/es-latam/grammar/b1/b1-gobiernosmilitares-05-en-definitiva-gr.json
@@ -1,35 +1,55 @@
 {
   "id": "grammar.b1.gobiernosmilitares.05.en-definitiva",
-  "title": "En definitiva: cerrar una comparación",
+  "title": "Formal causes: debido a and a raíz de",
   "sections": [
     {
       "type": "text",
-      "content": "*En definitiva* (ultimately, in short) signals that a sentence is drawing together several previous points into one final conclusion -- a useful way to close a comparison after listing multiple examples or differences. It's a common closing move in synthesis writing. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know *debido a* and *a raíz de* from B1 Unit 6: they link a cause to a consequence, and they take a noun, never a verb (*debido a un error*). They suit the end of the military governments: what happened because of a crisis, a defeat or a vote."
+    },
+    {
+      "type": "table",
+      "title": "Cause connectors",
+      "rows": [
+        [
+          "*Debido a* + noun",
+          "because of: *debido a la crisis*"
+        ],
+        [
+          "*A raíz de* + noun",
+          "as a result of: *a raíz de la derrota*"
+        ],
+        [
+          "*porque* + verb",
+          "because: *porque había una crisis*"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "En definitiva, ningún régimen militar de la región logró sostenerse de manera indefinida.",
-          "english": "Ultimately, no military regime in the region managed to sustain itself indefinitely."
+          "spanish": "Debido a la crisis económica de comienzos de los años ochenta, muchos gobiernos perdieron apoyo.",
+          "english": "Because of the economic crisis of the early 1980s, many governments lost support."
         },
         {
-          "spanish": "Cada régimen tomó un camino distinto, pero, en definitiva, todos se enfrentaron a los mismos tipos de presión.",
-          "english": "Each regime took a different path, but ultimately, all of them faced the same kinds of pressure."
+          "spanish": "A raíz de la derrota en la guerra de las Malvinas, los militares argentinos dejaron el poder en 1983.",
+          "english": "As a result of the defeat in the Falklands/Malvinas war, the Argentine military left power in 1983."
         },
         {
-          "spanish": "En definitiva, la combinación de crisis económica y pérdida de legitimidad resultó, tarde o temprano, decisiva en cada caso.",
-          "english": "In the end, the combination of economic crisis and loss of legitimacy proved decisive, sooner or later, in every case."
+          "spanish": "A raíz del plebiscito de 1988, el régimen de Pinochet terminó en 1990.",
+          "english": "As a result of the plebiscite of 1988, Pinochet's regime ended in 1990."
         },
         {
-          "spanish": "En definitiva, comparar estos tres países muestra tanto lo que compartían como lo profundamente distintos que fueron sus finales.",
-          "english": "Ultimately, comparing these three countries shows both what they shared and how profoundly different their endings were."
+          "spanish": "Los militares perdieron apoyo porque había una crisis económica.",
+          "english": "The military lost support because there was an economic crisis."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*En definitiva* works best at the start of a concluding sentence, after several supporting points have already been given -- it signals I'm about to sum this all up, unlike *en definitiva*'s near-synonym *al fin y al cabo*, which leans more toward after all (justifying rather than concluding)."
+      "content": "After *debido a* and *a raíz de* put a noun phrase (*la derrota*, *la crisis*). If you want a verb, use *porque* (*porque perdieron la guerra*). Do not drop the *a* or the *de*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-guerrafria-01-ya-sea-ya-sea-gr.json b/content/es-latam/grammar/b1/b1-guerrafria-01-ya-sea-ya-sea-gr.json
