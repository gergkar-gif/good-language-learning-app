+++ b/content/es-latam/grammar/b1/b1-eeuu-02-mientras-tanto-gr.json
@@ -1,35 +1,51 @@
 {
   "id": "grammar.b1.eeuu.02.mientras-tanto",
-  "title": "Mientras tanto: dos historias que ocurren a la vez",
+  "title": "Cuando and mientras: events in the past",
   "sections": [
     {
       "type": "text",
-      "content": "*Mientras tanto* (meanwhile) signals that a second story was unfolding at the same time as the one just described -- useful when a reading needs to track several simultaneous occupations and resistance movements across different countries without losing the thread. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know *cuando* with the *indefinido* from A2 Unit 13: it joins one finished event to the moment when another happened. You also know *mientras* for two actions that go on at the same time, and the *indefinido* and the *imperfecto* from A2 Units 11 and 21. The history of the interventions mixes both: one event, and something else going on meanwhile."
+    },
+    {
+      "type": "table",
+      "title": "Two connectors",
+      "rows": [
+        [
+          "*cuando* + indefinido",
+          "one event, then another: *Cuando terminó la guerra, España entregó Puerto Rico.*"
+        ],
+        [
+          "*mientras* + imperfecto",
+          "two actions at the same time: *Mientras se construía el canal, llegaron trabajadores.*"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Mientras tanto, en Nicaragua, la presencia de tropas estadounidenses casi continua generó una resistencia armada liderada por Augusto César Sandino.",
-          "english": "Meanwhile, in Nicaragua, the almost continuous presence of American troops generated an armed resistance led by Augusto César Sandino."
+          "spanish": "Cuando terminó la guerra, España entregó Puerto Rico a Estados Unidos.",
+          "english": "When the war ended, Spain handed Puerto Rico over to the United States."
         },
         {
-          "spanish": "Mientras estas ocupaciones directas se desarrollaban en el Caribe y Centroamérica, Estados Unidos completaba la construcción del Canal de Panamá.",
-          "english": "While these direct occupations were unfolding in the Caribbean and Central America, the United States was completing construction of the Panama Canal."
+          "spanish": "Mientras Cuba luchaba por su independencia, Estados Unidos entró en el conflicto.",
+          "english": "While Cuba was fighting for its independence, the United States entered the conflict."
         },
         {
-          "spanish": "Mientras tanto, la propia Panamá se había independizado de Colombia en 1903, con apoyo militar estadounidense decisivo.",
-          "english": "Meanwhile, Panama itself had become independent from Colombia in 1903, with decisive American military support."
+          "spanish": "Mientras se construía el canal, llegaron a Panamá muchos trabajadores.",
+          "english": "While the canal was being built, many workers arrived in Panama."
         },
         {
-          "spanish": "Este periodo demostró que la voluntad de intervenir directamente en la región no dependía de la existencia previa de una amenaza comunista.",
-          "english": "This period showed that the will to intervene directly in the region didn't depend on the prior existence of a communist threat."
+          "spanish": "Cuando los marines salieron de Nicaragua en 1933, terminó la guerrilla de Sandino.",
+          "english": "When the marines left Nicaragua in 1933, Sandino's guerrilla war came to an end."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*Mientras* (without *tanto*) directly precedes a clause with its own verb -- *mientras estas ocupaciones se desarrollaban* -- while *mientras tanto* stands alone as a sentence connector, usually right after a comma or at the start of a new sentence."
+      "content": "*Cuando* + *indefinido* often gives the starting point or result of a main event; *mientras* + *imperfecto* gives the background that was going on. With *cuando* at the start of the sentence, put a comma after its clause."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-eeuu-03-cuanto-mas-gr.json b/content/es-latam/grammar/b1/b1-eeuu-03-cuanto-mas-gr.json
index 1cb91f44..53f36919 100644
--- a/content/es-latam/grammar/b1/b1-eeuu-03-cuanto-mas-gr.json
+++ b/content/es-latam/grammar/b1/b1-eeuu-03-cuanto-mas-gr.json
@@ -1,35 +1,59 @@
 {
   "id": "grammar.b1.eeuu.03.cuanto-mas",
-  "title": "Cuanto más... (tanto) más: relaciones que crecen juntas",
+  "title": "Relative clauses with a preposition: companies and economies",
   "sections": [
     {
       "type": "text",
-      "content": "*Cuanto más*... (*tanto*) *más* links two things that grow or shrink together -- the more X, the more Y. The second *tanto* is optional and often dropped in speech. This structure is common in historical writing to describe cause-and-effect relationships that intensify over time. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know relative clauses with a preposition, such as *del que*, from B1 Unit 20 (*un servicio del que dependen muchas personas*, *el edificio en el que vivimos*). Put the preposition before *el que*, *la que*, *los que* or *las que*, matching the noun. Economic history needs them often: what a country depends on, what it sells, who gives it loans."
+    },
+    {
+      "type": "table",
+      "title": "Preposition + article + que",
+      "rows": [
+        [
+          "el producto del que dependía la economía",
+          "the product that the economy depended on"
+        ],
+        [
+          "los bancos con los que pagaban obras",
+          "the banks with which they paid for public works"
+        ],
+        [
+          "los países ricos, a los que vendían materias primas",
+          "the rich countries, to which they sold raw materials"
+        ],
+        [
+          "los países de los que compraban productos industriales",
+          "the countries from which they bought industrial products"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Cuanto más dependía un país de un solo producto de exportación, tanto más vulnerable se volvía frente a las decisiones tomadas en Nueva York o Boston.",
-          "english": "The more a country depended on a single export product, the more vulnerable it became to decisions made in New York or Boston."
+          "spanish": "El banano era el producto del que dependía la economía de varios países pequeños.",
+          "english": "Bananas were the product on which the economy of several small countries depended."
         },
         {
-          "spanish": "Cuanto más control ejercían las empresas estadounidenses sobre un sector, más difícil era para el gobierno local intervenir en él.",
-          "english": "The more control American companies exercised over a sector, the harder it was for the local government to intervene in it."
+          "spanish": "Pedían préstamos a bancos con los que pagaban obras y deudas.",
+          "english": "They asked banks for loans with which they paid for public works and debts."
         },
         {
-          "spanish": "Cuanto mayor era la deuda externa de un país, tanto mayor era también la influencia de sus acreedores estadounidenses sobre sus decisiones internas.",
-          "english": "The greater a country's external debt, the greater the influence of its American creditors over its internal decisions as well."
+          "spanish": "Los países pobres vendían materias primas a los países ricos, de los que compraban productos industriales.",
+          "english": "Poor countries sold raw materials to rich countries, from which they bought industrial goods."
         },
         {
-          "spanish": "Cuanto menos diversificada estaba una economía, tanto más se parecía su destino económico al de una sola empresa extranjera.",
-          "english": "The less diversified an economy was, the more its economic fate resembled that of a single foreign company."
+          "spanish": "La empresa de la que hablaban los economistas tenía plantaciones de banano.",
+          "english": "The company the economists talked about had banana plantations."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "Use *cuanto* (not *cuánto*) here -- no accent, because it's a relative connector, not a question word. Adjectives inside this structure still agree: *cuanto más vulnerable*, *cuanta mayor influencia*."
+      "content": "The article agrees with the noun you describe (*el producto del que*, *los países de los que*), and the preposition is the one the verb needs: *depender de*, *pagar con*, *vender a*. Never drop it: not *el producto que dependía*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-eeuu-04-a-raiz-de-gr.json b/content/es-latam/grammar/b1/b1-eeuu-04-a-raiz-de-gr.json
index a6ab5a75..cd50a7a7 100644
--- a/content/es-latam/grammar/b1/b1-eeuu-04-a-raiz-de-gr.json
+++ b/content/es-latam/grammar/b1/b1-eeuu-04-a-raiz-de-gr.json
@@ -1,35 +1,59 @@
 {
   "id": "grammar.b1.eeuu.04.a-raiz-de",
-  "title": "A raíz de: el origen de un cambio",
+  "title": "Verbal periphrases: starting, stopping, repeating, continuing",
   "sections": [
     {
       "type": "text",
-      "content": "*A raíz de* (as a result of, stemming from) introduces the event or situation that triggered a later change -- useful for explaining why a policy lost momentum or a program was wound down over time. It's followed by a noun phrase, not a full clause. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know the periphrases *empezar a*, *dejar de* and *volver a* + infinitive, and *seguir* + gerund, from A2 Unit 28. They show a phase of an action: it starts, stops, happens again or continues. They are ideal for telling how a programme began, lost strength or went on."
+    },
+    {
+      "type": "table",
+      "title": "Four periphrases",
+      "rows": [
+        [
+          "*empezar a* + infinitive",
+          "to begin to: *empezaron a construir casas*"
+        ],
+        [
+          "*dejar de* + infinitive",
+          "to stop: *el programa dejó de funcionar*"
+        ],
+        [
+          "*volver a* + infinitive",
+          "to do again: *volvió a dar más valor a la seguridad*"
+        ],
+        [
+          "*seguir* + gerund",
+          "to keep on: *seguían protegiendo a los grupos ricos*"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "A raíz de estos resultados decepcionantes, el entusiasmo estadounidense por el programa comenzó a disminuir de forma notable.",
-          "english": "As a result of these disappointing results, American enthusiasm for the program began to noticeably decline."
+          "spanish": "Algunos países empezaron a construir casas y escuelas con esa ayuda.",
+          "english": "Some countries began to build houses and schools with that aid."
         },
         {
-          "spanish": "A raíz de la guerra de Vietnam, Washington destinó cada vez menos atención y recursos a los programas de desarrollo en América Latina.",
-          "english": "As a result of the Vietnam War, Washington devoted less and less attention and resources to development programs in Latin America."
+          "spanish": "A principios de los años setenta el programa dejó de funcionar.",
+          "english": "In the early 1970s the programme stopped working."
         },
         {
-          "spanish": "A raíz del cambio de administración en 1969, la Alianza para el Progreso perdió gradualmente su identidad propia.",
-          "english": "As a result of the change of administration in 1969, the Alliance for Progress gradually lost its own identity."
+          "spanish": "El gobierno de Estados Unidos volvió a dar más valor a la seguridad.",
+          "english": "The US government once again gave more value to security."
         },
         {
-          "spanish": "A raíz de este final relativamente silencioso, muchos historiadores debaten hoy si el programa cumplió realmente sus metas originales.",
-          "english": "As a result of this relatively quiet end, many historians today debate whether the program actually met its original goals."
+          "spanish": "Los historiadores siguen discutiendo si el programa fracasó.",
+          "english": "Historians keep on discussing whether the programme failed."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "Don't confuse *a raíz de* with *a causa de* -- *a raíz de* emphasizes that something is the starting point of a chain of consequences, while *a causa de* simply states a reason. *A raíz de* works especially well at the start of a sentence about a turning point."
+      "content": "The first verb carries the tense and the person (*empezaron*, *dejó*); the second stays in the infinitive, or in the gerund after *seguir*. Use *a* after *empezar* and *volver*, and *de* after *dejar*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-eeuu-05-asi-como-gr.json b/content/es-latam/grammar/b1/b1-eeuu-05-asi-como-gr.json
index 95f35c1d..6d6ffa87 100644
--- a/content/es-latam/grammar/b1/b1-eeuu-05-asi-como-gr.json
+++ b/content/es-latam/grammar/b1/b1-eeuu-05-asi-como-gr.json
@@ -1,35 +1,59 @@
 {
   "id": "grammar.b1.eeuu.05.asi-como",
-  "title": "Así como: comparar y sumar elementos paralelos",
+  "title": "Argument markers: building and closing an argument",
   "sections": [
     {
       "type": "text",
-      "content": "*Así como* can mean just as (drawing a parallel between two situations) or as well as (adding a second parallel item to a first). It's a flexible connector for synthesis writing, where several related ideas need to be tied together smoothly. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know *en resumen* and *lo más importante es que* for building and closing an argument from B1 Unit 13 and ordering markers such as *en primer lugar* and *además* from A2 Unit 28. A summary of a long relationship uses them to open the argument, add a point and close it."
+    },
+    {
+      "type": "table",
+      "title": "Markers for an argument",
+      "rows": [
+        [
+          "*En primer lugar*, …",
+          "first point"
+        ],
+        [
+          "*Además*, …",
+          "an extra point"
+        ],
+        [
+          "*En resumen*, …",
+          "closing summary"
+        ],
+        [
+          "*Lo más importante es que* …",
+          "the main idea"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Millones de personas cruzaron la frontera entre ambos mundos, así como ideas, música, literatura y tecnología circularon en ambas direcciones.",
-          "english": "Millions of people crossed the border between both worlds, just as ideas, music, literature, and technology circulated in both directions."
+          "spanish": "En primer lugar, hubo intervenciones militares y una fuerte dependencia económica.",
+          "english": "First, there were military interventions and a strong economic dependence."
         },
         {
-          "spanish": "La migración latinoamericana hacia Estados Unidos, así como la inversión y el turismo estadounidenses hacia América Latina, crearon vínculos profundos.",
-          "english": "Latin American migration to the United States, as well as American investment and tourism toward Latin America, created deep ties."
+          "spanish": "Además, hubo muchas relaciones que no eran políticas.",
+          "english": "In addition, there were many relations that were not political."
         },
         {
-          "spanish": "La relación entre Estados Unidos y América Latina fue, así como sigue siendo hoy, tan compleja como profundamente entrelazada.",
-          "english": "The relationship between the United States and Latin America was, just as it continues to be today, as complex as it was deeply intertwined."
+          "spanish": "En resumen, la relación fue desigual, pero no fue solo de dominación.",
+          "english": "In summary, the relationship was unequal, but it was not only one of domination."
         },
         {
-          "spanish": "Los historiadores reconocen la cooperación real que existió, así como los episodios innegables de intervención y dependencia económica.",
-          "english": "Historians acknowledge the real cooperation that existed, as well as the undeniable episodes of intervention and economic dependency."
+          "spanish": "Lo más importante es que hubo poder y dependencia, y también cultura compartida.",
+          "english": "The most important thing is that there was power and dependence, and also shared culture."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*Así como* sits between two parallel elements, not at the start of a sentence introducing a single idea -- if you want just as at the start of a sentence, use *tal como* or *de la misma manera que* instead."
+      "content": "Choose the marker by its job: *en primer lugar* opens, *además* adds, *en resumen* closes. After *lo más importante es que* use a full clause with its own verb."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-gobiernosmilitares-01-mas-bien-gr.json b/content/es-latam/grammar/b1/b1-gobiernosmilitares-01-mas-bien-gr.json
