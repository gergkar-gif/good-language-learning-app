@@ -1,35 +1,59 @@
 {
   "id": "grammar.b1.guerrafria.01.ya-sea-ya-sea",
-  "title": "Ya sea... ya sea: presentar dos opciones formales",
+  "title": "Relative clauses: the two blocs",
   "sections": [
     {
       "type": "text",
-      "content": "*Ya sea*... *ya sea* (whether... or, be it... or) formally presents two alternative methods or paths without ranking one above the other -- a natural fit for describing how the superpowers pursued the same goal (containment, expansion of influence) through more than one channel at once. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know relative clauses with *que* and *quien* from B1 Unit 5 (*La amiga que vive al lado*, *el vecino con quien hablamos*). They add information about a person, a thing or a place without starting a new sentence. The Cold War is full of such descriptions: the superpowers, the blocs and the policies that divided them."
+    },
+    {
+      "type": "table",
+      "title": "Que and quien at work",
+      "rows": [
+        [
+          "Estados Unidos, que defendía el capitalismo",
+          "the United States, which defended capitalism"
+        ],
+        [
+          "la política que quería frenar el comunismo",
+          "the policy that wanted to halt communism"
+        ],
+        [
+          "los países que veían una amenaza en el comunismo",
+          "the countries that saw a threat in communism"
+        ],
+        [
+          "Truman, quien había llegado al cargo en 1945",
+          "Truman, who had come into office in 1945"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Ya sea a través de alianzas militares formales, ya sea mediante ayuda económica condicionada, ambas superpotencias buscaron sumar países a su propio bloque.",
-          "english": "Whether through formal military alliances or through conditional economic aid, both superpowers sought to add countries to their own bloc."
+          "spanish": "La Unión Soviética, que defendía el comunismo, dirigía el otro bloque.",
+          "english": "The Soviet Union, which defended communism, led the other bloc."
         },
         {
-          "spanish": "Debía impedirse, ya sea mediante presión diplomática, ya sea mediante intervención militar directa, la expansión del comunismo.",
-          "english": "The expansion of communism had to be prevented, whether through diplomatic pressure or through direct military intervention."
+          "spanish": "La OTAN es una alianza militar que unió en 1949 a Estados Unidos con varios países de Europa.",
+          "english": "NATO is a military alliance that in 1949 united the United States with several European countries."
         },
         {
-          "spanish": "Ambas superpotencias poseían arsenales capaces de destruir, ya sea de manera directa, ya sea a través de sus efectos posteriores, la civilización humana varias veces.",
-          "english": "Both superpowers possessed arsenals capable of destroying human civilization several times over, whether directly or through their aftereffects."
+          "spanish": "La contención fue una política que quería frenar el comunismo.",
+          "english": "Containment was a policy that wanted to halt communism."
         },
         {
-          "spanish": "La región se convirtió, casi inevitablemente, en uno de los escenarios más activos de la Guerra Fría.",
-          "english": "The region became, almost inevitably, one of the most active stages of the Cold War."
+          "spanish": "El presidente Truman, quien había llegado al cargo en 1945, prometió ayuda.",
+          "english": "President Truman, who had come into office in 1945, promised help."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*Ya sea* stays invariable in both slots (never ya sean, even with a plural noun following) -- it's a fixed connector, not a verb agreeing with what comes after it."
+      "content": "*Que* does not change for gender or number: *la alianza que*, *los bloques que*. With a comma, the clause adds extra information (*Estados Unidos, que defendía el capitalismo, …*). Without a comma, it says which one you mean (*los países que veían una amenaza*). *Quien* is for people only, mostly after a comma or a preposition."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-guerrafria-02-con-tal-de-que-gr.json b/content/es-latam/grammar/b1/b1-guerrafria-02-con-tal-de-que-gr.json
