--- a/content/es-latam/grammar/b1/b1-gobiernosmilitares-01-mas-bien-gr.json
+++ b/content/es-latam/grammar/b1/b1-gobiernosmilitares-01-mas-bien-gr.json
@@ -1,35 +1,55 @@
 {
   "id": "grammar.b1.gobiernosmilitares.01.mas-bien",
-  "title": "Más bien: matizar en vez de simplemente contrastar",
+  "title": "Contrast and concession: what the military said and what they did",
   "sections": [
     {
       "type": "text",
-      "content": "*Más bien* (rather) corrects or refines a claim instead of flatly opposing it -- useful when a reading needs to say something wasn't quite X, it was actually Y. It's gentler than *sino*, which requires an explicit negation just before it. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know *sin embargo* and *no obstante* from B1 Unit 1, and *aunque* from A2 Unit 28. They set one fact against another. The history of the military governments is full of such contrasts: what the generals promised and what they did, or how one government differed from another."
+    },
+    {
+      "type": "table",
+      "title": "Three connectors",
+      "rows": [
+        [
+          "*Sin embargo*, …",
+          "however: starts a new sentence, comma after it"
+        ],
+        [
+          "*No obstante*, …",
+          "nevertheless: more formal than *sin embargo*"
+        ],
+        [
+          "*Aunque* + verb",
+          "although: joins two clauses in one sentence"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Estos regímenes no eran, más bien, una simple repetición de los golpes militares del siglo diecinueve.",
-          "english": "These regimes weren't, rather, a simple repetition of the nineteenth-century military coups."
+          "spanish": "Los militares decían que querían defender el orden. Sin embargo, no devolvieron el poder pronto.",
+          "english": "The military said they wanted to defend order. However, they did not give power back soon."
         },
         {
-          "spanish": "No se trataba de un caudillo gobernando solo; más bien, eran las propias fuerzas armadas tomando el poder como institución.",
-          "english": "It wasn't a caudillo governing alone; rather, it was the armed forces themselves taking power as an institution."
+          "spanish": "Aunque era un gobierno militar, su programa era de izquierda.",
+          "english": "Although it was a military government, its programme was of the left."
         },
         {
-          "spanish": "La represión no respondía a una amenaza real, sino que se apoyaba, más bien, en una ideología que veía enemigos en toda la sociedad.",
-          "english": "The repression didn't respond to a real threat; rather, it rested on an ideology that saw enemies throughout society."
+          "spanish": "En Perú el gobierno militar era de izquierda. No obstante, en Chile los militares combatieron a la izquierda.",
+          "english": "In Peru the military government was of the left. Nevertheless, in Chile the military fought the left."
         },
         {
-          "spanish": "El poder económico no quedaba en manos de los militares mismos, más bien se entregaba a equipos de tecnócratas civiles.",
-          "english": "Economic power didn't remain in the hands of the military themselves; it was rather handed over to teams of civilian technocrats."
+          "spanish": "Algunos sectores apoyaron los golpes. Sin embargo, otros los rechazaron.",
+          "english": "Some sectors supported the coups. However, others rejected them."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*Más bien* can stand alone mid-sentence (set off by commas) or pair with *no... sino que* for a stronger correction. Don't confuse it with *mejor dicho* (rather, that is to say), which corrects your own previous wording rather than someone else's claim."
+      "content": "Put a comma after *sin embargo* and *no obstante*. With *aunque* the clause comes first or second, and a comma separates them when *aunque* opens the sentence: *Aunque era un gobierno militar, …*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-gobiernosmilitares-02-de-tal-manera-que-gr.json b/content/es-latam/grammar/b1/b1-gobiernosmilitares-02-de-tal-manera-que-gr.json
