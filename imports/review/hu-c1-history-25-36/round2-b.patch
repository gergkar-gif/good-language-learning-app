-  "title": "A szabad városok küzdelme: Autonómia a kivéreztetés ellen",
+  "title": "Az önkormányzatok finanszírozása, 2019–2023",
   "level": "C1",
   "lesson": 2,
   "order": 2,
   "type": "world",
