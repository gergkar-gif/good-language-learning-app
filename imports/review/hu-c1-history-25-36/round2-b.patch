   "id": "story.c1.magyarjovo.04",
-  "title": "A köztársaság fundamentuma: A Demokratikus Minimum",
+  "title": "Intézményi garanciák a közéleti vitában, 2021–2026",
   "level": "C1",
   "lesson": 4,
   "order": 4,
   "type": "world",
   "estimatedMinutes": 3,
