@@ -1,36 +1,59 @@
 {
-  "id": "grammar.b2.paraguay.02.paraguay-concesivas-avanzadas",
-  "title": "Advanced Concessive Clauses in Historical Analysis",
+  "id": "grammar.b2.paraguay.02.sin-embargo-misiones",
+  "title": "Two Views of the Missions: Sin Embargo, No Obstante and Aunque",
   "sections": [
     {
       "type": "text",
-      "content": "El análisis historiográfico requiere contraponer obstáculos objetivos a logros consumados. Las oraciones subordinadas concesivas avanzadas permiten articular esta dialéctica mediante alternancias de indicativo y subjuntivo."
+      "title": "What you already know",
+      "content": "You know *sin embargo* from A2 Unit 28 and *no obstante* from B1 Unit 1, and *aunque* from A2 Unit 28. They introduce an idea that goes against the first one. The Jesuit missions are a topic where historians disagree, so they are very useful to put two views side by side."
     },
     {
       "type": "table",
-      "title": "Nexos concesivos avanzados en contexto histórico",
+      "title": "Contrast connectors",
       "rows": [
         [
-          "Por más que las misiones sufrieran asedios, sus templos perduraron.",
-          "No matter how much the missions suffered sieges, their temples endured."
+          "Las misiones protegieron a los guaraníes; sin embargo, los jesuitas controlaban su vida.",
+          "*sin embargo*: however"
         ],
         [
-          "Si bien los jesuitas fueron expulsados en 1767, su música barroca arraigó.",
-          "Although the Jesuits were expelled in 1767, their baroque music took root."
+          "Los jesuitas fueron expulsados en 1767; no obstante, las ruinas siguen en pie.",
+          "*no obstante*: nevertheless (more formal)"
         ],
         [
-          "Aun cuando faltaran recursos modernos, los artesanos guaraníes tallaron la piedra.",
-          "Even though modern resources were lacking, Guaraní artisans carved the stone."
+          "Aunque la iglesia de Jesús quedó sin terminar, hoy es patrimonio de la humanidad.",
+          "*aunque*: although"
         ],
         [
-          "Pese a que la selva avanzó sobre las ruinas, las naves siguen en pie.",
-          "Despite the jungle advancing over the ruins, the naves remain standing."
+          "La música barroca llegó de Europa; sin embargo, los guaraníes la hicieron suya.",
+          "contrast with the expected"
         ]
       ]
     },
+    {
+      "type": "examples",
+      "title": "In context",
+      "items": [
+        {
+          "spanish": "Las misiones protegieron a los guaraníes; sin embargo, los jesuitas controlaban su vida.",
+          "english": "The missions protected the Guaraní; however, the Jesuits controlled their lives."
+        },
+        {
+          "spanish": "Los jesuitas fueron expulsados en 1767; no obstante, las ruinas siguen en pie.",
+          "english": "The Jesuits were expelled in 1767; nevertheless, the ruins are still standing."
+        },
+        {
+          "spanish": "Aunque la iglesia de Jesús quedó sin terminar, hoy es patrimonio de la humanidad.",
+          "english": "Although the church of Jesús was left unfinished, it is a world heritage site today."
+        },
+        {
+          "spanish": "La música barroca llegó de Europa; sin embargo, los guaraníes la hicieron suya.",
+          "english": "Baroque music came from Europe; however, the Guaraní made it their own."
+        }
+      ]
+    },
     {
       "type": "tip",
-      "content": "Recuerda: 'si bien' se construye siempre con modo indicativo en prosa formal: 'Si bien la contienda fue atroz, la nación se reconstruyó' (NUNCA: *si bien fuera atroz)."
+      "content": "Use a contrast connector only when the second idea goes against the first; for a result use *por eso* or *así que*. *Sin embargo* and *no obstante* take a comma after them. When historians disagree, say who holds each view (*según algunos historiadores*)."
     }
   ]
 }
