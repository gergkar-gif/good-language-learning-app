@@ -1,36 +1,59 @@
 {
-  "id": "grammar.b2.paraguay.04.paraguay-adverbiales-lugar",
-  "title": "Complex Locative Adverbials in Descriptive Prose",
+  "id": "grammar.b2.paraguay.04.digresiones-chaco",
+  "title": "Side Remarks: Por Cierto, A Propósito and Dicho Sea de Paso",
   "sections": [
     {
       "type": "text",
-      "content": "La descripción geográfica y paisajística de regiones agrestes como el Gran Chaco se enriquece mediante locuciones adverbiales espaciales que sitúan los elementos en el horizonte, transmitiendo lejanía, inmensidad o confinamiento."
+      "title": "What you already know",
+      "content": "You know *por cierto* and *volviendo a lo que decíamos* from B2 Unit 28, with *a propósito (de)* and *dicho sea de paso*: phrases that mark a side remark and the way back. They are for speaking and talks. Imagine you are telling a friend about the Chaco: you want to add a detail, and then return to your point."
     },
     {
       "type": "table",
-      "title": "Locuciones espaciales en la prosa geográfica",
+      "title": "Side remarks and the way back",
       "rows": [
         [
-          "Avanzaron cien leguas tierra adentro sorteando matorrales espinosos.",
-          "They advanced a hundred leagues inland dodging thorny scrubland."
+          "El Chaco tiene pocos habitantes; por cierto, ¿has visto el mapa?",
+          "*por cierto*: by the way (a new thought)"
         ],
         [
-          "Navegaron río abajo hacia la confluencia del Pilcomayo y el Paraguay.",
-          "They sailed downriver toward the confluence of the Pilcomayo and the Paraguay."
+          "A propósito de los menonitas, llegaron al Chaco en 1927.",
+          "*a propósito de* + noun: speaking of"
         ],
         [
-          "Se refugiaron en los confines del monte, donde la vegetación es impenetrable.",
-          "They took refuge in the confines of the scrub, where vegetation is impenetrable."
+          "El quebracho, dicho sea de paso, tiene mucho tanino.",
+          "*dicho sea de paso*: incidentally, between commas"
         ],
         [
-          "El bosque de quebracho se extendía a lo largo y ancho de la llanura.",
-          "The quebracho forest stretched across the length and breadth of the plain."
+          "Volviendo a lo que decíamos, el Chaco es una región muy seca.",
+          "*volviendo a lo que decíamos*: back to the main line"
         ]
       ]
     },
+    {
+      "type": "examples",
+      "title": "In context",
+      "items": [
+        {
+          "spanish": "El Chaco tiene pocos habitantes; por cierto, ¿has visto el mapa?",
+          "english": "The Chaco has few inhabitants; by the way, have you seen the map?"
+        },
+        {
+          "spanish": "A propósito de los menonitas, llegaron al Chaco en 1927.",
+          "english": "Speaking of the Mennonites, they arrived in the Chaco in 1927."
+        },
+        {
+          "spanish": "El quebracho, dicho sea de paso, tiene mucho tanino.",
+          "english": "The quebracho, incidentally, has a lot of tannin."
+        },
+        {
+          "spanish": "Volviendo a lo que decíamos, el Chaco es una región muy seca.",
+          "english": "Going back to what we were saying, the Chaco is a very dry region."
+        }
+      ]
+    },
     {
       "type": "tip",
-      "content": "Evita construcciones redundantes: 'tierra adentro' no lleva preposición 'hacia' antes si el verbo ya implica movimiento ('se internaron tierra adentro')."
+      "content": "A side remark is short and you should come back to the main line afterwards. To add a main point, use *además* (A2 Unit 28), not these phrases. *A propósito* alone means \"by the way\"; *a propósito de* needs a noun."
     }
   ]
 }
