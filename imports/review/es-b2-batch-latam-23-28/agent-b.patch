@@ -1,36 +1,59 @@
 {
-  "id": "grammar.b2.paraguay.03.paraguay-voz-pasiva-estilo",
-  "title": "Stylistic Passive Structures in Historiographical Discourse",
+  "id": "grammar.b2.paraguay.03.ser-participio-guerra",
+  "title": "Naming What Happened: The Passive with Ser",
   "sections": [
     {
       "type": "text",
-      "content": "La prosa historiográfica de nivel B2 recurre a la voz pasiva perifrástica ('ser' + participio) y a la pasiva refleja ('se' + verbo en tercera persona) para conferir solemnidad, enfatizar el objeto de la acción o velar el agente causal."
+      "title": "What you already know",
+      "content": "You know the passive with *ser* + past participle from B1 Unit 18: *La ley fue aprobada por el Parlamento*. The participle agrees with the subject and *por* names who did the action. In writing about a war it keeps the focus on the places and documents: what was signed, taken or occupied."
     },
     {
       "type": "table",
-      "title": "Estructuras pasivas en la narración histórica",
+      "title": "Ser + participle",
       "rows": [
         [
-          "La soberanía patria fue defendida con heroísmo indecible en Cerro Corá.",
-          "Homeland sovereignty was defended with unspeakable heroism at Cerro Corá."
+          "El tratado fue firmado en mayo de 1865.",
+          "*fue firmado*: singular, masculine (*el tratado*)"
         ],
         [
-          "Se fundaron hospitales de campaña gracias a la abnegación de las mujeres.",
-          "Field hospitals were founded thanks to the selflessness of the women."
+          "La fortaleza de Humaitá fue tomada en 1868.",
+          "*fue tomada*: singular, feminine"
         ],
         [
-          "Se combatió sin descanso a lo largo de las trincheras del río Aquidabán.",
-          "Fighting took place tirelessly along the trenches of the Aquidabán River."
+          "La capital fue ocupada por tropas brasileñas.",
+          "*fue ocupada por*: *por* names the agent"
         ],
         [
-          "Quedó diezmada la población masculina tras un lustro de asedio.",
-          "The male population ended up decimated after five years of siege."
+          "Muchas ciudades fueron destruidas durante la guerra.",
+          "*fueron destruidas*: plural, feminine"
         ]
       ]
     },
+    {
+      "type": "examples",
+      "title": "In context",
+      "items": [
+        {
+          "spanish": "El tratado fue firmado en mayo de 1865.",
+          "english": "The treaty was signed in May 1865."
+        },
+        {
+          "spanish": "La fortaleza de Humaitá fue tomada en 1868.",
+          "english": "The fortress of Humaitá was taken in 1868."
+        },
+        {
+          "spanish": "La capital fue ocupada por tropas brasileñas.",
+          "english": "The capital was occupied by Brazilian troops."
+        },
+        {
+          "spanish": "Muchas ciudades fueron destruidas durante la guerra.",
+          "english": "Many towns were destroyed during the war."
+        }
+      ]
+    },
     {
       "type": "tip",
-      "content": "Concordancia de la pasiva refleja: si el sujeto paciente es plural, el verbo DEBE concordar en plural: 'Se fundaron hospitales' (correcto), no *'Se fundó hospitales'."
+      "content": "Make the participle agree with the subject (*firmado*, *tomada*, *destruidas*) and put *ser* in the right tense. Name the agent with *por* only when it matters. If you want to leave it out in a general statement, you can use the *se* passive, as in *se firmó el tratado*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b2/b2-paraguay-04-a-gr.json b/content/es-latam/grammar/b2/b2-paraguay-04-a-gr.json
