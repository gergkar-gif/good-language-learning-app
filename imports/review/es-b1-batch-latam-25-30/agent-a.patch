@@ -1,35 +1,35 @@
 {
   "id": "grammar.b1.conosur.03.por-su-parte",
-  "title": "Por su parte: introducir un nuevo caso dentro de una comparación",
+  "title": "Superlatives: the most stable, the smallest, very many",
   "sections": [
     {
       "type": "text",
-      "content": "*Por su parte* (for its/his/her part) introduces a new subject within an ongoing comparison, signaling this one, in contrast or in addition to what came before -- useful when a reading moves from one country's experience to another's. It agrees with the subject it refers back to (*mi parte*, *tu parte*, *su parte*, etc., though *su parte* is by far the most common in historical writing). These sentences are taken directly from the previous reading."
+      "content": "You know relative and absolute superlatives (*-ísimo*, *el/la más*) from B1 Unit 7. The relative superlative uses *el/la/los/las más* + adjective + *de*, often with *uno de los*: *uno de los países más pequeños de la región*. The absolute superlative uses *-ísimo*, *-ísima*, *-ísimos* or *-ísimas* to mean \"very, very\": *muchísimas personas*. A superlative about a country's past is often a judgement, so say whose."
     },
     {
       "type": "examples",
       "items": [
         {
-          "spanish": "Uruguay, por su parte, vivió también un episodio poco frecuente entre las dictaduras de la región.",
-          "english": "Uruguay, for its part, also experienced an episode uncommon among the region's dictatorships."
+          "spanish": "Uruguay es uno de los países más pequeños de América del Sur.",
+          "english": "Uruguay is one of the smallest countries in South America."
         },
         {
-          "spanish": "Los Tupamaros, por su parte, ya estaban prácticamente derrotados militarmente hacia 1972.",
-          "english": "The Tupamaros, for their part, were already practically defeated militarily by 1972."
+          "spanish": "Según muchos historiadores, tenía una de las democracias más estables de la región.",
+          "english": "According to many historians, it had one of the most stable democracies in the region."
         },
         {
-          "spanish": "El régimen, por su parte, no esperaba que la ciudadanía rechazara la nueva constitución.",
-          "english": "The regime, for its part, didn't expect the public to reject the new constitution."
+          "spanish": "La dictadura persiguió a muchísimas personas.",
+          "english": "The dictatorship persecuted a great many people."
         },
         {
-          "spanish": "Sanguinetti, por su parte, heredaría un país con una economía debilitada y profundas heridas sociales.",
-          "english": "Sanguinetti, for his part, would inherit a country with a weakened economy and deep social wounds."
+          "spanish": "Según varias organizaciones, tuvo una de las proporciones más altas de presos políticos del mundo.",
+          "english": "According to several organisations, it had one of the highest proportions of political prisoners in the world."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*Por su parte* usually follows the subject it introduces, set off by commas -- it's a smoother alternative to starting every new sentence in a comparison with *en cambio* or *sin embargo*."
+      "content": "After a superlative that names a group, use *de*, not *en*: *de la región*, *del mundo*. The adjective agrees with the group: *uno de los países más pequeños*. If a superlative is a judgement or an estimate, add *según…* or *para muchos historiadores…*."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-conosur-04-por-medio-de-gr.json b/content/es-latam/grammar/b1/b1-conosur-04-por-medio-de-gr.json
