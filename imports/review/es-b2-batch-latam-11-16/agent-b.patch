         ],
         [
-          "No repetición",
-          "Garantía ética e institucional de que las atrocidades no se repetirán."
+          "«Firmaremos el acuerdo.»",
+          "Dijo que firmarían el acuerdo."
         ],
         [
-          "Centralidad de víctimas",
-          "Principio según el cual las víctimas son el corazón de la paz."
+          "«Estamos preparados.»",
+          "Dijo que estaban preparados."
         ]
       ]
+    },
+    {
+      "type": "examples",
+      "title": "In context",
+      "items": [
+        {
+          "spanish": "Una delegada dijo que las conversaciones continuaban.",
+          "english": "A delegate said that the talks were continuing."
+        },
+        {
+          "spanish": "La Comisión de la Verdad dijo en su informe de 2022 que el conflicto había dejado cientos de miles de muertos.",
+          "english": "In its 2022 report, the Truth Commission said that the conflict had left hundreds of thousands dead."
+        },
+        {
+          "spanish": "El gobierno dijo que firmaría un nuevo acuerdo.",
+          "english": "The government said it would sign a new agreement."
+        },
+        {
+          "spanish": "Según la ONU, las FARC entregaron casi nueve mil armas.",
+          "english": "According to the UN, the FARC handed over almost nine thousand weapons."
+        }
+      ]
+    },
