         ],
         [
-          "Alabaos y gualíes",
-          "Cantos fúnebres y espirituales entonados por cantadoras."
+          "Los ríos son importantes porque llueve mucho.",
+          "with a verb (*llueve*) use *porque*, not *debido a*"
         ]
       ]
+    },
+    {
+      "type": "examples",
+      "title": "In context",
+      "items": [
+        {
+          "spanish": "Debido a la lluvia y a la selva, hay pocas carreteras en el Pacífico.",
+          "english": "Because of the rain and the forest, there are few roads on the Pacific coast."
+        },
+        {
+          "spanish": "Debido a las lluvias, los ríos son los caminos de la región.",
+          "english": "Because of the rains, the rivers are the roads of the region."
+        },
+        {
+          "spanish": "A raíz del terremoto de 1979, el tsunami destruyó muchas casas en Tumaco.",
+          "english": "As a result of the 1979 earthquake, the tsunami destroyed many houses in Tumaco."
+        },
+        {
+          "spanish": "Debido al mal tiempo, las lanchas no salieron.",
