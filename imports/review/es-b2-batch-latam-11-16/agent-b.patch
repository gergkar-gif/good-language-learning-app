         ],
         [
-          "la cordillera de la Costa",
-          "the rugged coastal mountain range"
+          "Caracas fue fundada en un valle estrecho en 1567.",
+          "En un valle estrecho fue fundada Caracas en 1567. (place first)"
         ],
         [
-          "el valle de los Caracas",
-          "the high tectonic valley of the capital"
+          "El Ávila se levanta entre la ciudad y el mar.",
+          "Entre la ciudad y el mar se levanta El Ávila. (place first)"
         ],
         [
-          "el clima de eterna primavera",
-          "the pleasant tropical highland mountain climate"
-        ],
-        [
-          "el litoral guaireño",
-          "the Caribbean port coastline beneath the ridge"
-        ],
-        [
-          "la quebrada de Catuche",
-          "the urban streams descending from the heights"
+          "Humboldt subió a la Silla de Caracas en 1800.",
+          "En 1800 subió Humboldt a la Silla de Caracas. (time first)"
         ]
       ]
     },
+    {
+      "type": "examples",
+      "title": "In context",
+      "items": [
+        {
+          "spanish": "Estrecho es el valle donde está Caracas.",
