+    {
+      "type": "tip",
+      "content": "Ask yourself whether the speaker presents the obstacle as a real fact (indicative) or as something possible that will not change the plan (subjunctive). *Aun cuando* is more formal than *aunque*; write *aun* without an accent here, because *aún* means \"still\"."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b2/b2-venezuelapetroleo-01-a-gr.json b/content/es-latam/grammar/b2/b2-venezuelapetroleo-01-a-gr.json
