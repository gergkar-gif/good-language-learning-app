-        [
-          "Ven de prisa, que ya va a comenzar la ceremonia de graduación.",
-          "Come quickly, for the graduation ceremony is about to start."
-        ],
-        [
-          "Aléjate del borde, que te puedes caer en el barranco rocoso.",
-          "Step back from the edge, because you could fall into the rocky ravine."
-        ]
+      "type": "examples",
+      "items": [
