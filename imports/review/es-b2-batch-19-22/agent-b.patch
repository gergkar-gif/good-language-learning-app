+      "type": "examples",
+      "title": "In context",
+      "items": [
+        {
+          "spanish": "Ya hemos imprimido los boletos.",
+          "english": "We have already printed the tickets."
+        },
+        {
+          "spanish": "Los boletos ya están impresos.",
+          "english": "The tickets are already printed."
