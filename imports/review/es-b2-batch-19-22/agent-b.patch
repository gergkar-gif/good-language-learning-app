-          "El informe ha sido imprimido / impreso.",
-          "The report has been printed (both valid with ser)."
+          "imprimir: imprimido / impreso",
+          "he imprimido el informe / un libro impreso"
         ],
         [
-          "El texto ya está impreso en papel vitela.",
-          "The text is already printed on vellum paper (adjective/state)."
+          "freír: freído / frito",
+          "he freído el pescado / papas fritas"
         ],
         [
-          "El congreso ha elegido a los nuevos magistrados.",
-          "Congress has elected the new magistrates (compound tense)."
+          "proveer: proveído / provisto",
+          "he proveído la comida / una tienda provista de agua"
         ],
         [
-          "Los magistrados electos asumirán el cargo.",
-          "The elected magistrates will take office (adjective)."
-        ],
-        [
-          "El pueblo ha sido provisto de víveres.",
-          "The village has been supplied with foodstuffs."
-        ],
-        [
-          "El almacén está bien provisto para el invierno.",
-          "The storehouse is well supplied for the winter."
+          "elegir: elegido / electo",
+          "han elegido a la alcaldesa / la alcaldesa electa"
         ]
       ]
