+++ b/content/es-latam/grammar/b1/b1-economiacolonial-05-consecuencias-gr.json
@@ -1,35 +1,59 @@
 {
   "id": "grammar.b1.economiacolonial.05.consecuencias",
-  "title": "Voz pasiva: consecuencias de la economía colonial",
+  "title": "Contrast and concession: the two faces of silver",
   "sections": [
     {
       "type": "text",
-      "content": "A synthesis on economic consequences reaches for passive voice to keep money, prices and wealth as the grammatical subject — what happened to them matters more than naming an agent every time. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know *sin embargo* and *no obstante* from B1 Unit 1, *aunque* from A2 Unit 28 and *a pesar de que* from B1 Unit 32. Together they let you say that silver brought wealth and, at the same time, problems: first the good side, then the contrast."
+    },
+    {
+      "type": "table",
+      "title": "Linking opposite ideas",
+      "rows": [
+        [
+          "La corona recibió mucha plata. Sin embargo, tuvo muchas deudas.",
+          "*sin embargo*: starts a new sentence, comma after it"
+        ],
+        [
+          "Los precios subieron; no obstante, otras causas también fueron importantes.",
+          "*no obstante*: a more formal *sin embargo*"
+        ],
+        [
+          "Aunque España recibía plata, mucha plata salió del país.",
+          "*aunque* + indicative: a fact that is true"
+        ],
+        [
+          "A pesar de que se producía mucha plata, la mayoría seguía siendo pobre.",
+          "*a pesar de que* + indicative"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Cantidades históricamente inéditas de plata y oro fueron enviadas desde América hacia España.",
-          "english": "Historically unprecedented quantities of silver and gold were sent from America to Spain."
+          "spanish": "La corona recibió mucha plata. Sin embargo, tuvo muchas deudas.",
+          "english": "The crown received a lot of silver. However, it had many debts."
         },
         {
-          "spanish": "Buena parte de la plata fue simplemente utilizada para pagar deudas de guerra.",
-          "english": "Much of the silver was simply used to pay off war debts."
+          "spanish": "Algunas ciudades crecieron; no obstante, muchos trabajadores vivían en condiciones duras.",
+          "english": "Some cities grew; nevertheless, many workers lived in hard conditions."
         },
         {
-          "spanish": "Los precios de bienes y servicios fueron empujados al alza durante generaciones.",
-          "english": "The prices of goods and services were pushed upward for generations."
+          "spanish": "Aunque España recibía mucha plata, una parte importante salió del país.",
+          "english": "Although Spain received a lot of silver, an important part left the country."
         },
         {
-          "spanish": "Los beneficios de esta economía fueron distribuidos de forma extremadamente desigual.",
-          "english": "The benefits of this economy were distributed extremely unequally."
+          "spanish": "A pesar de que se producía mucha plata, la mayoría seguía siendo pobre.",
+          "english": "Even though a lot of silver was produced, the majority stayed poor."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "A whole paragraph built from *ser + participle* sentences (*fueron enviadas, fue utilizada, fueron empujados, fueron distribuidos*) reads as a chain of consequences — each new passive sentence can pick up where the last one left off, which is exactly what a 'what did all this lead to?' synthesis needs."
+      "content": "*Sin embargo* and *no obstante* join two sentences or two halves of a sentence with a comma; *aunque* and *a pesar de que* go before the idea that is conceded. With a real fact, use the indicative after both."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-sociedadcolonial-01-administracion-gr.json b/content/es-latam/grammar/b1/b1-sociedadcolonial-01-administracion-gr.json
index 1d9bd5c1..130b5c79 100644
--- a/content/es-latam/grammar/b1/b1-sociedadcolonial-01-administracion-gr.json
+++ b/content/es-latam/grammar/b1/b1-sociedadcolonial-01-administracion-gr.json
@@ -1,35 +1,55 @@
 {
   "id": "grammar.b1.sociedadcolonial.01.administracion",
-  "title": "Voz pasiva: administración colonial",
+  "title": "The passive with se: how the empire was organised",
   "sections": [
     {
       "type": "text",
-      "content": "Institutional history leans on passive voice constantly: a viceroyalty was created, a territory was administered, a system was designed — the institution is the subject, not necessarily the specific person behind it. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know the passive with *se* from B1 Unit 6 (*se busca una persona*, *se buscan personas*): you leave out who does the action and the verb agrees with the thing. It is the natural way to say what the crown created and where decisions were taken, because the doer is an institution or the king."
+    },
+    {
+      "type": "table",
+      "title": "The verb agrees with the noun",
+      "rows": [
+        [
+          "Se creó el virreinato de Nueva España.",
+          "singular noun, singular verb"
+        ],
+        [
+          "Se crearon dos virreinatos nuevos.",
+          "plural noun, plural verb"
+        ],
+        [
+          "Se tomaban las decisiones en el Consejo de Indias.",
+          "imperfect: what happened regularly"
+        ]
+      ]
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "El virreinato de Nueva España fue creado en 1535; el virreinato del Perú fue establecido en 1542.",
-          "english": "The Viceroyalty of New Spain was created in 1535; the Viceroyalty of Peru was established in 1542."
+          "spanish": "En 1535 se creó el virreinato de Nueva España.",
+          "english": "In 1535 the viceroyalty of New Spain was created."
         },
         {
-          "spanish": "Fueron creados dos virreinatos adicionales, el de Nueva Granada y el del Río de la Plata.",
-          "english": "Two additional viceroyalties were created, New Granada and Río de la Plata."
+          "spanish": "En el siglo XVIII se crearon dos virreinatos nuevos.",
+          "english": "In the 18th century two new viceroyalties were created."
         },
         {
-          "spanish": "Todo el comercio con las colonias estaba controlado por una sola institución, la Casa de Contratación.",
-          "english": "All trade with the colonies was controlled by a single institution, the Casa de Contratación."
+          "spanish": "En el Consejo de Indias se tomaban las decisiones más importantes.",
+          "english": "The most important decisions were taken in the Council of the Indies."
         },
         {
-          "spanish": "Este sistema fue diseñado para mantener el control sobre un territorio enorme.",
-          "english": "This system was designed to maintain control over an enormous territory."
+          "spanish": "En los cabildos se discutían los problemas locales.",
+          "english": "Local problems were discussed in the town councils."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "Ser + participle + estar + participle both describe a passive state, but they answer slightly different questions: fue creado marks the moment of an action (creation happened then), while estaba controlado describes an ongoing condition (control existed over a stretch of time). Institutional history uses both constantly, often in the same paragraph."
+      "content": "Put the verb in the same number as the thing: *se creó un virreinato*, *se crearon dos virreinatos*. Use *se* when the doer is the crown or an institution and does not need a name; to name the doer, use *ser* + participle from B1 Unit 18."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-sociedadcolonial-02-jerarquia-gr.json b/content/es-latam/grammar/b1/b1-sociedadcolonial-02-jerarquia-gr.json
