diff --git a/content/es-latam/grammar/b1/b1-llegadaeuropeos-05-transformacion-gr.json b/content/es-latam/grammar/b1/b1-llegadaeuropeos-05-transformacion-gr.json
index d95a4b9f..51157845 100644
--- a/content/es-latam/grammar/b1/b1-llegadaeuropeos-05-transformacion-gr.json
