@@ -1,35 +1,37 @@
 {
   "id": "grammar.b1.llegadaeuropeos.05.transformacion",
-  "title": "Oraciones de relativo para precisar información",
+  "title": "Doubt and possibility: es posible que, no es seguro que, quizás",
   "sections": [
     {
       "type": "text",
-      "content": "Relative clauses let one sentence carry a definition, an attribution, or an ownership relationship without starting a new sentence — *que* for things and people, *a quienes* for people as an object, *cuyo/cuya/cuyos/cuyas* for 'whose,' agreeing with the thing possessed, not the possessor. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know the subjunctive after doubt and probability: *dudo que* and *quizás* from B1 Unit 13. History is full of things nobody can prove, so these expressions are very useful: *Es posible que las epidemias sean la causa principal.*"
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Durante siglos se habló de 'descubrimiento', una palabra que asumía que América no existía realmente hasta que Europa la encontró.",
-          "english": "For centuries people spoke of 'discovery,' a word that assumed America didn't really exist until Europe found it."
+          "spanish": "Es posible que las epidemias sean la causa principal.",
+          "english": "It is possible that the epidemics are the main cause."
         },
         {
-          "spanish": "Los primeros cálculos fueron publicados por historiadores a quienes hoy se llama 'contadores bajos'.",
-          "english": "The first estimates were published by historians who today are called 'low counters'."
+          "spanish": "No es seguro que podamos conocer la cifra exacta.",
+          "english": "It is not certain that we can know the exact figure."
         },
         {
-          "spanish": "Investigaciones posteriores, cuyos autores revisaron fuentes coloniales con más detalle, elevaron esa cifra a cien millones.",
-          "english": "Later research, whose authors reviewed colonial sources in more detail, raised that figure to a hundred million."
+          "spanish": "Quizás las causas actúen juntas en cada región.",
+          "english": "Perhaps the causes act together in each region."
         },
         {
-          "spanish": "Un ejemplo célebre es la Virgen de Guadalupe, cuya aparición se sitúa en 1531 en el cerro del Tepeyac.",
-          "english": "A famous example is the Virgin of Guadalupe, whose appearance is placed in 1531 on Tepeyac hill."
+          "spanish": "Los historiadores dudan que exista una sola explicación.",
+          "english": "Historians doubt that there is a single explanation."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "*Cuyo* agrees with the noun that comes right after it (the thing owned), never with the person it refers back to: *cuyos autores* (whose authors — because *autores* is masculine plural), *cuya aparición* (whose appearance — because *aparición* is feminine singular). This trips up a lot of learners because English 'whose' never changes form."
+      "content": "Doubt and possibility take the subjunctive (*sean*, *podamos*, *actúen*, *exista*). Certainty takes the indicative: *No hay duda de que el mundo cambió*. *Quizás* can take the indicative when you are fairly sure, but the subjunctive shows real doubt."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-precolombina-01-geography-connectors-gr.json b/content/es-latam/grammar/b1/b1-precolombina-01-geography-connectors-gr.json
