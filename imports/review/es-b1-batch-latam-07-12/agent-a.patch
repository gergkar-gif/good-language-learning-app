diff --git a/content/es-latam/grammar/b1/b1-nuevasrepublicas-04-inestabilidad-politica-gr.json b/content/es-latam/grammar/b1/b1-nuevasrepublicas-04-inestabilidad-politica-gr.json
index daf0882d..be53c089 100644
--- a/content/es-latam/grammar/b1/b1-nuevasrepublicas-04-inestabilidad-politica-gr.json
+++ b/content/es-latam/grammar/b1/b1-nuevasrepublicas-04-inestabilidad-politica-gr.json
@@ -1,35 +1,35 @@
 {
   "id": "grammar.b1.nuevasrepublicas.04.inestabilidad-politica",
-  "title": "Conectores formales: inestabilidad política",
+  "title": "Soler: what usually happened",
   "sections": [
     {
       "type": "text",
-      "content": "*A raíz de* and como consecuencia de both introduce a cause; en el marco de sets the broader situation something happened within. A paragraph explaining political instability typically needs all three: what caused it, what followed from it, and what larger context it occurred in. These sentences are taken directly from the previous reading."
+      "content": "You know *soler* + infinitive from B1 Unit 5: in the imperfect it means \"used to\" (*solíamos reunirnos*). It is the natural way to describe a pattern in politics, how things usually went in those decades. *Solía* goes with one person and *solían* with several."
     },
     {
       "type": "examples",
       "items": [
         {
-          "spanish": "A raíz de la falta de instituciones consolidadas, la inestabilidad política se convirtió en la norma.",
-          "english": "As a result of the lack of consolidated institutions, political instability became the norm."
+          "spanish": "Los presidentes solían gobernar poco tiempo.",
+          "english": "Presidents used to govern for a short time."
         },
         {
-          "spanish": "En el marco de esta inestabilidad surgió un término específico: el pronunciamiento.",
-          "english": "Within the context of this instability, a specific term emerged: the pronunciamiento."
+          "spanish": "Un oficial solía escribir un plan y pedir apoyo a otros soldados.",
+          "english": "An officer used to write a plan and ask other soldiers for support."
         },
         {
-          "spanish": "Bolivia, como consecuencia de esta dinámica, llegó a tener varias decenas de gobiernos distintos en pocas décadas.",
-          "english": "Bolivia, as a consequence of this dynamic, came to have several dozen different governments in just a few decades."
+          "spanish": "Santa Anna solía llegar al poder con el apoyo del ejército.",
+          "english": "Santa Anna used to come to power with the army's support."
         },
         {
-          "spanish": "Como consecuencia directa de esta rotación constante, resultaba prácticamente imposible sostener políticas de largo plazo.",
-          "english": "As a direct consequence of this constant turnover, it was practically impossible to sustain long-term policies."
+          "spanish": "Los caudillos solían tener más fuerza que los gobiernos débiles.",
+          "english": "Caudillos used to be stronger than weak governments."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "When como consecuencia de appears twice in the same paragraph (as here), notice how the second one narrows the focus — the first names Bolivia's instability as a consequence of the broader dynamic, the second traces one specific effect of that instability (no long-term policy). Repetition of the connector is fine; it's the scope that should shift."
+      "content": "*Soler* is followed by an infinitive (*solían gobernar*) and not by another conjugated verb. It describes a habit, not one event: for one event use the preterite (*Santa Anna llegó al poder en una ocasión*)."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-nuevasrepublicas-05-sintesis-republicana-gr.json b/content/es-latam/grammar/b1/b1-nuevasrepublicas-05-sintesis-republicana-gr.json
