@@ -1,35 +1,35 @@
 {
   "id": "grammar.b1.nuevasrepublicas.02.territorio-fronteras",
-  "title": "Voz pasiva: territorio y fronteras",
+  "title": "Reporting information: who says what about borders",
   "sections": [
     {
       "type": "text",
-      "content": "Passive voice keeps the territory or the principle as the grammatical subject, letting a sentence trace what happened to a border or a legal rule without stopping to name every government involved. These sentences are taken directly from the previous reading."
+      "content": "You know how to report statements with *según* + the source and with *decir que* from B1 Unit 13. In a border dispute, every side has its own source and its own story, so it matters to say who says what."
     },
     {
       "type": "examples",
       "items": [
         {
-          "spanish": "Fue adoptado por la mayoría de las nuevas repúblicas un principio legal conocido como uti possidetis juris.",
-          "english": "A legal principle known as uti possidetis juris was adopted by most of the new republics."
+          "spanish": "Según este principio, cada país conservaba los límites coloniales.",
+          "english": "According to this principle, each country kept the colonial limits."
         },
         {
-          "spanish": "Ese principio fue aceptado formalmente por casi todos los gobiernos, pero resultó difícil de aplicar.",
-          "english": "That principle was formally accepted by almost all governments, but proved hard to apply."
+          "spanish": "Según los historiadores, hubo muchas disputas.",
+          "english": "According to historians, there were many disputes."
         },
         {
-          "spanish": "Las fronteras fueron discutidas, renegociadas y, en ocasiones, disputadas militarmente durante décadas.",
-          "english": "Borders were discussed, renegotiated, and at times militarily disputed for decades."
+          "spanish": "Los gobiernos decían que los documentos coloniales apoyaban sus derechos.",
+          "english": "The governments said that the colonial documents supported their rights."
         },
         {
-          "spanish": "La organización territorial interna de cada país fue modificada repetidamente.",
-          "english": "Each country's internal territorial organization was repeatedly modified."
+          "spanish": "Los historiadores explican que muchos límites eran imprecisos.",
+          "english": "Historians explain that many limits were unclear."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "Three passive verbs joined by commas (fueron discutidas, renegociadas y disputadas) let one sentence show escalation — a border problem didn't just get talked about, it kept getting talked about, then renegotiated, then in some cases fought over."
+      "content": "*Según* is followed by a noun (*según los historiadores*) and not by *que*. After *decir* or *explicar* use *que* and a full clause."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b1/b1-nuevasrepublicas-03-liberales-conservadores-gr.json b/content/es-latam/grammar/b1/b1-nuevasrepublicas-03-liberales-conservadores-gr.json
