+          "Los trenes salían llevando café.",
+          "*salían* + *llevando*: they left carrying coffee"
+        ],
+        [
+          "Los inmigrantes llegaban buscando trabajo.",
+          "*llegaban* + *buscando*: they arrived looking for work"
+        ],
