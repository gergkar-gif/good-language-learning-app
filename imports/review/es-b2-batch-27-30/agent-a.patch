diff --git a/content/es-latam/grammar/b2/b2-29-01-a-gr.json b/content/es-latam/grammar/b2/b2-29-01-a-gr.json
index 98c8c11f..5c8d0a1d 100644
--- a/content/es-latam/grammar/b2/b2-29-01-a-gr.json
+++ b/content/es-latam/grammar/b2/b2-29-01-a-gr.json
@@ -1,36 +1,36 @@
 {
   "id": "grammar.b2.29.01.marcadores-reformulacion-explicativa",
-  "title": "Explanatory Reformulation Discourse Markers",
+  "title": "Saying It Another Way",
   "sections": [
     {
       "type": "text",
-      "content": "Los marcadores de reformulación explicativa introducen una aclaración o paráfrasis de lo ya dicho con el propósito de facilitar la comprensión del receptor o precisar un término abstracto. En el nivel B2 formal, se emplean para articular definiciones rigurosas sin caer en repeticiones vacías."
+      "content": "You know *es decir* and *o sea* from B1 Unit 27, where you used them to say an idea again more simply. A reformulation marker says: \"what comes next is the same idea, said another way.\" It does not add a new point; it makes the first one clearer, shorter or more exact. Two more markers do the same job: *en otras palabras* (\"in other words\") and *dicho de otro modo* (\"put another way\"). In all four, the new wording comes after the marker, and a comma (or a semicolon in a longer sentence) separates it from what came before."
     },
     {
       "type": "table",
-      "title": "Marcadores de reformulación explicativa",
+      "title": "Four ways to restate",
       "rows": [
         [
-          "El tratado consagra la intercomprensión; es decir, la capacidad de comunicarse en lenguas hermanas.",
-          "The treaty enshrines mutual intelligibility; that is, the ability to communicate in cognate languages."
+          "El viaje es largo; es decir, dura más de diez horas.",
+          "The journey is long; that is, it takes more than ten hours."
         ],
         [
-          "La metrópolis sufre un estrés hídrico severo, o sea, un déficit crítico en sus reservas de agua.",
-          "The metropolis suffers from severe water stress, that is to say, a critical deficit in its water reserves."
+          "Salgo temprano, o sea, a las seis de la mañana.",
+          "I leave early, I mean at six in the morning."
         ],
         [
-          "Se aplicó el principio de subsidiariedad, esto es, la intervención estatal en auxilio comunal.",
-          "The principle of subsidiarity was applied, that is, state intervention to assist communities."
+          "La reunión es opcional; en otras palabras, nadie tiene que ir.",
+          "The meeting is optional; in other words, nobody has to go."
         ],
         [
-          "El patrimonio comprende tres vertientes, a saber: la histórica, la ecológica y la lingüística.",
-          "The heritage comprises three branches, namely: historical, ecological, and linguistic."
+          "Hoy no hay clase; dicho de otro modo, tenemos el día libre.",
+          "There is no class today; put another way, we have the day off."
         ]
       ]
     },
     {
       "type": "tip",
-      "content": "Puntuación de 'es decir' y 'esto es': se colocan habitualmente entre comas en el interior de una oración, o tras punto y coma cuando abren una proposición explicativa extensa."
+      "content": "Choose by tone. *O sea* is the most spoken; *es decir* works in talk and in writing; *en otras palabras* and *dicho de otro modo* suit a talk or text that has just said something abstract or long. You know *además* from A2 Unit 28: use that, not these four, when the second part adds a new fact."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b2/b2-29-02-a-gr.json b/content/es-latam/grammar/b2/b2-29-02-a-gr.json
index 68488f58..3205b535 100644
--- a/content/es-latam/grammar/b2/b2-29-02-a-gr.json
