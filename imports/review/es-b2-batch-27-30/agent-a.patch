@@ -1,36 +1,32 @@
 {
   "id": "grammar.b2.29.04.marcadores-reformulacion-recapitulativa",
-  "title": "Recapitulative Reformulation Discourse Markers",
+  "title": "Condensing What You Said",
   "sections": [
     {
       "type": "text",
-      "content": "Los marcadores recapitulativos o de paráfrasis sintética retoman un conjunto complejo de ideas y lo condensan en una formulación más transparente, facilitando la comprensión global de una tesis académica o literaria."
+      "content": "You know *en resumen* and *en definitiva* from B2 Unit 28: they close a whole text. A recap can also come in the middle of a text, after a long explanation, and it condenses what you just said into one short sentence. *En pocas palabras* (\"in a few words\") and *resumiendo* (\"to sum up\", the gerund of *resumir*) are made for that. They promise something shorter than what came before, so the sentence after them is short and clear."
     },
     {
       "type": "table",
-      "title": "Paráfrasis y reformulación recapitulativa",
+      "title": "Long explanation, short recap",
       "rows": [
         [
-          "Dicho en otros términos, la riqueza industrial paulista financió la experimentación vanguardista.",
-          "In other words, São Paulo's industrial wealth financed avant-garde experimentation."
+          "La oficina abre a las nueve, cierra a las cinco y no abre los fines de semana. En pocas palabras, solo abre de lunes a viernes.",
+          "The office opens at nine, closes at five and does not open at weekends. In a few words, it only opens from Monday to Friday."
         ],
         [
-          "En otras palabras, la modernidad brasileña devoró la influencia europea para reinventarla.",
-          "Put differently, Brazilian modernity devoured European influence to reinvent it."
+          "Resumiendo, el plan es barato, rápido y fácil.",
+          "To sum up, the plan is cheap, quick and easy."
         ],
         [
-          "Dicho de otro modo, la bossa nova despojó a la samba de estridencias para volverla íntima.",
-          "Expressed otherwise, bossa nova stripped samba of stridency to make it intimate."
-        ],
-        [
-          "Dicho más sencillamente, la diplomacia se convirtió en el puente supremo de integración.",
-          "Put more simply, diplomacy became the ultimate bridge of regional integration."
+          "En definitiva, es una buena idea.",
+          "All in all, it is a good idea."
         ]
       ]
     },
     {
       "type": "tip",
-      "content": "'Dicho en otros términos' y 'dicho de otro modo' confieren prestancia al texto argumentativo formal, sustituyendo con elegancia fórmulas trilladas de divulgación elemental."
+      "content": "A restatement (*es decir*, *en otras palabras*) says the same thing in other words. A recap (*en pocas palabras*, *resumiendo*) gathers several things into one. If you have not said several things yet, there is nothing to recap."
     }
   ]
 }
diff --git a/content/es-latam/grammar/b2/b2-29-05-a-gr.json b/content/es-latam/grammar/b2/b2-29-05-a-gr.json
index 1dcc6fc2..5f0f2849 100644
--- a/content/es-latam/grammar/b2/b2-29-05-a-gr.json
