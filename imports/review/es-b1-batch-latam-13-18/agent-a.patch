@@ -1,35 +1,37 @@
 {
   "id": "grammar.b1.revolucion.02.conectores-causales",
-  "title": "Conectores causales: debido a que, a causa de que",
+  "title": "Formal causes: debido a and a raíz de",
   "sections": [
     {
       "type": "text",
-      "content": "Debido a que and a causa de que (both meaning \"because,\" \"due to the fact that\") are the formal alternatives to porque, common in historical writing that wants to name a structural cause -- a law, a policy, a decades-old pattern -- rather than a simple personal reason. Both take the indicative when the cause is a stated fact. These sentences are taken directly from the previous reading."
+      "title": "What you already know",
+      "content": "You know formal cause connectors like *debido a* and *a raíz de* from B1 Unit 6. They give the reason or the starting point of something, and they sound written and historical. A noun follows them."
     },
     {
       "type": "examples",
+      "title": "In context",
       "items": [
         {
-          "spanish": "Debido a que las leyes liberales de privatización habían despojado a muchas comunidades de sus tierras comunales, millones de personas se encontraron trabajando tierras que antes eran suyas.",
-          "english": "Because the liberal privatization laws had stripped many communities of their communal lands, millions of people found themselves working land that had once been their own."
+          "spanish": "Debido a la concentración de la tierra, muchos campesinos no tenían tierra propia.",
+          "english": "Because of the concentration of land, many peasants had no land of their own."
         },
         {
-          "spanish": "A causa de que este despojo se repitió en prácticamente todos los países, la reivindicación de la tierra se convirtió en la demanda revolucionaria más extendida del continente.",
-          "english": "Because this dispossession repeated in practically every country, the demand for land became the most widespread revolutionary demand on the continent."
+          "spanish": "A raíz de la revolución de 1952, Bolivia hizo una reforma agraria.",
+          "english": "As a result of the revolution of 1952, Bolivia carried out a land reform."
         },
         {
-          "spanish": "En algunos países, este descontento permaneció contenido durante décadas, debido a que los gobiernos combinaban represión selectiva con concesiones menores.",
-          "english": "In some countries, this discontent stayed contained for decades, because governments combined selective repression with minor concessions."
+          "spanish": "Debido a esas reformas, algunos grandes propietarios se opusieron al gobierno.",
+          "english": "Because of those reforms, some big landowners opposed the government."
         },
         {
-          "spanish": "La cuestión agraria fue uno de sus motores centrales, precisamente a causa de que esta tensión llevaba ya décadas acumulándose sin resolverse.",
-          "english": "The agrarian question was one of its central drivers, precisely because this tension had already been building for decades without being resolved."
+          "spanish": "A raíz de estos conflictos, la discusión sobre la tierra era también una discusión sobre el poder.",
+          "english": "As a result of these conflicts, the discussion about land was also a discussion about power."
         }
       ]
     },
     {
       "type": "tip",
-      "content": "Debido a and a causa de (without que) work directly before a noun -- debido a la crisis -- while debido a que and a causa de que introduce a full clause with its own conjugated verb, as in every example above."
+      "content": "After *debido a* and *a raíz de* put a noun phrase (*debido a la concentración*), not a verb. To use a verb, say *debido a que* + verb. Start the sentence with the phrase and put a comma after the noun phrase."
     }
   ]
 }
