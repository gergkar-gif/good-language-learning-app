       ]
     },
+    {
+      "type": "examples",
+      "title": "In context",
+      "items": [
+        {
+          "spanish": "Los templos fueron construidos con madera de la región.",
+          "english": "The churches were built with wood from the region."
+        },
+        {
+          "spanish": "Las partituras fueron encontradas en los archivos de las misiones.",
